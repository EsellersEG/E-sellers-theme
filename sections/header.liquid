{%- comment -%}
  Header Section - E-sellers Professional (v4.9.0)
{%- endcomment -%}

{%- style -%}
  #shopify-section-{{ section.id }} {
    --header-bg: {{ section.settings.bg_color }};
    --header-text: {{ section.settings.text_color }};
    --header-hover: {{ section.settings.hover_color }};
    --header-border: {{ section.settings.border_color }};
    --cart-badge-bg: {{ section.settings.cart_badge_bg }};
    --cart-badge-text: {{ section.settings.cart_badge_text }};
    position: relative;
    z-index: 100;
  }

  .header-wrapper {
    background-color: var(--header-bg);
    color: var(--header-text);
    border-bottom: 1px solid var(--header-border);
    transition: transform 0.3s ease, box-shadow 0.3s ease;
  }

  .header-wrapper--sticky {
    position: sticky;
    top: 0;
    z-index: 100;
    box-shadow: 0 4px 20px rgba(0, 0, 0, 0.06);
  }

  .header {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding-top: {{ section.settings.padding_top }}px;
    padding-bottom: {{ section.settings.padding_bottom }}px;
    gap: 20px;
  }

  /* Logo */
  .header__logo {
    display: flex;
    align-items: center;
    text-decoration: none;
    color: inherit;
    font-size: 2.2rem;
    font-weight: 800;
    letter-spacing: -0.03em;
    flex-shrink: 0;
  }

  .header__logo-img {
    max-width: {{ section.settings.logo_width }}px;
    height: auto;
  }

  @media screen and (max-width: 749px) {
    .header__logo-img {
      max-width: {{ section.settings.logo_width_mobile }}px;
    }
  }

  /* Desktop Navigation */
  .header__nav {
    display: none;
  }

  @media screen and (min-width: 990px) {
    .header__nav {
      display: flex;
      align-items: center;
      gap: 32px;
      list-style: none;
    }
  }

  .header__nav-item {
    position: relative;
  }

  .header__nav-link {
    font-size: 1.5rem;
    font-weight: 600;
    color: var(--header-text);
    text-decoration: none;
    padding: 12px 0;
    display: inline-flex;
    align-items: center;
    gap: 4px;
    transition: color 0.2s;
  }

  .header__nav-link:hover {
    color: var(--header-hover);
  }

  /* Dropdown Menu */
  .header__dropdown {
    position: absolute;
    top: 100%;
    left: 0;
    min-width: 220px;
    background-color: var(--header-bg);
    border: 1px solid var(--header-border);
    box-shadow: 0 10px 30px rgba(0,0,0,0.1);
    border-radius: var(--card-radius, 12px);
    padding: 12px 0;
    list-style: none;
    opacity: 0;
    visibility: hidden;
    transform: translateY(10px);
    transition: all 0.25s cubic-bezier(0.16, 1, 0.3, 1);
    z-index: 110;
  }

  .header__nav-item:hover .header__dropdown {
    opacity: 1;
    visibility: visible;
    transform: translateY(0);
  }

  .header__dropdown-link {
    display: block;
    padding: 8px 20px;
    color: var(--header-text);
    text-decoration: none;
    font-size: 1.4rem;
    font-weight: 500;
    transition: background-color 0.2s, color 0.2s;
  }

  .header__dropdown-link:hover {
    background-color: rgba(0,0,0,0.04);
    color: var(--header-hover);
  }

  /* Mega Menu */
  .header__mega-menu {
    position: absolute;
    top: 100%;
    left: 0;
    width: 100%;
    background-color: var(--header-bg);
    border-bottom: 1px solid var(--header-border);
    box-shadow: 0 15px 35px rgba(0,0,0,0.1);
    padding: 32px 0;
    opacity: 0;
    visibility: hidden;
    transform: translateY(10px);
    transition: all 0.25s cubic-bezier(0.16, 1, 0.3, 1);
    z-index: 110;
  }

  .header__nav-item:hover .header__mega-menu {
    opacity: 1;
    visibility: visible;
    transform: translateY(0);
  }

  .header__mega-menu-inner {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(180px, 1fr)) 300px;
    gap: 32px;
  }

  .header__mega-column-title {
    font-size: 1.4rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.05em;
    margin-bottom: 12px;
    color: var(--header-text);
  }

  .header__mega-list {
    list-style: none;
    display: flex;
    flex-direction: column;
    gap: 8px;
  }

  .header__mega-card {
    border-radius: var(--card-radius, 12px);
    overflow: hidden;
    position: relative;
    background-color: rgba(0,0,0,0.03);
    padding: 16px;
    display: flex;
    flex-direction: column;
    justify-content: flex-end;
    min-height: 180px;
    text-decoration: none;
    color: #ffffff;
  }

  .header__mega-card-img {
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    z-index: 1;
    transition: transform 0.4s ease;
  }

  .header__mega-card:hover .header__mega-card-img {
    transform: scale(1.05);
  }

  .header__mega-card-content {
    position: relative;
    z-index: 2;
    background: linear-gradient(0deg, rgba(0,0,0,0.8) 0%, transparent 100%);
    margin: -16px;
    padding: 16px;
  }

  /* Actions (Search, Account, Cart) */
  .header__actions {
    display: flex;
    align-items: center;
    gap: 16px;
  }

  .header__action-btn {
    background: transparent;
    border: none;
    color: var(--header-text);
    cursor: pointer;
    display: flex;
    align-items: center;
    justify-content: center;
    padding: 8px;
    border-radius: 50%;
    position: relative;
    transition: color 0.2s, background-color 0.2s;
  }

  .header__action-btn:hover {
    color: var(--header-hover);
    background-color: rgba(0, 0, 0, 0.04);
  }

  .header__cart-badge {
    position: absolute;
    top: 2px;
    right: 2px;
    background-color: var(--cart-badge-bg);
    color: var(--cart-badge-text);
    font-size: 1.1rem;
    font-weight: 700;
    min-width: 18px;
    height: 18px;
    border-radius: 9px;
    display: flex;
    align-items: center;
    justify-content: center;
    padding: 0 4px;
    line-height: 1;
  }

  /* Mobile Hamburger */
  .header__mobile-toggle {
    display: flex;
    align-items: center;
    justify-content: center;
    background: transparent;
    border: none;
    color: var(--header-text);
    cursor: pointer;
    padding: 8px;
  }

  @media screen and (min-width: 990px) {
    .header__mobile-toggle {
      display: none;
    }
  }

  /* Mobile Drawer */
  .mobile-menu-drawer {
    position: fixed;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    background-color: rgba(0,0,0,0.5);
    backdrop-filter: blur(4px);
    z-index: 999;
    opacity: 0;
    visibility: hidden;
    transition: opacity 0.3s ease, visibility 0.3s ease;
  }

  .mobile-menu-drawer.is-open {
    opacity: 1;
    visibility: visible;
  }

  .mobile-menu-drawer__content {
    position: absolute;
    top: 0;
    left: 0;
    width: 85%;
    max-width: 360px;
    height: 100%;
    background-color: var(--header-bg);
    color: var(--header-text);
    padding: 24px;
    overflow-y: auto;
    transform: translateX(-100%);
    transition: transform 0.35s cubic-bezier(0.16, 1, 0.3, 1);
    display: flex;
    flex-direction: column;
  }

  .mobile-menu-drawer.is-open .mobile-menu-drawer__content {
    transform: translateX(0);
  }

  .mobile-menu-drawer__header {
    display: flex;
    align-items: center;
    justify-content: space-between;
    margin-bottom: 24px;
    padding-bottom: 16px;
    border-bottom: 1px solid var(--header-border);
  }

  .mobile-nav {
    list-style: none;
    display: flex;
    flex-direction: column;
    gap: 16px;
  }

  .mobile-nav__link {
    font-size: 1.8rem;
    font-weight: 600;
    color: var(--header-text);
    text-decoration: none;
    display: flex;
    justify-content: space-between;
    align-items: center;
  }
{%- endstyle -%}

<header-component class="header-wrapper{% if section.settings.enable_sticky %} header-wrapper--sticky{% endif %}">
  <div class="header page-width">
    <!-- Mobile Hamburger Toggle -->
    <button type="button" class="header__mobile-toggle" aria-label="{{ 'general.accessibility.menu' | t }}" id="MobileMenuOpen">
      {% render 'icon', name: 'menu' %}
    </button>

    <!-- Brand Logo -->
    <a href="{{ routes.root_url }}" class="header__logo">
      {%- if section.settings.logo != blank -%}
        <img
          src="{{ section.settings.logo | image_url: width: 400 }}"
          alt="{{ section.settings.logo.alt | default: shop.name | escape }}"
          class="header__logo-img"
          width="{{ section.settings.logo_width }}"
          height="auto"
          loading="eager"
        >
      {%- elsif settings.brand_logo != blank -%}
        <img
          src="{{ settings.brand_logo | image_url: width: 400 }}"
          alt="{{ shop.name | escape }}"
          class="header__logo-img"
          width="{{ section.settings.logo_width }}"
          height="auto"
          loading="eager"
        >
      {%- else -%}
        <span>{{ shop.name }}</span>
      {%- endif -%}
    </a>

    <!-- Desktop Navigation Menu -->
    <nav class="header__nav" aria-label="{{ 'sections.header.menu' | t }}">
      {%- for link in section.settings.menu.links -%}
        {%- liquid
          assign is_mega = false
          assign mega_block = null
          for block in section.blocks
            if block.type == 'mega_menu'
              assign trigger_clean = block.settings.menu_trigger | downcase | strip
              assign link_title_clean = link.title | downcase | strip
              if trigger_clean == link_title_clean
                assign is_mega = true
                assign mega_block = block
                break
              endif
            endif
          endfor
        -%}

        <li class="header__nav-item">
          <a href="{{ link.url }}" class="header__nav-link">
            <span>{{ link.title | escape }}</span>
            {%- if link.links != blank or is_mega -%}
              {% render 'icon', name: 'chevron-down' %}
            {%- endif -%}
          </a>

          {%- if is_mega -%}
            <!-- Mega Menu Dropdown -->
            <div class="header__mega-menu">
              <div class="page-width header__mega-menu-inner">
                {%- for childlink in link.links -%}
                  <div class="header__mega-column">
                    <a href="{{ childlink.url }}" class="header__mega-column-title">{{ childlink.title | escape }}</a>
                    {%- if childlink.links != blank -%}
                      <ul class="header__mega-list">
                        {%- for grandchildlink in childlink.links -%}
                          <li>
                            <a href="{{ grandchildlink.url }}" class="header__dropdown-link">{{ grandchildlink.title | escape }}</a>
                          </li>
                        {%- endfor -%}
                      </ul>
                    {%- endif -%}
                  </div>
                {%- endfor -%}

                {%- if mega_block.settings.promo_image != blank -%}
                  <a href="{{ mega_block.settings.promo_link | default: '#' }}" class="header__mega-card">
                    <img
                      src="{{ mega_block.settings.promo_image | image_url: width: 600 }}"
                      alt="{{ mega_block.settings.promo_heading | escape }}"
                      class="header__mega-card-img"
                      loading="lazy"
                      width="{{ mega_block.settings.promo_image.width }}"
                      height="{{ mega_block.settings.promo_image.height }}"
                    >
                    <div class="header__mega-card-content">
                      <h4 style="color: #fff; margin-bottom: 4px;">{{ mega_block.settings.promo_heading }}</h4>
                      <p style="color: rgba(255,255,255,0.85); font-size: 1.3rem; margin-bottom: 0;">{{ mega_block.settings.promo_subheading }}</p>
                    </div>
                  </a>
                {%- endif -%}
              </div>
            </div>

          {%- elsif link.links != blank -%}
            <!-- Standard Dropdown -->
            <ul class="header__dropdown">
              {%- for childlink in link.links -%}
                <li>
                  <a href="{{ childlink.url }}" class="header__dropdown-link">{{ childlink.title | escape }}</a>
                </li>
              {%- endfor -%}
            </ul>
          {%- endif -%}
        </li>
      {%- endfor -%}
    </nav>

    <!-- Header Actions (Search, Account, Cart) -->
    <div class="header__actions">
      <!-- Search Trigger -->
      <button
        type="button"
        class="header__action-btn"
        aria-label="{{ 'general.accessibility.search' | t }}"
        id="SearchModalOpener"
      >
        {% render 'icon', name: 'search' %}
      </button>

      <!-- Customer Account Link -->
      {%- if shop.customer_accounts_enabled -%}
        <a
          href="{% if customer %}{{ routes.account_url }}{% else %}{{ routes.account_login_url }}{% endif %}"
          class="header__action-btn"
          aria-label="{{ 'sections.header.account' | t }}"
        >
          {% render 'icon', name: 'account' %}
        </a>
      {%- endif -%}

      <!-- Cart Button / Drawer Trigger -->
      <a
        href="{{ routes.cart_url }}"
        class="header__action-btn"
        id="CartDrawerOpener"
        aria-label="{{ 'sections.header.cart_count' | t: count: cart.item_count }}"
      >
        {% render 'icon', name: 'cart' %}
        <span class="header__cart-badge" id="CartBadge" {% if cart.item_count == 0 %}style="display: none;"{% endif %}>
          {{ cart.item_count }}
        </span>
      </a>
    </div>
  </div>
</header-component>

<!-- Mobile Menu Drawer Container -->
<div class="mobile-menu-drawer" id="MobileMenuDrawer" aria-hidden="true">
  <div class="mobile-menu-drawer__content">
    <div class="mobile-menu-drawer__header">
      <span class="h4" style="margin: 0;">{{ 'general.accessibility.menu' | t }}</span>
      <button type="button" class="header__action-btn" id="MobileMenuClose" aria-label="{{ 'general.accessibility.close' | t }}">
        {% render 'icon', name: 'close' %}
      </button>
    </div>

    <ul class="mobile-nav">
      {%- for link in section.settings.menu.links -%}
        <li>
          <a href="{{ link.url }}" class="mobile-nav__link">
            {{ link.title | escape }}
          </a>
        </li>
      {%- endfor -%}
    </ul>
  </div>
</div>

<script>
  (function() {
    const openBtn = document.getElementById('MobileMenuOpen');
    const closeBtn = document.getElementById('MobileMenuClose');
    const drawer = document.getElementById('MobileMenuDrawer');

    if (openBtn && drawer) {
      openBtn.addEventListener('click', () => {
        drawer.classList.add('is-open');
        drawer.setAttribute('aria-hidden', 'false');
        document.body.classList.add('overflow-hidden');
      });
    }

    if (closeBtn && drawer) {
      closeBtn.addEventListener('click', () => {
        drawer.classList.remove('is-open');
        drawer.setAttribute('aria-hidden', 'true');
        document.body.classList.remove('overflow-hidden');
      });
    }

    // Subscribe to cart updates for badge counter
    if (window.subscribe && window.PUB_SUB_EVENTS) {
      window.subscribe(window.PUB_SUB_EVENTS.cartUpdate, (data) => {
        const badge = document.getElementById('CartBadge');
        if (!badge) return;
        window.ShopifyCart.get().then(cart => {
          badge.textContent = cart.item_count;
          badge.style.display = cart.item_count > 0 ? 'flex' : 'none';
        });
      });
    }
  })();
</script>

{% schema %}
{
  "name": "Header",
  "settings": [
    {
      "type": "header",
      "content": "Brand Logo"
    },
    {
      "type": "image_picker",
      "id": "logo",
      "label": "Custom logo image"
    },
    {
      "type": "range",
      "id": "logo_width",
      "min": 50,
      "max": 250,
      "step": 5,
      "unit": "px",
      "label": "Desktop logo width",
      "default": 140
    },
    {
      "type": "range",
      "id": "logo_width_mobile",
      "min": 40,
      "max": 160,
      "step": 5,
      "unit": "px",
      "label": "Mobile logo width",
      "default": 110
    },
    {
      "type": "header",
      "content": "Navigation"
    },
    {
      "type": "link_list",
      "id": "menu",
      "default": "main-menu",
      "label": "Primary menu"
    },
    {
      "type": "checkbox",
      "id": "enable_sticky",
      "default": true,
      "label": "Enable sticky header on scroll"
    },
    {
      "type": "header",
      "content": "Section Colors (Independent)"
    },
    {
      "type": "color",
      "id": "bg_color",
      "label": "Background color",
      "default": "#ffffff"
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "Text & icons color",
      "default": "#121212"
    },
    {
      "type": "color",
      "id": "hover_color",
      "label": "Links hover color",
      "default": "#005bd3"
    },
    {
      "type": "color",
      "id": "border_color",
      "label": "Bottom border color",
      "default": "#e2e8f0"
    },
    {
      "type": "color",
      "id": "cart_badge_bg",
      "label": "Cart badge background",
      "default": "#dc2626"
    },
    {
      "type": "color",
      "id": "cart_badge_text",
      "label": "Cart badge text color",
      "default": "#ffffff"
    },
    {
      "type": "header",
      "content": "Section Spacing"
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 10,
      "max": 40,
      "step": 2,
      "unit": "px",
      "label": "Top padding",
      "default": 16
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 10,
      "max": 40,
      "step": 2,
      "unit": "px",
      "label": "Bottom padding",
      "default": 16
    }
  ],
  "blocks": [
    {
      "type": "mega_menu",
      "name": "Mega Menu",
      "settings": [
        {
          "type": "text",
          "id": "menu_trigger",
          "label": "Menu item title trigger",
          "info": "Case-insensitive title of the menu item (e.g. 'Shop' or 'Catalog')"
        },
        {
          "type": "header",
          "content": "Promotion Card"
        },
        {
          "type": "image_picker",
          "id": "promo_image",
          "label": "Promotion image"
        },
        {
          "type": "text",
          "id": "promo_heading",
          "label": "Promo title",
          "default": "New Arrivals"
        },
        {
          "type": "text",
          "id": "promo_subheading",
          "label": "Promo subtitle",
          "default": "Explore the latest collection"
        },
        {
          "type": "url",
          "id": "promo_link",
          "label": "Promo link"
        }
      ]
    }
  ]
}
{% endschema %}
