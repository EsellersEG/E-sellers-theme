{%- comment -%}
  Header Section - E-sellers Professional (v4.9.0)
{%- endcomment -%}

{%- style -%}
  #shopify-section-{{ section.id }} {
    background-color: {{ section.settings.bg_color | default: '#ffffff' }};
    border-bottom: 1px solid {{ section.settings.border_color | default: '#e2e8f0' }};
    padding-top: {{ section.settings.padding_top | default: 20 }}px;
    padding-bottom: {{ section.settings.padding_bottom | default: 20 }}px;
    position: sticky;
    top: 0;
    z-index: 100;
    transition: box-shadow 0.2s ease;
  }

  .header {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 24px;
  }

  .header__logo {
    display: flex;
    align-items: center;
    text-decoration: none;
    color: {{ section.settings.text_color | default: '#121212' }};
    font-size: 1.5rem;
    font-weight: 700;
    letter-spacing: -0.02em;
  }

  .header__logo-img {
    max-width: {{ section.settings.logo_width | default: 120 }}px;
    height: auto;
    display: block;
  }

  .header__nav {
    display: flex;
    align-items: center;
  }

  .header__menu {
    display: flex;
    gap: 32px;
    list-style: none;
    margin: 0;
    padding: 0;
  }

  .header__menu-link {
    text-decoration: none;
    color: {{ section.settings.text_color | default: '#121212' }};
    font-size: 0.95rem;
    font-weight: 600;
    transition: color 0.2s ease, opacity 0.2s ease;
  }

  .header__menu-link:hover {
    opacity: 0.7;
  }

  .header__icons {
    display: flex;
    align-items: center;
    gap: 20px;
  }

  .header__icon {
    color: {{ section.settings.text_color | default: '#121212' }};
    text-decoration: none;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    position: relative;
    transition: opacity 0.2s ease;
  }

  .header__icon:hover {
    opacity: 0.7;
  }

  .header__icon svg {
    width: 22px;
    height: 22px;
  }

  .cart-count-bubble {
    position: absolute;
    top: -6px;
    right: -10px;
    min-width: 18px;
    height: 18px;
    padding: 0 4px;
    border-radius: 999px;
    background-color: #0f172a;
    color: #ffffff;
    font-size: 0.7rem;
    font-weight: 700;
    line-height: 18px;
    text-align: center;
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .header__menu-mobile-toggle {
    display: none;
    background: none;
    border: none;
    cursor: pointer;
    color: {{ section.settings.text_color | default: '#121212' }};
    padding: 4px;
  }

  @media screen and (max-width: 989px) {
    .header__menu {
      display: none;
    }

    .header__menu-mobile-toggle {
      display: inline-flex;
    }

    .header__logo {
      flex: 1;
      justify-content: center;
    }
  }
{%- endstyle -%}

<header class="page-width">
  <div class="header">
    <!-- Mobile Hamburger Toggle -->
    <button class="header__menu-mobile-toggle" aria-label="Open menu">
      <svg viewBox="0 0 24 24" width="24" height="24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
        <line x1="3" y1="12" x2="21" y2="12"></line>
        <line x1="3" y1="6" x2="21" y2="6"></line>
        <line x1="3" y1="18" x2="21" y2="18"></line>
      </svg>
    </button>

    <!-- Brand Logo -->
    <a href="{{ routes.root_url }}" class="header__logo">
      {%- if section.settings.logo != blank -%}
        <img
          src="{{ section.settings.logo | image_url: width: 600 }}"
          alt="{{ shop.name | escape }}"
          class="header__logo-img"
          loading="eager"
          width="{{ section.settings.logo_width | default: 120 }}"
          height="{{ section.settings.logo.height }}"
        >
      {%- else -%}
        {{ shop.name }}
      {%- endif -%}
    </a>

    <!-- Desktop Navigation Menu -->
    {%- if section.settings.menu != blank -%}
      <nav class="header__nav" aria-label="Primary Navigation">
        <ul class="header__menu" role="list">
          {%- for link in section.settings.menu.links -%}
            <li>
              <a href="{{ link.url }}" class="header__menu-link">
                {{ link.title | escape }}
              </a>
            </li>
          {%- endfor -%}
        </ul>
      </nav>
    {%- endif -%}

    <!-- Action Icons (Search, Account, Cart) -->
    <div class="header__icons">
      <a href="{{ routes.search_url }}" class="header__icon" aria-label="Search">
        <svg viewBox="0 0 24 24" width="22" height="22" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
          <circle cx="11" cy="11" r="8"></circle>
          <line x1="21" y1="21" x2="16.65" y2="16.65"></line>
        </svg>
      </a>

      {%- if shop.customer_accounts_enabled -%}
        <a href="{{ routes.account_url }}" class="header__icon" aria-label="Account">
          <svg viewBox="0 0 24 24" width="22" height="22" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <path d="M20 21v-2a4 4 0 0 0-4-4H8a4 4 0 0 0-4 4v2"></path>
            <circle cx="12" cy="7" r="4"></circle>
          </svg>
        </a>
      {%- endif -%}

      <a href="{{ routes.cart_url }}" class="header__icon" id="cart-icon-bubble" aria-label="Cart">
        {% render 'cart-icon-bubble' %}
      </a>
    </div>
  </div>
</header>

{% schema %}
{
  "name": "Header",
  "tag": "section",
  "class": "section--header",
  "settings": [
    {
      "type": "image_picker",
      "id": "logo",
      "label": "Logo image"
    },
    {
      "type": "range",
      "id": "logo_width",
      "min": 50,
      "max": 300,
      "step": 5,
      "unit": "px",
      "label": "Custom logo width",
      "default": 120
    },
    {
      "type": "link_list",
      "id": "menu",
      "default": "main-menu",
      "label": "Menu"
    },
    {
      "type": "header",
      "content": "Colors"
    },
    {
      "type": "color",
      "id": "bg_color",
      "label": "Background color",
      "default": "#ffffff"
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "Text and icon color",
      "default": "#121212"
    },
    {
      "type": "color",
      "id": "border_color",
      "label": "Bottom border color",
      "default": "#e2e8f0"
    },
    {
      "type": "header",
      "content": "Spacing"
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 0,
      "max": 40,
      "step": 2,
      "unit": "px",
      "label": "Top padding",
      "default": 20
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 0,
      "max": 40,
      "step": 2,
      "unit": "px",
      "label": "Bottom padding",
      "default": 20
    }
  ]
}
{% endschema %}
