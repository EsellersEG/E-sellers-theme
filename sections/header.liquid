{%- comment -%}
  Header Section - E-sellers Professional (v4.9.0)
{%- endcomment -%}

{%- style -%}
  #shopify-section-{{ section.id }} {
    background-color: {{ section.settings.bg_color }};
    border-bottom: 1px solid {{ section.settings.border_color }};
    padding-top: {{ section.settings.padding_top }}px;
    padding-bottom: {{ section.settings.padding_bottom }}px;
    position: sticky;
    top: 0;
    z-index: 100;
  }

  .header {
    display: flex;
    align-items: center;
    justify-content: space-between;
  }

  .header__logo {
    display: flex;
    align-items: center;
    text-decoration: none;
    color: {{ section.settings.text_color }};
    font-size: 1.5rem;
    font-weight: 700;
  }

  .header__logo-img {
    max-width: {{ section.settings.logo_width }}px;
    height: auto;
  }

  .header__menu {
    display: flex;
    gap: 32px;
    list-style: none;
    margin: 0;
    padding: 0;
  }

  .header__menu-link {
    text-decoration: none;
    color: {{ section.settings.text_color }};
    font-size: 1rem;
    font-weight: 500;
    transition: opacity 0.2s ease;
  }

  .header__menu-link:hover {
    opacity: 0.7;
  }

  .header__icons {
    display: flex;
    align-items: center;
    gap: 20px;
  }

  .header__icon {
    color: {{ section.settings.text_color }};
    text-decoration: none;
    display: flex;
    align-items: center;
    justify-content: center;
    transition: opacity 0.2s ease;
  }

  .header__icon:hover {
    opacity: 0.7;
  }

  .header__icon svg {
    width: 24px;
    height: 24px;
    fill: currentColor;
  }

  .header__menu-mobile-toggle {
    display: none;
    background: none;
    border: none;
    cursor: pointer;
    color: {{ section.settings.text_color }};
  }

  @media screen and (max-width: 989px) {
    .header__menu {
      display: none; /* Hide desktop menu on mobile */
    }

    .header__menu-mobile-toggle {
      display: block; /* Show hamburger on mobile */
    }
    
    .header__logo {
      flex: 1;
      justify-content: center;
    }
  }
{%- endstyle -%}

<header class="page-width">
  <div class="header">
    
    <!-- Mobile Hamburger Menu -->
    <button class="header__menu-mobile-toggle" aria-label="Open menu">
      <svg viewBox="0 0 24 24" width="24" height="24">
        <path d="M3 18h18v-2H3v2zm0-5h18v-2H3v2zm0-7v2h18V6H3z" fill="currentColor"/>
      </svg>
    </button>

    <!-- Logo -->
    <a href="{{ routes.root_url }}" class="header__logo">
      {%- if section.settings.logo != blank -%}
        <img
          src="{{ section.settings.logo | image_url: width: 600 }}"
          alt="{{ shop.name | escape }}"
          class="header__logo-img"
          loading="eager"
          width="{{ section.settings.logo_width }}"
          height="{{ section.settings.logo.height }}"
        >
      {%- else -%}
        {{ shop.name }}
      {%- endif -%}
    </a>

    <!-- Desktop Navigation -->
    {%- if section.settings.menu != blank -%}
      <nav class="header__nav">
        <ul class="header__menu">
          {%- for link in section.settings.menu.links -%}
            <li>
              <a href="{{ link.url }}" class="header__menu-link">
                {{ link.title }}
              </a>
            </li>
          {%- endfor -%}
        </ul>
      </nav>
    {%- endif -%}

    <!-- Icons (Search, Account, Cart) -->
    <div class="header__icons">
      <a href="{{ routes.search_url }}" class="header__icon" aria-label="Search">
        <svg viewBox="0 0 24 24" width="24" height="24">
          <path d="M15.5 14h-.79l-.28-.27C15.41 12.59 16 11.11 16 9.5 16 5.91 13.09 3 9.5 3S3 5.91 3 9.5 5.91 16 9.5 16c1.61 0 3.09-.59 4.23-1.57l.27.28v.79l5 4.99L20.49 19l-4.99-5zm-6 0C7.01 14 5 11.99 5 9.5S7.01 5 9.5 5 14 7.01 14 9.5 11.99 14 9.5 14z" fill="currentColor"/>
        </svg>
      </a>

      {%- if shop.customer_accounts_enabled -%}
        <a href="{{ routes.account_url }}" class="header__icon" aria-label="Account">
          <svg viewBox="0 0 24 24" width="24" height="24">
            <path d="M12 12c2.21 0 4-1.79 4-4s-1.79-4-4-4-4 1.79-4 4 1.79 4 4 4zm0 2c-2.67 0-8 1.34-8 4v2h16v-2c0-2.66-5.33-4-8-4z" fill="currentColor"/>
          </svg>
        </a>
      {%- endif -%}

      <a href="{{ routes.cart_url }}" class="header__icon" id="cart-icon-bubble" aria-label="Cart">
        <svg viewBox="0 0 24 24" width="24" height="24">
          <path d="M7 18c-1.1 0-1.99.9-1.99 2S5.9 22 7 22s2-.9 2-2-.9-2-2-2zM1 2v2h2l3.6 7.59-1.35 2.45c-.16.28-.25.61-.25.96 0 1.1.9 2 2 2h12v-2H7.42c-.14 0-.25-.11-.25-.25l.03-.12.9-1.63h7.45c.75 0 1.41-.41 1.75-1.03l3.58-6.49c.08-.14.12-.31.12-.48 0-.55-.45-1-1-1H5.21l-.94-2H1zm16 16c-1.1 0-1.99.9-1.99 2s.89 2 1.99 2 2-.9 2-2-.9-2-2-2z" fill="currentColor"/>
        </svg>
      </a>
    </div>

  </div>
</header>

{% schema %}
{
  "name": "Header",
  "tag": "section",
  "class": "section--header",
  "settings": [
    {
      "type": "image_picker",
      "id": "logo",
      "label": "Logo image"
    },
    {
      "type": "range",
      "id": "logo_width",
      "min": 50,
      "max": 300,
      "step": 5,
      "unit": "px",
      "label": "Custom logo width",
      "default": 120
    },
    {
      "type": "link_list",
      "id": "menu",
      "default": "main-menu",
      "label": "Menu"
    },
    {
      "type": "header",
      "content": "Colors"
    },
    {
      "type": "color",
      "id": "bg_color",
      "label": "Background color",
      "default": "#ffffff"
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "Text and icon color",
      "default": "#121212"
    },
    {
      "type": "color",
      "id": "border_color",
      "label": "Bottom border color",
      "default": "#e2e8f0"
    },
    {
      "type": "header",
      "content": "Spacing"
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 0,
      "max": 40,
      "step": 2,
      "unit": "px",
      "label": "Top padding",
      "default": 20
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 0,
      "max": 40,
      "step": 2,
      "unit": "px",
      "label": "Bottom padding",
      "default": 20
    }
  ]
}
{% endschema %}
