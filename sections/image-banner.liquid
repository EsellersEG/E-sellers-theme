{%- comment -%}
  Image Banner / Hero Section - E-sellers Professional (v4.9.0)
{%- endcomment -%}

{%- style -%}
  #shopify-section-{{ section.id }} {
    --banner-color-text: {{ section.settings.text_color }};
    --banner-color-heading: {{ section.settings.heading_color }};
    --banner-overlay-bg: {{ section.settings.overlay_color }};
    --banner-overlay-opacity: {{ section.settings.overlay_opacity | divided_by: 100.0 }};
    --banner-btn1-bg: {{ section.settings.btn1_bg }};
    --banner-btn1-text: {{ section.settings.btn1_text }};
    --banner-btn2-bg: {{ section.settings.btn2_bg }};
    --banner-btn2-text: {{ section.settings.btn2_text }};
  }

  .image-banner {
    position: relative;
    overflow: hidden;
    display: flex;
    align-items: {{ section.settings.desktop_content_position }};
    justify-content: {{ section.settings.desktop_content_alignment }};
    min-height: {{ section.settings.banner_height_desktop }}px;
  }

  @media screen and (max-width: 749px) {
    .image-banner {
      min-height: {{ section.settings.banner_height_mobile }}px;
      align-items: {{ section.settings.mobile_content_position }};
      justify-content: {{ section.settings.mobile_content_alignment }};
    }
  }

  .image-banner__media {
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    z-index: 1;
  }

  .image-banner__img {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .image-banner__img--mobile {
    display: none;
  }

  @media screen and (max-width: 749px) {
    .image-banner__img--desktop {
      display: {% if section.settings.image_mobile != blank %}none{% else %}block{% endif %};
    }
    .image-banner__img--mobile {
      display: block;
    }
  }

  .image-banner__overlay {
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    background-color: var(--banner-overlay-bg);
    opacity: var(--banner-overlay-opacity);
    z-index: 2;
  }

  .image-banner__content {
    position: relative;
    z-index: 3;
    max-width: {{ section.settings.content_max_width }}px;
    padding: 40px 24px;
    color: var(--banner-color-text);
    text-align: {{ section.settings.text_align }};
    display: flex;
    flex-direction: column;
    gap: 16px;
  }

  .image-banner__heading {
    color: var(--banner-color-heading);
    margin: 0;
    font-size: calc(3.6rem * var(--font-heading-scale, 1));
    line-height: 1.15;
  }

  @media screen and (min-width: 750px) {
    .image-banner__heading {
      font-size: calc(5.6rem * var(--font-heading-scale, 1));
    }
  }

  .image-banner__buttons {
    display: flex;
    flex-wrap: wrap;
    gap: 12px;
    justify-content: {% if section.settings.text_align == 'center' %}center{% elsif section.settings.text_align == 'right' %}flex-end{% else %}flex-start{% endif %};
    margin-top: 8px;
  }
{%- endstyle -%}

<div class="image-banner">
  <!-- Background Images -->
  <div class="image-banner__media">
    {%- if section.settings.image != blank -%}
      <img
        src="{{ section.settings.image | image_url: width: 2000 }}"
        srcset="
          {{ section.settings.image | image_url: width: 750 }} 750w,
          {{ section.settings.image | image_url: width: 1400 }} 1400w,
          {{ section.settings.image | image_url: width: 2000 }} 2000w
        "
        sizes="100vw"
        alt="{{ section.settings.image.alt | default: shop.name | escape }}"
        class="image-banner__img image-banner__img--desktop"
        loading="eager"
        fetchpriority="high"
        width="{{ section.settings.image.width }}"
        height="{{ section.settings.image.height }}"
      >
      {%- if section.settings.image_mobile != blank -%}
        <img
          src="{{ section.settings.image_mobile | image_url: width: 800 }}"
          sizes="100vw"
          alt="{{ section.settings.image_mobile.alt | default: shop.name | escape }}"
          class="image-banner__img image-banner__img--mobile"
          loading="eager"
          width="{{ section.settings.image_mobile.width }}"
          height="{{ section.settings.image_mobile.height }}"
        >
      {%- endif -%}
    {%- else -%}
      {{ 'lifestyle-1' | placeholder_svg_tag: 'placeholder-svg' }}
    {%- endif -%}
  </div>

  <!-- Overlay -->
  <div class="image-banner__overlay"></div>

  <!-- Content Container -->
  <div class="page-width flex" style="width: 100%; justify-content: {{ section.settings.desktop_content_alignment }};">
    <div class="image-banner__content">
      {%- for block in section.blocks -%}
        {%- case block.type -%}
          {%- when 'subheading' -%}
            <p style="font-size: 1.4rem; font-weight: 700; text-transform: uppercase; letter-spacing: 0.1em; margin: 0;" {{ block.shopify_attributes }}>
              {{ block.settings.text | escape }}
            </p>

          {%- when 'heading' -%}
            <h2 class="image-banner__heading" {{ block.shopify_attributes }}>
              {{ block.settings.text }}
            </h2>

          {%- when 'text' -%}
            <div style="font-size: 1.6rem; line-height: 1.6; opacity: 0.95;" {{ block.shopify_attributes }}>
              {{ block.settings.text }}
            </div>

          {%- when 'buttons' -%}
            <div class="image-banner__buttons" {{ block.shopify_attributes }}>
              {%- if block.settings.button_1_label != blank -%}
                <a
                  href="{{ block.settings.button_1_link | default: '#' }}"
                  class="button"
                  style="background-color: var(--banner-btn1-bg); color: var(--banner-btn1-text); padding: 16px 32px; font-size: 1.6rem;"
                >
                  {{ block.settings.button_1_label | escape }}
                </a>
              {%- endif -%}
              {%- if block.settings.button_2_label != blank -%}
                <a
                  href="{{ block.settings.button_2_link | default: '#' }}"
                  class="button"
                  style="background-color: var(--banner-btn2-bg); color: var(--banner-btn2-text); padding: 16px 32px; font-size: 1.6rem; border: 1.5px solid var(--banner-btn2-text);"
                >
                  {{ block.settings.button_2_label | escape }}
                </a>
              {%- endif -%}
            </div>
        {%- endcase -%}
      {%- endfor -%}
    </div>
  </div>
</div>

{% schema %}
{
  "name": "Image Banner (Hero)",
  "settings": [
    {
      "type": "header",
      "content": "Banner Images"
    },
    {
      "type": "image_picker",
      "id": "image",
      "label": "Desktop image"
    },
    {
      "type": "image_picker",
      "id": "image_mobile",
      "label": "Mobile image (optional)"
    },
    {
      "type": "range",
      "id": "banner_height_desktop",
      "min": 400,
      "max": 900,
      "step": 20,
      "unit": "px",
      "label": "Desktop height",
      "default": 650
    },
    {
      "type": "range",
      "id": "banner_height_mobile",
      "min": 300,
      "max": 700,
      "step": 20,
      "unit": "px",
      "label": "Mobile height",
      "default": 450
    },
    {
      "type": "header",
      "content": "Layout & Alignment"
    },
    {
      "type": "select",
      "id": "desktop_content_position",
      "options": [
        { "value": "flex-start", "label": "Top" },
        { "value": "center", "label": "Middle" },
        { "value": "flex-end", "label": "Bottom" }
      ],
      "default": "center",
      "label": "Desktop vertical position"
    },
    {
      "type": "select",
      "id": "desktop_content_alignment",
      "options": [
        { "value": "flex-start", "label": "Left" },
        { "value": "center", "label": "Center" },
        { "value": "flex-end", "label": "Right" }
      ],
      "default": "center",
      "label": "Desktop horizontal alignment"
    },
    {
      "type": "select",
      "id": "text_align",
      "options": [
        { "value": "left", "label": "Left" },
        { "value": "center", "label": "Center" },
        { "value": "right", "label": "Right" }
      ],
      "default": "center",
      "label": "Text alignment"
    },
    {
      "type": "range",
      "id": "content_max_width",
      "min": 400,
      "max": 1000,
      "step": 20,
      "unit": "px",
      "label": "Content max width",
      "default": 680
    },
    {
      "type": "header",
      "content": "Section Colors (Independent)"
    },
    {
      "type": "color",
      "id": "heading_color",
      "label": "Heading color",
      "default": "#ffffff"
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "Text color",
      "default": "#ffffff"
    },
    {
      "type": "color",
      "id": "overlay_color",
      "label": "Overlay color",
      "default": "#000000"
    },
    {
      "type": "range",
      "id": "overlay_opacity",
      "min": 0,
      "max": 90,
      "step": 5,
      "unit": "%",
      "label": "Overlay opacity",
      "default": 35
    },
    {
      "type": "color",
      "id": "btn1_bg",
      "label": "Primary button background",
      "default": "#ffffff"
    },
    {
      "type": "color",
      "id": "btn1_text",
      "label": "Primary button text",
      "default": "#121212"
    },
    {
      "type": "color",
      "id": "btn2_bg",
      "label": "Secondary button background",
      "default": "transparent"
    },
    {
      "type": "color",
      "id": "btn2_text",
      "label": "Secondary button text",
      "default": "#ffffff"
    }
  ],
  "blocks": [
    {
      "type": "subheading",
      "name": "Subheading",
      "settings": [
        {
          "type": "text",
          "id": "text",
          "label": "Subheading",
          "default": "New Season Arrival"
        }
      ]
    },
    {
      "type": "heading",
      "name": "Heading",
      "settings": [
        {
          "type": "text",
          "id": "text",
          "label": "Heading",
          "default": "Elevate Your Everyday Style"
        }
      ]
    },
    {
      "type": "text",
      "name": "Text",
      "settings": [
        {
          "type": "richtext",
          "id": "text",
          "label": "Body text",
          "default": "<p>Discover the latest collection engineered with premium materials, uncompromising craftsmanship, and modern silhouettes.</p>"
        }
      ]
    },
    {
      "type": "buttons",
      "name": "Buttons",
      "settings": [
        {
          "type": "text",
          "id": "button_1_label",
          "label": "Primary button label",
          "default": "Shop New Arrivals"
        },
        {
          "type": "url",
          "id": "button_1_link",
          "label": "Primary button link"
        },
        {
          "type": "text",
          "id": "button_2_label",
          "label": "Secondary button label",
          "default": "Explore Catalog"
        },
        {
          "type": "url",
          "id": "button_2_link",
          "label": "Secondary button link"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Image Banner (Hero)",
      "blocks": [
        { "type": "subheading" },
        { "type": "heading" },
        { "type": "text" },
        { "type": "buttons" }
      ]
    }
  ]
}
{% endschema %}
