{%- comment -%}
  Before/After Image Comparison Slider - E-sellers Professional (v4.9.0)
{%- endcomment -%}

{%- style -%}
  #shopify-section-{{ section.id }} {
    background-color: {{ section.settings.bg_color }};
    color: {{ section.settings.text_color }};
    --section-heading-color: {{ section.settings.heading_color }};
    --handle-color: {{ section.settings.handle_color }};
    padding-top: {{ section.settings.padding_top }}px;
    padding-bottom: {{ section.settings.padding_bottom }}px;
  }

  .before-after__header {
    text-align: center;
    max-width: 650px;
    margin: 0 auto 40px auto;
  }

  .before-after__container {
    position: relative;
    width: 100%;
    max-width: {{ section.settings.max_width }}px;
    margin: 0 auto;
    border-radius: var(--card-radius, 16px);
    overflow: hidden;
    aspect-ratio: {{ section.settings.aspect_ratio }};
    user-select: none;
    box-shadow: 0 15px 40px rgba(0,0,0,0.08);
  }

  .before-after__image-before,
  .before-after__image-after {
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .before-after__overlay {
    position: absolute;
    top: 0;
    left: 0;
    width: 50%;
    height: 100%;
    overflow: hidden;
    z-index: 2;
    border-right: 2px solid var(--handle-color);
    transition: none;
  }

  .before-after__overlay .before-after__image-before {
    width: 100%;
    max-width: none;
  }

  /* Labels */
  .before-after__badge {
    position: absolute;
    top: 20px;
    padding: 6px 14px;
    background-color: rgba(0, 0, 0, 0.7);
    color: #ffffff;
    font-size: 1.2rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.05em;
    border-radius: var(--badge-radius, 6px);
    z-index: 3;
    pointer-events: none;
  }

  .before-after__badge--before { left: 20px; }
  .before-after__badge--after { right: 20px; }

  /* Draggable Handle */
  .before-after__handle {
    position: absolute;
    top: 50%;
    left: 50%;
    transform: translate(-50%, -50%);
    width: 44px;
    height: 44px;
    background-color: var(--handle-color);
    color: #121212;
    border-radius: 50%;
    display: flex;
    align-items: center;
    justify-content: center;
    z-index: 4;
    box-shadow: 0 4px 15px rgba(0,0,0,0.3);
    cursor: ew-resize;
    pointer-events: none;
  }

  /* Range input overlay */
  .before-after__slider {
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    opacity: 0;
    cursor: ew-resize;
    z-index: 5;
    margin: 0;
  }
{%- endstyle -%}

<div class="page-width">
  {%- if section.settings.heading != blank or section.settings.subheading != blank -%}
    <div class="before-after__header">
      {%- if section.settings.subheading != blank -%}
        <p style="font-size: 1.3rem; font-weight: 700; text-transform: uppercase; letter-spacing: 0.1em; color: #71717a; margin-bottom: 8px;">
          {{ section.settings.subheading | escape }}
        </p>
      {%- endif -%}
      {%- if section.settings.heading != blank -%}
        <h2 class="h2" style="margin: 0;">{{ section.settings.heading | escape }}</h2>
      {%- endif -%}
    </div>
  {%- endif -%}

  <div class="before-after__container" id="BeforeAfter-{{ section.id }}">
    <!-- After Image (Background) -->
    {%- if section.settings.image_after != blank -%}
      <img
        src="{{ section.settings.image_after | image_url: width: 1400 }}"
        alt="After"
        class="before-after__image-after"
        loading="lazy"
        width="{{ section.settings.image_after.width }}"
        height="{{ section.settings.image_after.height }}"
      >
    {%- else -%}
      {{ 'lifestyle-1' | placeholder_svg_tag: 'before-after__image-after' }}
    {%- endif -%}
    <span class="before-after__badge before-after__badge--after">{{ section.settings.label_after | default: 'After' }}</span>

    <!-- Before Image (Clipped Overlay) -->
    <div class="before-after__overlay" id="BeforeOverlay-{{ section.id }}">
      {%- if section.settings.image_before != blank -%}
        <img
          src="{{ section.settings.image_before | image_url: width: 1400 }}"
          alt="Before"
          class="before-after__image-before"
          loading="lazy"
          style="width: {{ section.settings.max_width }}px;"
          width="{{ section.settings.image_before.width }}"
          height="{{ section.settings.image_before.height }}"
        >
      {%- else -%}
        {{ 'lifestyle-2' | placeholder_svg_tag: 'before-after__image-before' }}
      {%- endif -%}
      <span class="before-after__badge before-after__badge--before">{{ section.settings.label_before | default: 'Before' }}</span>
    </div>

    <!-- Handle & Interactive Slider -->
    <div class="before-after__handle" id="BeforeHandle-{{ section.id }}">
      <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
        <polyline points="15 18 9 12 15 6"></polyline>
        <polyline points="9 18 15 12 9 6" transform="translate(6, 0)"></polyline>
      </svg>
    </div>

    <input
      type="range"
      min="0"
      max="100"
      value="50"
      class="before-after__slider"
      id="BeforeSlider-{{ section.id }}"
      aria-label="Image comparison slider"
    >
  </div>
</div>

<script>
  (function() {
    const slider = document.getElementById('BeforeSlider-{{ section.id }}');
    const overlay = document.getElementById('BeforeOverlay-{{ section.id }}');
    const handle = document.getElementById('BeforeHandle-{{ section.id }}');

    if (slider && overlay && handle) {
      slider.addEventListener('input', (e) => {
        const val = e.target.value;
        overlay.style.width = `${val}%`;
        handle.style.left = `${val}%`;
      });
    }
  })();
</script>

{% schema %}
{
  "name": "Before / After Slider",
  "settings": [
    {
      "type": "text",
      "id": "subheading",
      "label": "Subheading",
      "default": "Real Results"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "See The Transformation"
    },
    {
      "type": "header",
      "content": "Before Image"
    },
    {
      "type": "image_picker",
      "id": "image_before",
      "label": "Before image"
    },
    {
      "type": "text",
      "id": "label_before",
      "label": "Before label",
      "default": "Before"
    },
    {
      "type": "header",
      "content": "After Image"
    },
    {
      "type": "image_picker",
      "id": "image_after",
      "label": "After image"
    },
    {
      "type": "text",
      "id": "label_after",
      "label": "After label",
      "default": "After"
    },
    {
      "type": "header",
      "content": "Layout & Sizing"
    },
    {
      "type": "select",
      "id": "aspect_ratio",
      "options": [
        { "value": "16 / 9", "label": "Widescreen (16:9)" },
        { "value": "4 / 3", "label": "Landscape (4:3)" },
        { "value": "1 / 1", "label": "Square (1:1)" },
        { "value": "3 / 4", "label": "Portrait (3:4)" }
      ],
      "default": "16 / 9",
      "label": "Aspect ratio"
    },
    {
      "type": "range",
      "id": "max_width",
      "min": 600,
      "max": 1200,
      "step": 50,
      "unit": "px",
      "label": "Maximum container width",
      "default": 1000
    },
    {
      "type": "header",
      "content": "Section Colors (Independent)"
    },
    {
      "type": "color",
      "id": "bg_color",
      "label": "Background color",
      "default": "#ffffff"
    },
    {
      "type": "color",
      "id": "heading_color",
      "label": "Heading color",
      "default": "#121212"
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "Text color",
      "default": "#121212"
    },
    {
      "type": "color",
      "id": "handle_color",
      "label": "Handle / Divider color",
      "default": "#ffffff"
    },
    {
      "type": "header",
      "content": "Section Spacing"
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 20,
      "max": 100,
      "step": 5,
      "unit": "px",
      "label": "Top padding",
      "default": 60
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 20,
      "max": 100,
      "step": 5,
      "unit": "px",
      "label": "Bottom padding",
      "default": 60
    }
  ],
  "presets": [
    {
      "name": "Before / After Slider"
    }
  ]
}
{% endschema %}
