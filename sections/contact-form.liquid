{%- comment -%}
  Contact Form Section - E-sellers Professional (v4.9.0)
{%- endcomment -%}

{%- style -%}
  #shopify-section-{{ section.id }} {
    background-color: {{ section.settings.bg_color }};
    color: {{ section.settings.text_color }};
    --section-heading-color: {{ section.settings.heading_color }};
    --section-btn-bg: {{ section.settings.btn_bg_color }};
    --section-btn-text: {{ section.settings.btn_text_color }};
    padding-top: {{ section.settings.padding_top }}px;
    padding-bottom: {{ section.settings.padding_bottom }}px;
  }

  .contact-section {
    max-width: 800px;
    margin: 0 auto;
  }

  .contact-section__header {
    text-align: center;
    margin-bottom: 40px;
  }

  .contact-form__fields {
    display: grid;
    grid-template-columns: 1fr;
    gap: 16px;
  }

  @media screen and (min-width: 750px) {
    .contact-form__fields--row {
      grid-template-columns: repeat(2, 1fr);
    }
  }
{%- endstyle -%}

<div class="page-width">
  <div class="contact-section">
    <div class="contact-section__header">
      {%- if section.settings.heading != blank -%}
        <h1 class="h2" style="margin-bottom: 8px;">{{ section.settings.heading | escape }}</h1>
      {%- endif -%}
      {%- if section.settings.text != blank -%}
        <div style="font-size: 1.5rem; color: #71717a; line-height: 1.6;">
          {{ section.settings.text }}
        </div>
      {%- endif -%}
    </div>

    {%- form 'contact', id: 'ContactForm', class: 'contact-form' -%}
      {%- if form.posted_successfully? -%}
        <div style="padding: 16px; background-color: #f0fdf4; color: #16a34a; border-radius: 8px; font-weight: 600; margin-bottom: 24px; text-align: center;">
          {{ 'sections.contact.form.post_success' | t }}
        </div>
      {%- elsif form.errors -%}
        <div style="padding: 16px; background-color: #fef2f2; color: #dc2626; border-radius: 8px; font-weight: 600; margin-bottom: 24px;">
          {{ form.errors | default_errors }}
        </div>
      {%- endif -%}

      <div class="contact-form__fields contact-form__fields--row" style="margin-bottom: 16px;">
        <div class="field">
          <input
            type="text"
            id="ContactForm-name"
            class="field__input"
            name="contact[{{ 'sections.contact.form.name' | t }}]"
            value="{% if form.name %}{{ form.name }}{% elsif customer %}{{ customer.name }}{% endif %}"
            placeholder="{{ 'sections.contact.form.name' | t }}"
            required
          >
        </div>
        <div class="field">
          <input
            type="email"
            id="ContactForm-email"
            class="field__input"
            name="contact[email]"
            spellcheck="false"
            autocapitalize="off"
            value="{% if form.email %}{{ form.email }}{% elsif customer %}{{ customer.email }}{% endif %}"
            placeholder="{{ 'sections.contact.form.email' | t }}"
            required
          >
        </div>
      </div>

      <div class="field" style="margin-bottom: 16px;">
        <input
          type="tel"
          id="ContactForm-phone"
          class="field__input"
          name="contact[{{ 'sections.contact.form.phone' | t }}]"
          pattern="[0-9\-]*"
          value="{% if form.phone %}{{ form.phone }}{% elsif customer %}{{ customer.phone }}{% endif %}"
          placeholder="{{ 'sections.contact.form.phone' | t }}"
        >
      </div>

      <div class="field" style="margin-bottom: 24px;">
        <textarea
          rows="6"
          id="ContactForm-body"
          class="field__input"
          name="contact[{{ 'sections.contact.form.comment' | t }}]"
          placeholder="{{ 'sections.contact.form.comment' | t }}"
          required
        >{{ form.body }}</textarea>
      </div>

      <div style="text-align: center;">
        <button type="submit" class="button button--primary" style="padding: 16px 40px; font-size: 1.6rem;">
          {{ 'sections.contact.form.send' | t }}
        </button>
      </div>
    {%- endform -%}
  </div>
</div>

{% schema %}
{
  "name": "Contact Form",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Get in Touch"
    },
    {
      "type": "richtext",
      "id": "text",
      "label": "Text",
      "default": "<p>Have questions about your order or our products? Send us a message and our support team will respond within 24 hours.</p>"
    },
    {
      "type": "header",
      "content": "Section Colors (Independent)"
    },
    {
      "type": "color",
      "id": "bg_color",
      "label": "Background color",
      "default": "#ffffff"
    },
    {
      "type": "color",
      "id": "heading_color",
      "label": "Heading color",
      "default": "#121212"
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "Text color",
      "default": "#121212"
    },
    {
      "type": "color",
      "id": "btn_bg_color",
      "label": "Button background",
      "default": "#121212"
    },
    {
      "type": "color",
      "id": "btn_text_color",
      "label": "Button text color",
      "default": "#ffffff"
    },
    {
      "type": "header",
      "content": "Section Spacing"
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 20,
      "max": 100,
      "step": 5,
      "unit": "px",
      "label": "Top padding",
      "default": 60
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 20,
      "max": 100,
      "step": 5,
      "unit": "px",
      "label": "Bottom padding",
      "default": 60
    }
  ],
  "presets": [
    {
      "name": "Contact Form"
    }
  ]
}
{% endschema %}
