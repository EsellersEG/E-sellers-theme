{%- comment -%}
  Contact Form Section - E-sellers Professional (v4.9.0)
{%- endcomment -%}

{%- style -%}
  #shopify-section-{{ section.id }} {
    background-color: {{ section.settings.bg_color | default: '#ffffff' }};
    padding-top: {{ section.settings.padding_top | default: 60 }}px;
    padding-bottom: {{ section.settings.padding_bottom | default: 80 }}px;
  }

  .contact-form-wrap {
    max-width: 680px;
    margin: 0 auto;
    padding: 0 20px;
  }

  .contact-form__header {
    text-align: center;
    margin-bottom: 36px;
  }

  .contact-form__title {
    font-size: 2.25rem;
    font-weight: 700;
    color: {{ section.settings.heading_color | default: '#121212' }};
    margin: 0 0 12px;
  }

  .contact-form__text {
    color: {{ section.settings.text_color | default: '#64748b' }};
    font-size: 1.05rem;
    line-height: 1.6;
    margin: 0;
  }

  .contact-form__form {
    display: flex;
    flex-direction: column;
    gap: 20px;
  }

  .contact-form__field-group {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 16px;
  }

  @media screen and (max-width: 640px) {
    .contact-form__field-group {
      grid-template-columns: 1fr;
    }
  }

  .contact-form__label {
    display: block;
    font-size: 0.9rem;
    font-weight: 600;
    margin-bottom: 6px;
    color: {{ section.settings.text_color | default: '#121212' }};
  }

  .contact-form__input {
    width: 100%;
    padding: 12px 16px;
    border: 1px solid #cbd5e1;
    border-radius: 8px;
    font-size: 1rem;
    outline: none;
    box-sizing: border-box;
  }

  .contact-form__input:focus {
    border-color: #121212;
  }

  .contact-form__textarea {
    width: 100%;
    padding: 12px 16px;
    border: 1px solid #cbd5e1;
    border-radius: 8px;
    font-size: 1rem;
    min-height: 140px;
    resize: vertical;
    outline: none;
    box-sizing: border-box;
  }

  .contact-form__textarea:focus {
    border-color: #121212;
  }

  .contact-form__submit {
    background-color: {{ section.settings.btn_bg_color | default: '#121212' }};
    color: {{ section.settings.btn_text_color | default: '#ffffff' }};
    padding: 14px 28px;
    border: none;
    border-radius: 8px;
    font-size: 1rem;
    font-weight: 600;
    cursor: pointer;
    align-self: flex-start;
    transition: opacity 0.2s ease;
  }

  .contact-form__submit:hover {
    opacity: 0.85;
  }
{%- endstyle -%}

<div class="contact-form-wrap page-width">
  <div class="contact-form__header">
    {%- if section.settings.heading != blank -%}
      <h1 class="contact-form__title">{{ section.settings.heading | escape }}</h1>
    {%- endif -%}
    {%- if section.settings.text != blank -%}
      <div class="contact-form__text">{{ section.settings.text }}</div>
    {%- endif -%}
  </div>

  {%- form 'contact', id: 'ContactForm', class: 'contact-form__form' -%}
    {%- if form.posted_successfully? -%}
      <div style="background: #ecfdf5; color: #065f46; padding: 16px; border-radius: 8px; font-weight: 500;">
        Thank you for contacting us! We'll get back to you as soon as possible.
      </div>
    {%- elsif form.errors -%}
      <div style="background: #fef2f2; color: #991b1b; padding: 16px; border-radius: 8px;">
        {{ form.errors | default_errors }}
      </div>
    {%- endif -%}

    <div class="contact-form__field-group">
      <div>
        <label class="contact-form__label" for="ContactFormName">Name</label>
        <input type="text" id="ContactFormName" name="contact[name]" class="contact-form__input" value="{% if form.name %}{{ form.name }}{% elsif customer %}{{ customer.name }}{% endif %}" placeholder="Your name">
      </div>
      <div>
        <label class="contact-form__label" for="ContactFormEmail">Email</label>
        <input type="email" id="ContactFormEmail" name="contact[email]" class="contact-form__input" value="{% if form.email %}{{ form.email }}{% elsif customer %}{{ customer.email }}{% endif %}" placeholder="your.email@example.com" required>
      </div>
    </div>

    <div>
      <label class="contact-form__label" for="ContactFormPhone">Phone Number</label>
      <input type="tel" id="ContactFormPhone" name="contact[phone]" class="contact-form__input" value="{% if form.phone %}{{ form.phone }}{% elsif customer %}{{ customer.phone }}{% endif %}" placeholder="+1 (555) 000-0000">
    </div>

    <div>
      <label class="contact-form__label" for="ContactFormMessage">Message</label>
      <textarea id="ContactFormMessage" name="contact[body]" class="contact-form__textarea" placeholder="How can we help you?" required>{{ form.body }}</textarea>
    </div>

    <button type="submit" class="contact-form__submit">
      Send Message
    </button>
  {%- endform -%}
</div>

{% schema %}
{
  "name": "Contact form",
  "tag": "section",
  "class": "section--contact-form",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "default": "Get in Touch",
      "label": "Heading"
    },
    {
      "type": "richtext",
      "id": "text",
      "label": "Text",
      "default": "<p>Have questions about an order or our collections? Send us a message and our support team will get back to you within 24 hours.</p>"
    },
    {
      "type": "color",
      "id": "bg_color",
      "label": "Background color",
      "default": "#ffffff"
    },
    {
      "type": "color",
      "id": "heading_color",
      "label": "Heading color",
      "default": "#121212"
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "Text color",
      "default": "#121212"
    },
    {
      "type": "color",
      "id": "btn_bg_color",
      "label": "Button background",
      "default": "#121212"
    },
    {
      "type": "color",
      "id": "btn_text_color",
      "label": "Button text color",
      "default": "#ffffff"
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "Padding top",
      "default": 60
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "Padding bottom",
      "default": 80
    }
  ],
  "presets": [
    {
      "name": "Contact form"
    }
  ]
}
{% endschema %}
