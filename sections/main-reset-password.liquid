{%- comment -%}
  Main Reset Password Section - E-sellers Professional (v4.9.0)
{%- endcomment -%}

{%- style -%}
  #shopify-section-{{ section.id }} {
    background-color: {{ section.settings.bg_color }};
    color: {{ section.settings.text_color }};
    --section-heading-color: {{ section.settings.heading_color }};
    --section-btn-bg: {{ section.settings.btn_bg_color }};
    --section-btn-text: {{ section.settings.btn_text_color }};
    padding-top: {{ section.settings.padding_top }}px;
    padding-bottom: {{ section.settings.padding_bottom }}px;
  }

  .reset-password-wrapper {
    max-width: 480px;
    margin: 0 auto;
    text-align: center;
  }
{%- endstyle -%}

<div class="page-width">
  <div class="reset-password-wrapper">
    <h1 class="h2">{{ 'customer.recover_password.title' | t }}</h1>
    <p style="color: #71717a; margin-bottom: 24px; font-size: 1.4rem;">Please enter your new password below.</p>

    {%- form 'reset_customer_password' -%}
      {%- if form.errors -%}
        <div style="padding: 12px; background-color: #fef2f2; color: #dc2626; border-radius: 8px; margin-bottom: 16px; text-align: left;">
          {{ form.errors | default_errors }}
        </div>
      {%- endif -%}

      <div class="field">
        <input
          type="password"
          name="customer[password]"
          id="password"
          class="field__input"
          autocomplete="new-password"
          placeholder="New password"
          required
        >
      </div>

      <div class="field">
        <input
          type="password"
          name="customer[password_confirmation]"
          id="password_confirmation"
          class="field__input"
          autocomplete="new-password"
          placeholder="Confirm new password"
          required
        >
      </div>

      <button type="submit" class="button button--primary button--full-width" style="margin-top: 12px;">
        {{ 'customer.recover_password.submit' | t }}
      </button>
    {%- endform -%}
  </div>
</div>

{% schema %}
{
  "name": "Reset Password",
  "settings": [
    {
      "type": "header",
      "content": "Section Colors (Independent)"
    },
    {
      "type": "color",
      "id": "bg_color",
      "label": "Background color",
      "default": "#ffffff"
    },
    {
      "type": "color",
      "id": "heading_color",
      "label": "Heading color",
      "default": "#121212"
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "Text color",
      "default": "#121212"
    },
    {
      "type": "color",
      "id": "btn_bg_color",
      "label": "Button background",
      "default": "#121212"
    },
    {
      "type": "color",
      "id": "btn_text_color",
      "label": "Button text color",
      "default": "#ffffff"
    },
    {
      "type": "header",
      "content": "Section Spacing"
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 20,
      "max": 100,
      "step": 5,
      "unit": "px",
      "label": "Top padding",
      "default": 60
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 20,
      "max": 100,
      "step": 5,
      "unit": "px",
      "label": "Bottom padding",
      "default": 80
    }
  ]
}
{% endschema %}
