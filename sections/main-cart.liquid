{%- comment -%}
  Main Cart Section - E-sellers Professional (v4.9.0)
{%- endcomment -%}

{%- style -%}
  #shopify-section-{{ section.id }} {
    background-color: {{ section.settings.bg_color }};
    color: {{ section.settings.text_color }};
    --section-heading-color: {{ section.settings.heading_color }};
    --section-btn-bg: {{ section.settings.btn_bg_color }};
    --section-btn-text: {{ section.settings.btn_text_color }};
    padding-top: {{ section.settings.padding_top }}px;
    padding-bottom: {{ section.settings.padding_bottom }}px;
  }

  .cart-page-wrapper {
    max-width: 1000px;
    margin: 0 auto;
  }

  .cart-page-table {
    width: 100%;
    border-collapse: collapse;
    margin-bottom: 32px;
  }

  .cart-page-table th {
    text-align: left;
    padding: 16px 0;
    border-bottom: 1px solid #e2e8f0;
    font-size: 1.4rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.05em;
    color: #71717a;
  }

  .cart-page-table td {
    padding: 24px 0;
    border-bottom: 1px solid #e2e8f0;
    vertical-align: middle;
  }
{%- endstyle -%}

<div class="page-width">
  <div class="cart-page-wrapper">
    <h1 class="h1" style="margin-bottom: 32px;">{{ 'cart.title' | t }}</h1>

    {%- if cart.item_count == 0 -%}
      <div style="text-align: center; padding: 64px 20px;">
        <p class="h3">{{ 'cart.empty' | t }}</p>
        <a href="{{ routes.all_products_collection_url }}" class="button button--primary" style="margin-top: 16px;">
          {{ 'cart.continue_shopping' | t }}
        </a>
      </div>
    {%- else -%}
      <form action="{{ routes.cart_url }}" method="post" id="cart">
        <table class="cart-page-table">
          <thead>
            <tr>
              <th>Product</th>
              <th>Quantity</th>
              <th style="text-align: right;">Total</th>
            </tr>
          </thead>
          <tbody>
            {%- for item in cart.items -%}
              <tr>
                <td>
                  <div style="display: flex; gap: 16px; align-items: center;">
                    {%- if item.image -%}
                      <img
                        src="{{ item.image | image_url: width: 160 }}"
                        alt="{{ item.title | escape }}"
                        style="width: 80px; height: 96px; object-fit: cover; border-radius: var(--card-radius, 8px);"
                        loading="lazy"
                        width="80"
                        height="96"
                      >
                    {%- endif -%}
                    <div>
                      <a href="{{ item.url }}" style="font-weight: 600; font-size: 1.5rem; text-decoration: none; color: inherit;">
                        {{ item.product.title | escape }}
                      </a>
                      {%- unless item.product.has_only_default_variant -%}
                        <p style="font-size: 1.3rem; color: #71717a; margin: 4px 0 0 0;">{{ item.variant.title }}</p>
                      {%- endunless -%}
                      <div style="margin-top: 6px; font-weight: 600;">{{ item.price | money }}</div>
                    </div>
                  </div>
                </td>
                <td>
                  <div class="cart-quantity-wrapper">
                    <button type="button" class="cart-quantity-btn" name="minus" data-line="{{ forloop.index }}">{% render 'icon', name: 'minus' %}</button>
                    <input type="number" class="cart-quantity-input" name="updates[]" value="{{ item.quantity }}" min="0">
                    <button type="button" class="cart-quantity-btn" name="plus" data-line="{{ forloop.index }}">{% render 'icon', name: 'plus' %}</button>
                  </div>
                </td>
                <td style="text-align: right; font-weight: 700; font-size: 1.6rem;">
                  {{ item.final_line_price | money }}
                </td>
              </tr>
            {%- endfor -%}
          </tbody>
        </table>

        <!-- Cart Summary Footer -->
        <div style="display: flex; flex-direction: column; align-items: flex-end; gap: 16px;">
          <div style="font-size: 2rem; font-weight: 800;">
            {{ 'cart.subtotal' | t }}: {{ cart.total_price | money_with_currency }}
          </div>
          <p style="font-size: 1.3rem; color: #71717a; margin: 0;">{{ 'cart.taxes_and_shipping_at_checkout' | t }}</p>
          <button type="submit" name="checkout" class="button button--primary" style="padding: 16px 48px; font-size: 1.6rem;">
            {{ 'cart.checkout' | t }} &rarr;
          </button>
        </div>
      </form>
    {%- endif -%}
  </div>
</div>

{% schema %}
{
  "name": "Cart Page",
  "settings": [
    {
      "type": "header",
      "content": "Section Colors (Independent)"
    },
    {
      "type": "color",
      "id": "bg_color",
      "label": "Background color",
      "default": "#ffffff"
    },
    {
      "type": "color",
      "id": "heading_color",
      "label": "Heading color",
      "default": "#121212"
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "Text color",
      "default": "#121212"
    },
    {
      "type": "color",
      "id": "btn_bg_color",
      "label": "Button background",
      "default": "#121212"
    },
    {
      "type": "color",
      "id": "btn_text_color",
      "label": "Button text color",
      "default": "#ffffff"
    },
    {
      "type": "header",
      "content": "Section Spacing"
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 20,
      "max": 100,
      "step": 5,
      "unit": "px",
      "label": "Top padding",
      "default": 40
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 20,
      "max": 100,
      "step": 5,
      "unit": "px",
      "label": "Bottom padding",
      "default": 60
    }
  ]
}
{% endschema %}
