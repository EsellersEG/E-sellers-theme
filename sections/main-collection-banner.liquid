{%- comment -%}
  Main Collection Banner Section - E-sellers Professional (v4.9.0)
{%- endcomment -%}

{%- style -%}
  #shopify-section-{{ section.id }} {
    padding-top: {{ section.settings.padding_top | default: 40 }}px;
    padding-bottom: {{ section.settings.padding_bottom | default: 40 }}px;
    background-color: {{ section.settings.background | default: '#f8fafc' }};
    {% if section.settings.background_gradient != blank %}
      background: {{ section.settings.background_gradient }};
    {% endif %}
    color: {{ section.settings.text_color | default: '#121212' }};
  }

  .es-collection-hero {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 40px;
  }

  .es-collection-hero__text-wrapper {
    flex: 1 1 500px;
    display: flex;
    flex-direction: column;
    gap: 12px;
  }

  .es-collection-hero__title {
    font-size: clamp(2rem, 3.5vw, 3rem);
    font-weight: 700;
    line-height: 1.15;
    margin: 0;
    color: {{ section.settings.heading_color | default: '#0f172a' }};
  }

  .es-collection-hero__description {
    font-size: 1rem;
    line-height: 1.6;
    color: #475569;
    max-width: 650px;
  }

  .es-collection-hero__description p {
    margin: 0 0 8px 0;
  }

  .es-collection-hero__description p:last-child {
    margin-bottom: 0;
  }

  .es-collection-hero__image-container {
    flex: 0 0 clamp(240px, 35%, 440px);
    aspect-ratio: 16 / 9;
    border-radius: 16px;
    overflow: hidden;
    background: #e2e8f0;
    box-shadow: 0 8px 24px -4px rgba(0, 0, 0, 0.08);
  }

  .es-collection-hero__image {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  @media screen and (max-width: 749px) {
    .es-collection-hero {
      flex-direction: column-reverse;
      align-items: flex-start;
      gap: 20px;
    }

    .es-collection-hero__image-container {
      width: 100%;
      flex: none;
    }
  }
{%- endstyle -%}

<div class="page-width">
  <div class="es-collection-hero">
    <div class="es-collection-hero__text-wrapper">
      <h1 class="es-collection-hero__title">
        {{ collection.title | escape }}
      </h1>

      {%- if section.settings.show_collection_description and collection.description != blank -%}
        <div class="es-collection-hero__description">
          {{ collection.description }}
        </div>
      {%- endif -%}
    </div>

    {%- if section.settings.show_collection_image and collection.image -%}
      <div class="es-collection-hero__image-container">
        {{ collection.image | image_url: width: 1000 | image_tag:
          loading: 'eager',
          fetchpriority: 'high',
          class: 'es-collection-hero__image',
          alt: collection.image.alt | default: collection.title | escape
        }}
      </div>
    {%- endif -%}
  </div>
</div>

{% schema %}
{
  "name": "Collection banner",
  "tag": "section",
  "class": "shopify-section--main-collection-banner",
  "settings": [
    {
      "type": "checkbox",
      "id": "show_collection_description",
      "label": "Show collection description",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "show_collection_image",
      "label": "Show collection featured image",
      "default": true
    },
    {
      "type": "header",
      "content": "Colors & Padding"
    },
    {
      "type": "color",
      "id": "background",
      "label": "Background color",
      "default": "#f8fafc"
    },
    {
      "type": "color_background",
      "id": "background_gradient",
      "label": "Background gradient"
    },
    {
      "type": "color",
      "id": "heading_color",
      "label": "Heading color",
      "default": "#0f172a"
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "Text color",
      "default": "#475569"
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "Top padding",
      "default": 40
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "Bottom padding",
      "default": 40
    }
  ]
}
{% endschema %}
