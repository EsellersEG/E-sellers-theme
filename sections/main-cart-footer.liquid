{%- comment -%}
  Main Cart Footer Section - E-sellers Professional (v4.9.0)
{%- endcomment -%}

{%- style -%}
  #shopify-section-{{ section.id }} {
    padding-top: {{ section.settings.padding_top | default: 32 }}px;
    padding-bottom: {{ section.settings.padding_bottom | default: 48 }}px;
    background-color: {{ section.settings.background | default: '#ffffff' }};
  }

  .es-cart-footer {
    display: flex;
    justify-content: flex-end;
  }

  .es-cart-footer__box {
    max-width: 440px;
    width: 100%;
    padding: 28px;
    border-radius: 16px;
    background-color: #f8fafc;
    border: 1px solid #e2e8f0;
    box-sizing: border-box;
    display: flex;
    flex-direction: column;
    gap: 20px;
  }

  .es-cart-footer__discounts {
    list-style: none;
    padding: 0;
    margin: 0 0 12px 0;
    display: flex;
    flex-direction: column;
    gap: 6px;
  }

  .es-cart-footer__discount-pill {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    font-size: 0.85rem;
    font-weight: 600;
    color: #15803d;
    background: #dcfce7;
    padding: 4px 10px;
    border-radius: 6px;
  }

  .es-cart-footer__row {
    display: flex;
    justify-content: space-between;
    align-items: center;
    font-size: 0.95rem;
    color: #64748b;
  }

  .es-cart-footer__row--total {
    font-size: 1.25rem;
    font-weight: 700;
    color: #0f172a;
    padding-top: 12px;
    border-top: 1px solid #e2e8f0;
  }

  .es-cart-footer__tax-note {
    font-size: 0.85rem;
    color: #64748b;
    margin: 0;
    line-height: 1.4;
  }

  .es-cart-footer__note {
    display: flex;
    flex-direction: column;
    gap: 6px;
  }

  .es-cart-footer__note-label {
    font-size: 0.875rem;
    font-weight: 600;
    color: #334155;
  }

  .es-cart-footer__note-textarea {
    width: 100%;
    min-height: 70px;
    padding: 10px 12px;
    border: 1px solid #cbd5e1;
    border-radius: 8px;
    font-size: 0.9rem;
    color: #0f172a;
    background: #ffffff;
    outline: none;
    box-sizing: border-box;
    resize: vertical;
    transition: border-color 0.2s ease;
  }

  .es-cart-footer__note-textarea:focus {
    border-color: #0f172a;
  }

  .es-cart-footer__checkout-btn {
    width: 100%;
    padding: 15px 24px;
    background-color: #0f172a;
    color: #ffffff;
    border: none;
    border-radius: 10px;
    font-size: 1rem;
    font-weight: 700;
    cursor: pointer;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 8px;
    text-decoration: none;
    transition: background-color 0.2s ease, transform 0.2s ease;
  }

  .es-cart-footer__checkout-btn:hover {
    background-color: #1e293b;
    transform: translateY(-1px);
  }

  .es-cart-footer__checkout-btn[disabled] {
    opacity: 0.5;
    cursor: not-allowed;
    transform: none;
  }

  .es-cart-footer__payment-methods {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 8px;
    margin-top: 4px;
  }

  .es-cart-footer__payment-title {
    font-size: 0.8rem;
    text-transform: uppercase;
    letter-spacing: 0.05em;
    color: #94a3b8;
    font-weight: 600;
  }

  .es-cart-footer__payment-list {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 8px;
    list-style: none;
    margin: 0;
    padding: 0;
    flex-wrap: wrap;
  }

  @media screen and (max-width: 749px) {
    .es-cart-footer {
      justify-content: stretch;
    }
    .es-cart-footer__box {
      max-width: 100%;
      padding: 20px 16px;
    }
  }
{%- endstyle -%}

<div id="main-cart-footer" class="page-width {% if cart == empty %}is-empty{% endif %}" data-id="{{ section.id }}">
  <div class="es-cart-footer">
    <div class="es-cart-footer__box">
      {%- for block in section.blocks -%}
        {%- case block.type -%}
          {%- when '@app' -%}
            {% render block %}

          {%- when 'subtotal' -%}
            <div class="es-cart-footer__subtotal-block" {{ block.shopify_attributes }}>
              {%- if cart.cart_level_discount_applications.size > 0 -%}
                <ul class="es-cart-footer__discounts" role="list">
                  {%- for discount in cart.cart_level_discount_applications -%}
                    <li class="es-cart-footer__discount-pill">
                      <svg viewBox="0 0 24 24" width="14" height="14" fill="none" stroke="currentColor" stroke-width="2"><path d="M20.59 13.41l-7.17 7.17a2 2 0 0 1-2.83 0L2 12V2h10l8.59 8.59a2 2 0 0 1 0 2.82z"></path><line x1="7" y1="7" x2="7.01" y2="7"></line></svg>
                      <span>{{ discount.title | escape }} (-{{ discount.total_allocated_amount | money }})</span>
                    </li>
                  {%- endfor -%}
                </ul>
              {%- endif -%}

              <div class="es-cart-footer__row">
                <span>Subtotal</span>
                <span>{{ cart.items_subtotal_price | money }}</span>
              </div>

              <div class="es-cart-footer__row es-cart-footer__row--total">
                <span>Estimated Total</span>
                <span>{{ cart.total_price | money_with_currency }}</span>
              </div>

              <p class="es-cart-footer__tax-note" style="margin-top: 6px;">
                Taxes and shipping calculated at checkout
              </p>

              {%- if settings.show_cart_note != false -%}
                <div class="es-cart-footer__note" style="margin-top: 14px;">
                  <label class="es-cart-footer__note-label" for="Cart-note">Order special instructions</label>
                  <textarea
                    class="es-cart-footer__note-textarea"
                    name="note"
                    form="cart"
                    id="Cart-note"
                    placeholder="Notes for order fulfillment..."
                  >{{ cart.note }}</textarea>
                </div>
              {%- endif -%}
            </div>

          {%- when 'buttons' -%}
            <div class="es-cart-footer__ctas-block" {{ block.shopify_attributes }}>
              <button
                type="submit"
                id="checkout"
                class="es-cart-footer__checkout-btn"
                name="checkout"
                form="cart"
                {% if cart == empty %}disabled{% endif %}
              >
                <svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
                  <rect x="3" y="11" width="18" height="11" rx="2" ry="2"></rect>
                  <path d="M7 11V7a5 5 0 0 1 10 0v4"></path>
                </svg>
                <span>{{ 'sections.cart.checkout' | t | default: 'Proceed to Checkout' }}</span>
              </button>

              {%- if additional_checkout_buttons -%}
                <div class="additional-checkout-buttons" style="margin-top: 10px;">
                  {{ content_for_additional_checkout_buttons }}
                </div>
              {%- endif -%}

              {%- if shop.enabled_payment_types.size > 0 -%}
                <div class="es-cart-footer__payment-methods">
                  <span class="es-cart-footer__payment-title">Guaranteed Safe Checkout</span>
                  <ul class="es-cart-footer__payment-list" role="list">
                    {%- for type in shop.enabled_payment_types -%}
                      <li>{{ type | payment_type_svg_tag: class: 'icon icon--full-color' }}</li>
                    {%- endfor -%}
                  </ul>
                </div>
              {%- endif -%}
            </div>
        {%- endcase -%}
      {%- endfor -%}
    </div>
  </div>
</div>

{% schema %}
{
  "name": "Cart footer",
  "tag": "section",
  "class": "shopify-section--main-cart-footer",
  "settings": [
    {
      "type": "color",
      "id": "background",
      "label": "Background color",
      "default": "#ffffff"
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "Top padding",
      "default": 32
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "Bottom padding",
      "default": 48
    }
  ],
  "blocks": [
    {
      "type": "subtotal",
      "name": "Subtotal",
      "limit": 1
    },
    {
      "type": "buttons",
      "name": "Checkout buttons",
      "limit": 1
    },
    {
      "type": "@app"
    }
  ],
  "presets": [
    {
      "name": "Cart footer",
      "blocks": [
        { "type": "subtotal" },
        { "type": "buttons" }
      ]
    }
  ]
}
{% endschema %}
