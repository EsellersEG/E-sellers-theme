<section
  class="section-hot-spots color-{{ section.settings.color_scheme }}"
  id="HotSpots-{{ section.id }}"
  data-section-id="{{ section.id }}"
>
  <div class="page-width section-spacing">
    {%- if section.settings.title != blank or section.settings.subheading != blank -%}
      <div class="section-header text-center" style="margin-bottom: 2.5rem;">
        {%- if section.settings.subheading != blank -%}
          <span class="text-subheading">{{ section.settings.subheading | escape }}</span>
        {%- endif -%}
        {%- if section.settings.title != blank -%}
          <h2 class="h2" style="margin-bottom: 0.5rem;">{{ section.settings.title | escape }}</h2>
        {%- endif -%}
      </div>
    {%- endif -%}

    <div class="hot-spots-wrapper">
      <div class="hot-spots__image-container">
        {%- if section.settings.image != blank -%}
          <img
            src="{{ section.settings.image | image_url: width: 2000 }}"
            alt="{{ section.settings.image.alt | default: section.settings.title | escape }}"
            width="{{ section.settings.image.width }}"
            height="{{ section.settings.image.height }}"
            loading="lazy"
            class="hot-spots__image"
          >
        {%- else -%}
          <div class="hot-spots__placeholder" style="background-color: #374151; height: 500px; display: flex; align-items: center; justify-content: center;">
            {{ 'lifestyle-1' | placeholder_svg_tag: 'placeholder-svg' }}
          </div>
        {%- endif -%}

        {%- for block in section.blocks -%}
          {%- assign product = block.settings.product -%}
          <div
            class="hot-spot-pin"
            style="top: {{ block.settings.vertical_position }}%; left: {{ block.settings.horizontal_position }}%;"
            {{ block.shopify_attributes }}
          >
            <button
              type="button"
              class="hot-spot-pin__btn"
              aria-label="View product {{ product.title | default: forloop.index }}"
            >
              <span class="hot-spot-pin__pulse"></span>
              <span class="hot-spot-pin__dot"></span>
            </button>

            <div class="hot-spot-card color-scheme-1">
              {%- if product != blank -%}
                <div class="hot-spot-card__inner">
                  {%- if product.featured_image -%}
                    <img
                      src="{{ product.featured_image | image_url: width: 140 }}"
                      alt="{{ product.title | escape }}"
                      width="70"
                      height="70"
                      loading="lazy"
                      class="hot-spot-card__img"
                    >
                  {%- endif -%}
                  <div class="hot-spot-card__details">
                    <a href="{{ product.url }}" class="hot-spot-card__title">{{ product.title | escape }}</a>
                    <div class="hot-spot-card__price">{{ product.price | money }}</div>
                    <button
                      type="button"
                      class="button button--primary button--sm"
                      style="margin-top: 0.5rem;"
                      onclick="window.cartDrawer && window.cartDrawer.addItem({ id: {{ product.first_available_variant.id }}, quantity: 1 })"
                    >
                      Add to cart
                    </button>
                  </div>
                </div>
              {%- else -%}
                <div class="hot-spot-card__inner">
                  <div class="hot-spot-card__details">
                    <div class="hot-spot-card__title">Selected Product {{ forloop.index }}</div>
                    <div class="hot-spot-card__price">$35.00</div>
                  </div>
                </div>
              {%- endif -%}
            </div>
          </div>
        {%- endfor -%}
      </div>
    </div>
  </div>
</section>

<style>
  .hot-spots-wrapper {
    max-width: 1100px;
    margin: 0 auto;
    border-radius: var(--radius-card);
    overflow: hidden;
    box-shadow: var(--shadow-lg);
  }
  .hot-spots__image-container {
    position: relative;
    width: 100%;
  }
  .hot-spots__image {
    width: 100%;
    height: auto;
    display: block;
  }
  .hot-spot-pin {
    position: absolute;
    transform: translate(-50%, -50%);
    z-index: 10;
  }
  .hot-spot-pin__btn {
    position: relative;
    width: 32px;
    height: 32px;
    border-radius: 50%;
    background: transparent;
    border: none;
    cursor: pointer;
    display: flex;
    align-items: center;
    justify-content: center;
    padding: 0;
  }
  .hot-spot-pin__dot {
    width: 14px;
    height: 14px;
    border-radius: 50%;
    background-color: #FFFFFF;
    box-shadow: 0 0 10px rgba(0, 0, 0, 0.5);
    position: relative;
    z-index: 2;
    transition: transform var(--duration-fast);
  }
  .hot-spot-pin__pulse {
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    border-radius: 50%;
    background-color: rgba(255, 255, 255, 0.6);
    animation: hotSpotPulse 2s infinite;
  }
  .hot-spot-pin:hover .hot-spot-pin__dot {
    transform: scale(1.25);
    background-color: var(--color-accent);
  }
  .hot-spot-card {
    position: absolute;
    bottom: 120%;
    left: 50%;
    transform: translateX(-50%) translateY(10px);
    width: 240px;
    padding: 0.85rem;
    border-radius: var(--radius-card);
    box-shadow: var(--shadow-xl);
    border: 1px solid var(--color-border);
    opacity: 0;
    visibility: hidden;
    pointer-events: none;
    transition: all var(--duration-normal) var(--ease-standard);
    z-index: 20;
  }
  .hot-spot-pin:hover .hot-spot-card,
  .hot-spot-pin:focus-within .hot-spot-card {
    opacity: 1;
    visibility: visible;
    pointer-events: auto;
    transform: translateX(-50%) translateY(0);
  }
  .hot-spot-card__inner {
    display: flex;
    gap: 0.75rem;
    align-items: center;
  }
  .hot-spot-card__img {
    width: 60px;
    height: 60px;
    object-fit: cover;
    border-radius: var(--radius-input);
    flex-shrink: 0;
  }
  .hot-spot-card__details {
    flex-grow: 1;
  }
  .hot-spot-card__title {
    font-size: 0.85rem;
    font-weight: 600;
    color: inherit;
    text-decoration: none;
    display: block;
    margin-bottom: 0.2rem;
  }
  .hot-spot-card__price {
    font-size: 0.8rem;
    font-weight: 700;
  }
  @keyframes hotSpotPulse {
    0% { transform: scale(0.6); opacity: 0.8; }
    100% { transform: scale(1.6); opacity: 0; }
  }
</style>

{% schema %}
{
  "name": "Shoppable hotspots",
  "settings": [
    {
      "type": "select",
      "id": "color_scheme",
      "label": "Color scheme",
      "options": [
        { "value": "scheme-1", "label": "Scheme 1" },
        { "value": "scheme-2", "label": "Scheme 2" },
        { "value": "scheme-3", "label": "Scheme 3" },
        { "value": "scheme-4", "label": "Scheme 4" }
      ],
      "default": "scheme-1"
    },
    {
      "type": "text",
      "id": "subheading",
      "label": "Subheading",
      "default": "Shop the Scene"
    },
    {
      "type": "text",
      "id": "title",
      "label": "Heading",
      "default": "Explore the Collection"
    },
    {
      "type": "image_picker",
      "id": "image",
      "label": "Lifestyle image"
    }
  ],
  "blocks": [
    {
      "type": "hotspot",
      "name": "Hotspot pin",
      "settings": [
        {
          "type": "product",
          "id": "product",
          "label": "Product"
        },
        {
          "type": "range",
          "id": "horizontal_position",
          "min": 5,
          "max": 95,
          "step": 1,
          "unit": "%",
          "label": "Horizontal position",
          "default": 35
        },
        {
          "type": "range",
          "id": "vertical_position",
          "min": 5,
          "max": 95,
          "step": 1,
          "unit": "%",
          "label": "Vertical position",
          "default": 45
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Shoppable hotspots",
      "blocks": [
        { "type": "hotspot", "settings": { "horizontal_position": 30, "vertical_position": 40 } },
        { "type": "hotspot", "settings": { "horizontal_position": 70, "vertical_position": 60 } }
      ]
    }
  ]
}
{% endschema %}
