{%- comment -%}
  Collage Section - E-sellers Professional (v4.9.0)
{%- endcomment -%}

{%- style -%}
  #shopify-section-{{ section.id }} {
    background-color: {{ section.settings.bg_color }};
    color: {{ section.settings.text_color }};
    --section-heading-color: {{ section.settings.heading_color }};
    padding-top: {{ section.settings.padding_top }}px;
    padding-bottom: {{ section.settings.padding_bottom }}px;
  }

  .collage__header {
    text-align: center;
    margin-bottom: 40px;
  }

  .collage__subheading {
    font-size: 0.85rem;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    font-weight: 600;
    opacity: 0.7;
    margin-bottom: 8px;
  }

  .collage__heading {
    font-size: clamp(1.5rem, 3vw, 2.25rem);
    font-weight: 700;
    color: var(--section-heading-color);
    margin: 0;
  }

  .collage__grid {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: {{ section.settings.gap }}px;
    align-items: start;
  }

  @media screen and (max-width: 749px) {
    .collage__grid {
      grid-template-columns: 1fr;
    }
  }

  .collage__item {
    position: relative;
    overflow: hidden;
    border-radius: {{ section.settings.card_radius }}px;
    background: {{ section.settings.card_bg_color }};
  }

  .collage__item:first-child {
    grid-row: span 2;
  }

  @media screen and (max-width: 749px) {
    .collage__item:first-child {
      grid-row: auto;
    }
  }

  .collage__item-image {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
    transition: transform 0.4s ease;
  }

  .collage__item:hover .collage__item-image {
    transform: scale(1.03);
  }

  .collage__item-link {
    display: block;
    text-decoration: none;
    color: inherit;
    height: 100%;
  }

  .collage__product {
    padding: 16px;
  }

  .collage__product-title {
    font-weight: 600;
    font-size: 1rem;
    margin: 12px 0 4px;
  }

  .collage__product-price {
    font-weight: 500;
    opacity: 0.8;
  }

  .collage__collection-overlay {
    position: absolute;
    bottom: 0;
    left: 0;
    right: 0;
    padding: 24px;
    background: linear-gradient(transparent, rgba(0,0,0,0.7));
    color: #fff;
  }

  .collage__collection-title {
    font-size: 1.25rem;
    font-weight: 700;
    margin: 0;
  }
{%- endstyle -%}

<div class="page-width">
  {%- if section.settings.heading != blank -%}
    <div class="collage__header">
      {%- if section.settings.subheading != blank -%}
        <p class="collage__subheading">{{ section.settings.subheading }}</p>
      {%- endif -%}
      <h2 class="collage__heading">{{ section.settings.heading }}</h2>
    </div>
  {%- endif -%}

  <div class="collage__grid">
    {%- for block in section.blocks -%}
      {%- case block.type -%}
        {%- when 'image' -%}
          <div class="collage__item" {{ block.shopify_attributes }}>
            {%- if block.settings.link != blank -%}
              <a href="{{ block.settings.link }}" class="collage__item-link">
            {%- endif -%}
              {%- if block.settings.image != blank -%}
                <img
                  class="collage__item-image"
                  src="{{ block.settings.image | image_url: width: 900 }}"
                  alt="{{ block.settings.image.alt | escape }}"
                  loading="lazy"
                  width="{{ block.settings.image.width }}"
                  height="{{ block.settings.image.height }}"
                >
              {%- else -%}
                {{ 'image' | placeholder_svg_tag: 'placeholder-svg' }}
              {%- endif -%}
            {%- if block.settings.link != blank -%}
              </a>
            {%- endif -%}
          </div>

        {%- when 'product' -%}
          {%- if block.settings.product != blank -%}
            <div class="collage__item" {{ block.shopify_attributes }}>
              <a href="{{ block.settings.product.url }}" class="collage__item-link">
                {%- if block.settings.product.featured_image != blank -%}
                  <img
                    class="collage__item-image"
                    src="{{ block.settings.product.featured_image | image_url: width: 900 }}"
                    alt="{{ block.settings.product.featured_image.alt | escape }}"
                    loading="lazy"
                    width="{{ block.settings.product.featured_image.width }}"
                    height="{{ block.settings.product.featured_image.height }}"
                  >
                {%- endif -%}
                <div class="collage__product">
                  <p class="collage__product-title">{{ block.settings.product.title }}</p>
                  <p class="collage__product-price">{{ block.settings.product.price | money }}</p>
                </div>
              </a>
            </div>
          {%- endif -%}

        {%- when 'collection' -%}
          {%- if block.settings.collection != blank -%}
            <div class="collage__item" {{ block.shopify_attributes }}>
              <a href="{{ block.settings.collection.url }}" class="collage__item-link">
                {%- if block.settings.collection.image != blank -%}
                  <img
                    class="collage__item-image"
                    src="{{ block.settings.collection.image | image_url: width: 900 }}"
                    alt="{{ block.settings.collection.image.alt | escape }}"
                    loading="lazy"
                    width="{{ block.settings.collection.image.width }}"
                    height="{{ block.settings.collection.image.height }}"
                  >
                {%- else -%}
                  {{ 'collection-1' | placeholder_svg_tag: 'placeholder-svg' }}
                {%- endif -%}
                <div class="collage__collection-overlay">
                  <h3 class="collage__collection-title">{{ block.settings.collection.title }}</h3>
                </div>
              </a>
            </div>
          {%- endif -%}
      {%- endcase -%}
    {%- endfor -%}
  </div>
</div>

{% schema %}
{
  "name": "Collage",
  "tag": "section",
  "class": "section--collage",
  "settings": [
    {
      "type": "text",
      "id": "subheading",
      "label": "Subheading"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Collage"
    },
    {
      "type": "range",
      "id": "gap",
      "min": 8,
      "max": 40,
      "step": 4,
      "unit": "px",
      "label": "Gap",
      "default": 16
    },
    {
      "type": "range",
      "id": "card_radius",
      "min": 0,
      "max": 24,
      "step": 2,
      "unit": "px",
      "label": "Card corner radius",
      "default": 12
    },
    {
      "type": "header",
      "content": "Colors"
    },
    {
      "type": "color",
      "id": "bg_color",
      "label": "Background color",
      "default": "#ffffff"
    },
    {
      "type": "color",
      "id": "heading_color",
      "label": "Heading color",
      "default": "#121212"
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "Text color",
      "default": "#334155"
    },
    {
      "type": "color",
      "id": "card_bg_color",
      "label": "Card background",
      "default": "#f8fafc"
    },
    {
      "type": "header",
      "content": "Spacing"
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 0,
      "max": 120,
      "step": 4,
      "unit": "px",
      "label": "Top padding",
      "default": 60
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 0,
      "max": 120,
      "step": 4,
      "unit": "px",
      "label": "Bottom padding",
      "default": 60
    }
  ],
  "blocks": [
    {
      "type": "image",
      "name": "Image",
      "settings": [
        {
          "type": "image_picker",
          "id": "image",
          "label": "Image"
        },
        {
          "type": "url",
          "id": "link",
          "label": "Link"
        }
      ]
    },
    {
      "type": "product",
      "name": "Product",
      "settings": [
        {
          "type": "product",
          "id": "product",
          "label": "Product"
        }
      ]
    },
    {
      "type": "collection",
      "name": "Collection",
      "settings": [
        {
          "type": "collection",
          "id": "collection",
          "label": "Collection"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Collage",
      "blocks": [
        { "type": "image" },
        { "type": "product" },
        { "type": "collection" }
      ]
    }
  ]
}
{% endschema %}
