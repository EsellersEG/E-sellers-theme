{%- comment -%}
  Main Product Section - E-sellers Professional (v4.9.0)
{%- endcomment -%}

{%- style -%}
  #shopify-section-{{ section.id }} {
    background-color: {{ section.settings.bg_color }};
    color: {{ section.settings.text_color }};
    --section-heading-color: {{ section.settings.heading_color }};
    --section-btn-bg: {{ section.settings.btn_bg_color }};
    --section-btn-text: {{ section.settings.btn_text_color }};
    padding-top: {{ section.settings.padding_top }}px;
    padding-bottom: {{ section.settings.padding_bottom }}px;
  }

  .product-page-grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: 40px;
    align-items: start;
  }

  @media screen and (min-width: 990px) {
    .product-page-grid {
      grid-template-columns: 1.1fr 0.9fr;
      gap: 60px;
    }
  }

  .product__info-wrapper {
    display: flex;
    flex-direction: column;
    gap: 18px;
  }

  .product__trust-badges {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 12px;
    padding: 16px;
    background: #f8fafc;
    border: 1px solid #e2e8f0;
    border-radius: var(--card-radius, 12px);
    margin-top: 8px;
  }

  .product__trust-item {
    display: flex;
    flex-direction: column;
    align-items: center;
    text-align: center;
    gap: 6px;
    font-size: 1.2rem;
    font-weight: 600;
    color: #475569;
  }

  .product__collapsible-tab {
    border: 1px solid #e2e8f0;
    border-radius: var(--card-radius, 8px);
    padding: 14px 18px;
    background: #ffffff;
  }

  .product__collapsible-summary {
    cursor: pointer;
    font-size: 1.5rem;
    font-weight: 700;
    display: flex;
    align-items: center;
    justify-content: space-between;
    user-select: none;
  }
{%- endstyle -%}

<section class="page-width">
  <div class="product-page-grid">
    <!-- Media Gallery Column -->
    <div class="product__media-wrapper">
      {% render 'product-media-gallery', product: product, is_sticky: section.settings.enable_sticky_gallery %}
    </div>

    <!-- Product Details / Blocks Column -->
    <div class="product__info-wrapper">
      {%- assign product_form_id = 'product-form-' | append: section.id -%}

      {%- for block in section.blocks -%}
        {%- case block.type -%}
          {%- when '@app' -%}
            {% render block %}

          {%- when 'text' -%}
            <p class="product__text" style="font-size: 1.3rem; text-transform: uppercase; letter-spacing: 0.05em; color: #71717a; margin-bottom: 0;" {{ block.shopify_attributes }}>
              {{ block.settings.text }}
            </p>

          {%- when 'title' -%}
            <h1 class="product__title h2" style="margin-bottom: 0;" {{ block.shopify_attributes }}>
              {{ product.title | escape }}
            </h1>

          {%- when 'price' -%}
            <div id="price-{{ section.id }}" role="status" {{ block.shopify_attributes }}>
              {% render 'price', product: product, use_variant: true, show_badges: true %}
            </div>

          {%- when 'rating' -%}
            <div class="product__rating" style="display: flex; align-items: center; gap: 4px; color: #f59e0b; font-size: 1.4rem;" {{ block.shopify_attributes }}>
              {% render 'icon', name: 'star' %}
              {% render 'icon', name: 'star' %}
              {% render 'icon', name: 'star' %}
              {% render 'icon', name: 'star' %}
              {% render 'icon', name: 'star' %}
              <span style="color: #71717a; font-size: 1.3rem; margin-left: 4px;">5.0 (128 reviews)</span>
            </div>

          {%- when 'variant_picker' -%}
            {% render 'product-variant-picker', product: product, block: block, product_form_id: product_form_id %}

          {%- when 'buy_buttons' -%}
            {% render 'buy-buttons', product: product, block: block, product_form_id: product_form_id, show_dynamic_checkout: block.settings.show_dynamic_checkout, show_quantity: true %}

          {%- when 'description' -%}
            {%- if product.description != blank -%}
              <div class="product__description" style="font-size: 1.5rem; line-height: 1.7; color: inherit;" {{ block.shopify_attributes }}>
                {{ product.description }}
              </div>
            {%- endif -%}

          {%- when 'collapsible_tab' -%}
            <details class="product__collapsible-tab" {{ block.shopify_attributes }}>
              <summary class="product__collapsible-summary">
                <span>{{ block.settings.heading | escape }}</span>
                {% render 'icon', name: 'chevron-down' %}
              </summary>
              <div style="padding-top: 12px; font-size: 1.4rem; line-height: 1.6;">
                {{ block.settings.content }}
                {%- if block.settings.page != blank -%}
                  {{ block.settings.page.content }}
                {%- endif -%}
              </div>
            </details>

          {%- when 'trust_badges' -%}
            <div class="product__trust-badges" {{ block.shopify_attributes }}>
              <div class="product__trust-item">
                {% render 'icon', name: 'truck' %}
                <span>Fast Free Shipping</span>
              </div>
              <div class="product__trust-item">
                {% render 'icon', name: 'shield' %}
                <span>Secure Checkout</span>
              </div>
              <div class="product__trust-item">
                {% render 'icon', name: 'check' %}
                <span>30-Day Guarantee</span>
              </div>
            </div>

          {%- when 'share' -%}
            <div class="product__share" style="display: flex; align-items: center; gap: 12px; font-size: 1.3rem; color: #71717a;" {{ block.shopify_attributes }}>
              <span>{{ 'general.share.share' | t }}:</span>
              <a href="https://www.facebook.com/sharer.php?u={{ shop.url | append: product.url }}" target="_blank" rel="noopener" aria-label="Share on Facebook">{% render 'icon', name: 'facebook' %}</a>
              <a href="https://twitter.com/share?url={{ shop.url | append: product.url }}&text={{ product.title | url_param_escape }}" target="_blank" rel="noopener" aria-label="Share on Twitter">{% render 'icon', name: 'twitter' %}</a>
            </div>
        {%- endcase -%}
      {%- endfor -%}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Product Information",
  "settings": [
    {
      "type": "header",
      "content": "Section Colors (Independent)"
    },
    {
      "type": "color",
      "id": "bg_color",
      "label": "Background color",
      "default": "#ffffff"
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "Text color",
      "default": "#121212"
    },
    {
      "type": "color",
      "id": "heading_color",
      "label": "Heading color",
      "default": "#121212"
    },
    {
      "type": "color",
      "id": "btn_bg_color",
      "label": "Button background",
      "default": "#121212"
    },
    {
      "type": "color",
      "id": "btn_text_color",
      "label": "Button text color",
      "default": "#ffffff"
    },
    {
      "type": "header",
      "content": "Gallery Layout"
    },
    {
      "type": "checkbox",
      "id": "enable_sticky_gallery",
      "default": true,
      "label": "Enable sticky gallery on desktop"
    },
    {
      "type": "header",
      "content": "Section Spacing"
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 10,
      "max": 100,
      "step": 5,
      "unit": "px",
      "label": "Top padding",
      "default": 40
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 10,
      "max": 100,
      "step": 5,
      "unit": "px",
      "label": "Bottom padding",
      "default": 60
    }
  ],
  "blocks": [
    {
      "type": "@app"
    },
    {
      "type": "text",
      "name": "Text / Subtitle",
      "settings": [
        {
          "type": "text",
          "id": "text",
          "label": "Text",
          "default": "Premium Collection"
        }
      ]
    },
    {
      "type": "title",
      "name": "Title",
      "limit": 1
    },
    {
      "type": "price",
      "name": "Price",
      "limit": 1
    },
    {
      "type": "rating",
      "name": "Star Rating",
      "limit": 1
    },
    {
      "type": "variant_picker",
      "name": "Variant Picker",
      "limit": 1
    },
    {
      "type": "buy_buttons",
      "name": "Buy Buttons",
      "limit": 1,
      "settings": [
        {
          "type": "checkbox",
          "id": "show_dynamic_checkout",
          "default": true,
          "label": "Show dynamic checkout button (Shop Pay / PayPal)"
        }
      ]
    },
    {
      "type": "description",
      "name": "Description",
      "limit": 1
    },
    {
      "type": "collapsible_tab",
      "name": "Collapsible Tab",
      "settings": [
        {
          "type": "text",
          "id": "heading",
          "label": "Heading",
          "default": "Shipping & Returns"
        },
        {
          "type": "richtext",
          "id": "content",
          "label": "Content",
          "default": "<p>We offer free standard shipping on orders over $100. Easy 30-day returns on all items.</p>"
        },
        {
          "type": "page",
          "id": "page",
          "label": "Content from page (optional)"
        }
      ]
    },
    {
      "type": "trust_badges",
      "name": "Trust Badges",
      "limit": 1
    },
    {
      "type": "share",
      "name": "Share",
      "limit": 1
    }
  ],
  "default": {
    "blocks": [
      { "type": "title" },
      { "type": "rating" },
      { "type": "price" },
      { "type": "variant_picker" },
      { "type": "buy_buttons" },
      { "type": "description" },
      { "type": "trust_badges" },
      { "type": "collapsible_tab" }
    ]
  }
}
{% endschema %}
