{%- liquid
  assign current_variant = product.selected_or_first_available_variant
  assign featured_media = current_variant.featured_media | default: product.featured_media
-%}

<section
  class="section-main-product color-{{ section.settings.color_scheme }}"
  id="MainProduct-{{ section.id }}"
  data-section-id="{{ section.id }}"
  data-product-id="{{ product.id }}"
  data-url="{{ product.url }}"
>
  <div class="page-width section-spacing">
    <div class="product-layout">
      {% # 1. Media Gallery %}
      <div class="product-layout__media-col">
        <div class="product-gallery">
          <div class="product-gallery__featured" id="FeaturedMedia-{{ section.id }}">
            {%- if featured_media != blank -%}
              {% render 'product-media', media: featured_media, loop: section.settings.enable_video_looping %}
            {%- else -%}
              <div class="product-media product-media--placeholder">
                {{ 'product-1' | placeholder_svg_tag: 'placeholder-svg' }}
              </div>
            {%- endif -%}
          </div>

          {%- if product.media.size > 1 -%}
            <div class="product-gallery__thumbnails" role="list">
              {%- for media in product.media -%}
                <button
                  type="button"
                  class="product-gallery__thumbnail {% if media.id == featured_media.id %}is-active{% endif %}"
                  data-media-id="{{ media.id }}"
                  data-target-src="{{ media | image_url: width: 1200 }}"
                  aria-label="View media {{ forloop.index }}"
                >
                  <img
                    src="{{ media | image_url: width: 160, height: 160, crop: 'center' }}"
                    alt="{{ media.alt | default: product.title | escape }}"
                    width="80"
                    height="80"
                    loading="lazy"
                  >
                </button>
              {%- endfor -%}
            </div>
          {%- endif -%}
        </div>
      </div>

      {% # 2. Product Information Blocks Column %}
      <div class="product-layout__info-col">
        <div class="product-info-blocks">
          {%- for block in section.blocks -%}
            <div class="product-block product-block--{{ block.type }}" {{ block.shopify_attributes }}>
              {%- case block.type -%}
                {%- when '@app' -%}
                  {% render block %}

                {%- when 'text' -%}
                  <p class="product-text {{ block.settings.text_style }}">{{ block.settings.text | escape }}</p>

                {%- when 'title' -%}
                  <h1 class="product-title">{{ product.title | escape }}</h1>

                {%- when 'price' -%}
                  <div class="product-price-wrap" id="Price-{{ section.id }}" role="status">
                    <div class="product-price">
                      <span class="product-price__current">{{ current_variant.price | money }}</span>
                      {%- if current_variant.compare_at_price > current_variant.price -%}
                        <span class="product-price__compare">{{ current_variant.compare_at_price | money }}</span>
                        <span class="badge badge--sale">{{ 'products.product.price.sale_price' | t }}</span>
                      {%- endif -%}
                    </div>

                    {%- if current_variant.unit_price_measurement -%}
                      <div class="product-unit-price text-muted">
                        <span>{{ current_variant.unit_price | money }}</span>
                        <span>/</span>
                        {%- if current_variant.unit_price_measurement.reference_value != 1 -%}
                          {{ current_variant.unit_price_measurement.reference_value }}
                        {%- endif -%}
                        {{ current_variant.unit_price_measurement.reference_unit }}
                      </div>
                    {%- endif -%}

                    {%- if cart.taxes_included or shop.shipping_policy.body != blank -%}
                      <div class="product-tax-notice text-muted">
                        {%- if cart.taxes_included -%}
                          {{ 'products.product.include_taxes' | default: 'Tax included.' }}
                        {%- endif -%}
                        {%- if shop.shipping_policy.body != blank -%}
                          {{ 'products.product.shipping_policy_html' | default: '<a href="/policies/shipping-policy">Shipping</a> calculated at checkout.' }}
                        {%- endif -%}
                      </div>
                    {%- endif -%}
                  </div>

                {%- when 'installments' -%}
                  <div class="product-installments">
                    {%- form 'product', product -%}
                      <input type="hidden" name="id" value="{{ current_variant.id }}">
                      {{ form | payment_terms }}
                    {%- endform -%}
                  </div>

                {%- when 'variant_picker' -%}
                  {%- unless product.has_only_default_variant -%}
                    <variant-selects
                      class="variant-picker"
                      data-section="{{ section.id }}"
                      data-url="{{ product.url }}"
                    >
                      {%- for option in product.options_with_values -%}
                        <div class="variant-picker__option" data-option-index="{{ forloop.index0 }}">
                          <label class="variant-picker__label" for="Option-{{ section.id }}-{{ forloop.index0 }}">
                            {{ option.name }}: <span class="variant-picker__selected-val">{{ option.selected_value }}</span>
                          </label>

                          {%- if block.settings.picker_type == 'swatch' and option.name contains 'Color' or option.name contains 'Colour' -%}
                            <div class="swatches-grid">
                              {%- for value in option.values -%}
                                <label class="swatch-label {% if option.selected_value == value %}is-active{% endif %}">
                                  <input
                                    type="radio"
                                    name="options[{{ option.name | escape }}]"
                                    value="{{ value | escape }}"
                                    class="visually-hidden"
                                    {% if option.selected_value == value %}checked="checked"{% endif %}
                                  >
                                  <span class="swatch-circle" style="background-color: {{ value | downcase | remove: ' ' }};"></span>
                                  <span class="swatch-text">{{ value }}</span>
                                </label>
                              {%- endfor -%}
                            </div>
                          {%- else -%}
                            <div class="pills-grid">
                              {%- for value in option.values -%}
                                <label class="pill-label {% if option.selected_value == value %}is-active{% endif %}">
                                  <input
                                    type="radio"
                                    name="options[{{ option.name | escape }}]"
                                    value="{{ value | escape }}"
                                    class="visually-hidden"
                                    {% if option.selected_value == value %}checked="checked"{% endif %}
                                  >
                                  <span class="pill-btn">{{ value }}</span>
                                </label>
                              {%- endfor -%}
                            </div>
                          {%- endif -%}
                        </div>
                      {%- endfor -%}

                      <script type="application/json" id="ProductJSON-{{ section.id }}">
                        {{ product.variants | json }}
                      </script>
                    </variant-selects>
                  {%- endunless -%}

                {%- when 'buy_buttons' -%}
                  <div class="product-buy-buttons">
                    {%- form 'product', product, id: 'product-form', class: 'form product-form' -%}
                      <input type="hidden" name="id" value="{{ current_variant.id }}" id="ProductVariantId-{{ section.id }}">

                      {%- if product.gift_card? -%}
                        {% render 'gift-card-recipient-form', product: product, form: form, section: section %}
                      {%- endif -%}

                      <div class="product-form__buttons">
                        <div class="product-form__qty-and-add">
                          <div class="quantity-input">
                            <button type="button" class="quantity-input__btn qty-minus" aria-label="Decrease quantity">-</button>
                            <input type="number" name="quantity" min="1" value="1" class="quantity-input__field" aria-label="Quantity">
                            <button type="button" class="quantity-input__btn qty-plus" aria-label="Increase quantity">+</button>
                          </div>

                          <button
                            type="submit"
                            name="add"
                            class="button button--primary button--lg button--full-width product-form__submit"
                            {% if current_variant.available == false %}disabled{% endif %}
                            id="AddToCart-{{ section.id }}"
                          >
                            <span class="submit-text">
                              {%- if current_variant.available -%}
                                {{ 'products.product.add_to_cart' | t }}
                              {%- else -%}
                                {{ 'products.product.sold_out' | t }}
                              {%- endif -%}
                            </span>
                          </button>
                        </div>

                        {%- if block.settings.show_dynamic_checkout -%}
                          <div class="product-form__dynamic-checkout">
                            {{ form | payment_button }}
                          </div>
                        {%- endif -%}
                      </div>
                    {%- endform -%}
                  </div>

                {%- when 'pickup_availability' -%}
                  <div class="product-pickup-availability" id="PickupAvailability-{{ section.id }}">
                    {%- assign pick_up_availabilities = current_variant.store_availabilities | where: 'pick_up_enabled', true -%}
                    {%- if pick_up_availabilities.size > 0 -%}
                      <div class="pickup-status">
                        <svg class="pickup-icon" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="#10B981" stroke-width="2"><polyline points="20 6 9 17 4 12"></polyline></svg>
                        <span>{{ 'products.product.pickup_availability.pick_up_available' | t }}</span>
                      </div>
                    {%- endif -%}
                  </div>

                {%- when 'description' -%}
                  {%- if product.description != blank -%}
                    <div class="product-description rte">
                      {{ product.description }}
                    </div>
                  {%- endif -%}

                {%- when 'collapsible_tab' -%}
                  <details class="product-accordion">
                    <summary class="product-accordion__summary">
                      <span class="product-accordion__title">{{ block.settings.heading | escape }}</span>
                      <svg class="accordion-icon" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><polyline points="6 9 12 15 18 9"></polyline></svg>
                    </summary>
                    <div class="product-accordion__content rte">
                      {{ block.settings.content }}
                      {{ block.settings.page.content }}
                    </div>
                  </details>

                {%- when 'custom_liquid' -%}
                  <div class="product-custom-liquid">
                    {{ block.settings.custom_liquid }}
                  </div>
              {%- endcase -%}
            </div>
          {%- endfor -%}
        </div>
      </div>
    </div>
  </div>
</section>

<style>
  .product-layout {
    display: grid;
    grid-template-columns: 1fr;
    gap: 2.5rem;
  }
  @media (min-width: 990px) {
    .product-layout {
      grid-template-columns: 1.15fr 0.85fr;
      gap: 4rem;
      align-items: start;
    }
  }
  .product-gallery {
    position: sticky;
    top: 6rem;
  }
  .product-gallery__featured {
    border-radius: var(--radius-card);
    overflow: hidden;
    margin-bottom: 1rem;
  }
  .product-gallery__thumbnails {
    display: flex;
    gap: 0.75rem;
    overflow-x: auto;
    padding-bottom: 0.5rem;
  }
  .product-gallery__thumbnail {
    border: 2px solid transparent;
    border-radius: var(--radius-input);
    overflow: hidden;
    cursor: pointer;
    background: transparent;
    padding: 0;
    width: 70px;
    height: 70px;
    flex-shrink: 0;
    opacity: 0.6;
    transition: opacity var(--duration-fast), border-color var(--duration-fast);
  }
  .product-gallery__thumbnail:hover,
  .product-gallery__thumbnail.is-active {
    opacity: 1;
    border-color: var(--color-accent);
  }
  .product-gallery__thumbnail img {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }
  .product-info-blocks {
    display: flex;
    flex-direction: column;
    gap: 1.25rem;
  }
  .product-title {
    font-size: clamp(1.75rem, 3.5vw, 2.5rem);
    margin-bottom: 0.25rem;
  }
  .product-price-wrap {
    display: flex;
    flex-direction: column;
    gap: 0.35rem;
  }
  .product-price {
    display: flex;
    align-items: baseline;
    gap: 0.75rem;
  }
  .product-price__current {
    font-size: 1.5rem;
    font-weight: 700;
  }
  .product-price__compare {
    font-size: 1.15rem;
    text-decoration: line-through;
    opacity: 0.5;
  }
  .variant-picker__option {
    margin-bottom: 1.25rem;
  }
  .variant-picker__label {
    font-size: 0.9rem;
    font-weight: 600;
    margin-bottom: 0.5rem;
    display: block;
  }
  .variant-picker__selected-val {
    font-weight: 400;
    opacity: 0.8;
  }
  .swatches-grid {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
  }
  .swatch-label {
    cursor: pointer;
  }
  .swatch-circle {
    display: block;
    width: 32px;
    height: 32px;
    border-radius: 50%;
    border: 2px solid var(--color-border);
    transition: transform var(--duration-fast), border-color var(--duration-fast);
  }
  .swatch-text {
    display: none;
  }
  .swatch-label.is-active .swatch-circle,
  .swatch-label:hover .swatch-circle {
    border-color: var(--color-text);
    transform: scale(1.1);
  }
  .pills-grid {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
  }
  .pill-label {
    cursor: pointer;
  }
  .pill-btn {
    display: inline-block;
    padding: 0.5rem 1rem;
    font-size: 0.9rem;
    font-weight: 500;
    border: 1px solid var(--color-border);
    border-radius: var(--radius-button);
    transition: all var(--duration-fast);
  }
  .pill-label.is-active .pill-btn,
  .pill-label:hover .pill-btn {
    border-color: var(--color-text);
    background-color: var(--color-text);
    color: var(--color-bg);
  }
  .product-form__qty-and-add {
    display: flex;
    gap: 0.75rem;
  }
  .quantity-input {
    display: inline-flex;
    align-items: center;
    border: 1px solid var(--color-border);
    border-radius: var(--radius-button);
    flex-shrink: 0;
  }
  .quantity-input__btn {
    background: transparent;
    border: none;
    cursor: pointer;
    padding: 0.75rem 1rem;
    font-size: 1.1rem;
    color: inherit;
  }
  .quantity-input__field {
    width: 45px;
    border: none;
    text-align: center;
    font-size: 1rem;
    font-weight: 600;
    background: transparent;
    color: inherit;
    -moz-appearance: textfield;
  }
  .quantity-input__field::-webkit-inner-spin-button,
  .quantity-input__field::-webkit-outer-spin-button {
    -webkit-appearance: none;
  }
  .product-form__dynamic-checkout {
    margin-top: 0.75rem;
  }
  .product-accordion {
    border-top: 1px solid var(--color-border);
    padding: 1rem 0;
  }
  .product-accordion:last-child {
    border-bottom: 1px solid var(--color-border);
  }
  .product-accordion__summary {
    display: flex;
    align-items: center;
    justify-content: space-between;
    cursor: pointer;
    font-weight: 600;
    font-size: 1rem;
  }
  .product-accordion__content {
    padding-top: 0.75rem;
    font-size: 0.95rem;
    line-height: 1.6;
  }
</style>

<script>
  class VariantSelects extends HTMLElement {
    constructor() {
      super();
      this.addEventListener('change', this.onVariantChange.bind(this));
      this.variants = JSON.parse(this.querySelector('[type="application/json"]').textContent);
    }

    onVariantChange() {
      this.updateOptions();
      this.updateMasterId();
      this.updateMedia();
      this.updatePrice();
      this.updateURL();
    }

    updateOptions() {
      this.options = Array.from(this.querySelectorAll('input:checked'), el => el.value);
    }

    updateMasterId() {
      this.currentVariant = this.variants.find(variant => {
        return !variant.options.map((option, index) => {
          return this.options[index] === option;
        }).includes(false);
      });

      const input = document.getElementById('ProductVariantId-' + this.dataset.section);
      const btn = document.getElementById('AddToCart-' + this.dataset.section);
      const submitText = btn ? btn.querySelector('.submit-text') : null;

      if (!this.currentVariant) {
        if (btn) btn.disabled = true;
        if (submitText) submitText.textContent = 'Unavailable';
      } else {
        if (input) input.value = this.currentVariant.id;
        if (btn) {
          btn.disabled = !this.currentVariant.available;
          if (submitText) {
            submitText.textContent = this.currentVariant.available ? 'Add to cart' : 'Sold out';
          }
        }
      }
    }

    updateMedia() {
      if (!this.currentVariant || !this.currentVariant.featured_media) return;
      const mediaId = this.currentVariant.featured_media.id;
      const thumb = document.querySelector(`.product-gallery__thumbnail[data-media-id="${mediaId}"]`);
      if (thumb) thumb.click();
    }

    updatePrice() {
      if (!this.currentVariant) return;
      const priceWrap = document.getElementById('Price-' + this.dataset.section);
      if (!priceWrap) return;
      const currentPriceEl = priceWrap.querySelector('.product-price__current');
      if (currentPriceEl) {
        currentPriceEl.textContent = `$${(this.currentVariant.price / 100).toFixed(2)}`;
      }
    }

    updateURL() {
      if (!this.currentVariant || this.dataset.updateUrl === 'false') return;
      window.history.replaceState({}, '', `${this.dataset.url}?variant=${this.currentVariant.id}`);
    }
  }

  customElements.define('variant-selects', VariantSelects);

  // Gallery Thumbnail Click Switcher
  document.addEventListener('DOMContentLoaded', () => {
    document.querySelectorAll('.product-gallery__thumbnail').forEach(btn => {
      btn.addEventListener('click', () => {
        const parent = btn.closest('.product-gallery');
        if (!parent) return;
        parent.querySelectorAll('.product-gallery__thumbnail').forEach(t => t.classList.remove('is-active'));
        btn.classList.add('is-active');

        const targetSrc = btn.getAttribute('data-target-src');
        const mainImg = parent.querySelector('.product-gallery__featured img');
        if (mainImg && targetSrc) {
          mainImg.src = targetSrc;
        }
      });
    });

    // Quantity buttons stepper
    document.querySelectorAll('.quantity-input').forEach(wrap => {
      const field = wrap.querySelector('.quantity-input__field');
      const minus = wrap.querySelector('.qty-minus');
      const plus = wrap.querySelector('.qty-plus');

      if (minus && field) {
        minus.addEventListener('click', () => {
          const val = Math.max(1, (parseInt(field.value, 10) || 1) - 1);
          field.value = val;
        });
      }
      if (plus && field) {
        plus.addEventListener('click', () => {
          const val = (parseInt(field.value, 10) || 1) + 1;
          field.value = val;
        });
      }
    });
  });
</script>

{% schema %}
{
  "name": "Product information",
  "settings": [
    {
      "type": "select",
      "id": "color_scheme",
      "label": "Color scheme",
      "options": [
        { "value": "scheme-1", "label": "Scheme 1" },
        { "value": "scheme-2", "label": "Scheme 2" },
        { "value": "scheme-3", "label": "Scheme 3" },
        { "value": "scheme-4", "label": "Scheme 4" }
      ],
      "default": "scheme-1"
    },
    {
      "type": "checkbox",
      "id": "enable_video_looping",
      "label": "Enable video looping",
      "default": false
    }
  ],
  "blocks": [
    { "type": "@app" },
    {
      "type": "text",
      "name": "Text",
      "settings": [
        {
          "type": "text",
          "id": "text",
          "label": "Text",
          "default": "Premium Formulation"
        },
        {
          "type": "select",
          "id": "text_style",
          "label": "Text style",
          "options": [
            { "value": "text-subheading", "label": "Subheading" },
            { "value": "text-body", "label": "Body" }
          ],
          "default": "text-subheading"
        }
      ]
    },
    {
      "type": "title",
      "name": "Title",
      "limit": 1
    },
    {
      "type": "price",
      "name": "Price",
      "limit": 1
    },
    {
      "type": "installments",
      "name": "Shop Pay installments",
      "limit": 1
    },
    {
      "type": "variant_picker",
      "name": "Variant picker",
      "limit": 1,
      "settings": [
        {
          "type": "select",
          "id": "picker_type",
          "label": "Variant style",
          "options": [
            { "value": "pills", "label": "Pills" },
            { "value": "swatch", "label": "Color swatches" }
          ],
          "default": "swatch"
        }
      ]
    },
    {
      "type": "buy_buttons",
      "name": "Buy buttons",
      "limit": 1,
      "settings": [
        {
          "type": "checkbox",
          "id": "show_dynamic_checkout",
          "label": "Show accelerated checkout buttons",
          "default": true
        }
      ]
    },
    {
      "type": "pickup_availability",
      "name": "Pickup availability",
      "limit": 1
    },
    {
      "type": "description",
      "name": "Description",
      "limit": 1
    },
    {
      "type": "collapsible_tab",
      "name": "Collapsible row",
      "settings": [
        {
          "type": "text",
          "id": "heading",
          "label": "Heading",
          "default": "Shipping & returns"
        },
        {
          "type": "richtext",
          "id": "content",
          "label": "Tab content",
          "default": "<p>Free standard shipping on all orders over $100. Returns accepted within 30 days of receipt.</p>"
        },
        {
          "type": "page",
          "id": "page",
          "label": "Tab content from page"
        }
      ]
    },
    {
      "type": "custom_liquid",
      "name": "Custom Liquid",
      "settings": [
        {
          "type": "liquid",
          "id": "custom_liquid",
          "label": "Custom Liquid code"
        }
      ]
    }
  ],
  "default": {
    "blocks": [
      { "type": "text" },
      { "type": "title" },
      { "type": "price" },
      { "type": "installments" },
      { "type": "variant_picker" },
      { "type": "buy_buttons" },
      { "type": "pickup_availability" },
      { "type": "description" },
      { "type": "collapsible_tab" }
    ]
  }
}
{% endschema %}
