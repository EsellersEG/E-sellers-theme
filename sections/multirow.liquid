{%- comment -%}
  Multirow Section - E-sellers Professional (v4.9.0)
{%- endcomment -%}

{%- style -%}
  #shopify-section-{{ section.id }} {
    background-color: {{ section.settings.bg_color }};
    color: {{ section.settings.text_color }};
    --section-heading-color: {{ section.settings.heading_color }};
    --section-btn-bg: {{ section.settings.btn_bg_color }};
    --section-btn-text: {{ section.settings.btn_text_color }};
    padding-top: {{ section.settings.padding_top }}px;
    padding-bottom: {{ section.settings.padding_bottom }}px;
  }

  .multirow__header {
    text-align: center;
    margin-bottom: 48px;
  }

  .multirow__section-heading {
    font-size: clamp(1.5rem, 3vw, 2.25rem);
    font-weight: 700;
    color: var(--section-heading-color);
    margin: 0;
  }

  .multirow__rows {
    display: flex;
    flex-direction: column;
    gap: {{ section.settings.row_gap }}px;
  }

  .multirow__row {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: {{ section.settings.gap }}px;
    align-items: center;
  }

  @media screen and (max-width: 749px) {
    .multirow__row {
      grid-template-columns: 1fr;
    }
  }

  .multirow__row:nth-child(even) .multirow__media {
    order: 2;
  }

  .multirow__row:nth-child(even) .multirow__content {
    order: 1;
  }

  @media screen and (max-width: 749px) {
    .multirow__row:nth-child(even) .multirow__media,
    .multirow__row:nth-child(even) .multirow__content {
      order: unset;
    }
  }

  .multirow__media {
    border-radius: {{ section.settings.image_radius }}px;
    overflow: hidden;
  }

  .multirow__media img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
  }

  .multirow__content {
    display: flex;
    flex-direction: column;
    gap: 16px;
  }

  .multirow__subheading {
    font-size: 0.85rem;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    font-weight: 600;
    opacity: 0.7;
  }

  .multirow__heading {
    font-size: clamp(1.25rem, 2.5vw, 1.75rem);
    font-weight: 700;
    color: var(--section-heading-color);
    margin: 0;
  }

  .multirow__text p {
    margin: 0;
    line-height: 1.7;
  }

  .multirow__button {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    padding: 12px 28px;
    background: var(--section-btn-bg);
    color: var(--section-btn-text);
    border: none;
    border-radius: 8px;
    font-size: 0.95rem;
    font-weight: 600;
    text-decoration: none;
    transition: opacity 0.2s ease;
    align-self: flex-start;
  }

  .multirow__button:hover {
    opacity: 0.85;
  }
{%- endstyle -%}

<div class="page-width">
  {%- if section.settings.heading != blank -%}
    <div class="multirow__header">
      <h2 class="multirow__section-heading">{{ section.settings.heading }}</h2>
    </div>
  {%- endif -%}

  <div class="multirow__rows">
    {%- for block in section.blocks -%}
      <div class="multirow__row" {{ block.shopify_attributes }}>
        <div class="multirow__media">
          {%- if block.settings.image != blank -%}
            <img
              src="{{ block.settings.image | image_url: width: 900 }}"
              alt="{{ block.settings.image.alt | escape }}"
              loading="lazy"
              width="{{ block.settings.image.width }}"
              height="{{ block.settings.image.height }}"
            >
          {%- else -%}
            {{ 'image' | placeholder_svg_tag: 'placeholder-svg' }}
          {%- endif -%}
        </div>

        <div class="multirow__content">
          {%- if block.settings.subheading != blank -%}
            <span class="multirow__subheading">{{ block.settings.subheading }}</span>
          {%- endif -%}
          {%- if block.settings.heading != blank -%}
            <h3 class="multirow__heading">{{ block.settings.heading }}</h3>
          {%- endif -%}
          {%- if block.settings.text != blank -%}
            <div class="multirow__text">{{ block.settings.text }}</div>
          {%- endif -%}
          {%- if block.settings.button_label != blank -%}
            <a href="{{ block.settings.button_link }}" class="multirow__button">
              {{ block.settings.button_label }}
            </a>
          {%- endif -%}
        </div>
      </div>
    {%- endfor -%}
  </div>
</div>

{% schema %}
{
  "name": "Multirow",
  "tag": "section",
  "class": "section--multirow",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Multirow"
    },
    {
      "type": "range",
      "id": "gap",
      "min": 16,
      "max": 80,
      "step": 4,
      "unit": "px",
      "label": "Column gap",
      "default": 48
    },
    {
      "type": "range",
      "id": "row_gap",
      "min": 24,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "Row gap",
      "default": 60
    },
    {
      "type": "range",
      "id": "image_radius",
      "min": 0,
      "max": 40,
      "step": 2,
      "unit": "px",
      "label": "Image corner radius",
      "default": 12
    },
    {
      "type": "header",
      "content": "Colors"
    },
    {
      "type": "color",
      "id": "bg_color",
      "label": "Background color",
      "default": "#ffffff"
    },
    {
      "type": "color",
      "id": "heading_color",
      "label": "Heading color",
      "default": "#121212"
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "Text color",
      "default": "#334155"
    },
    {
      "type": "color",
      "id": "btn_bg_color",
      "label": "Button background",
      "default": "#121212"
    },
    {
      "type": "color",
      "id": "btn_text_color",
      "label": "Button text",
      "default": "#ffffff"
    },
    {
      "type": "header",
      "content": "Spacing"
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 0,
      "max": 120,
      "step": 4,
      "unit": "px",
      "label": "Top padding",
      "default": 60
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 0,
      "max": 120,
      "step": 4,
      "unit": "px",
      "label": "Bottom padding",
      "default": 60
    }
  ],
  "blocks": [
    {
      "type": "row",
      "name": "Row",
      "settings": [
        {
          "type": "image_picker",
          "id": "image",
          "label": "Image"
        },
        {
          "type": "text",
          "id": "subheading",
          "label": "Subheading"
        },
        {
          "type": "text",
          "id": "heading",
          "label": "Heading",
          "default": "Row heading"
        },
        {
          "type": "richtext",
          "id": "text",
          "label": "Text",
          "default": "<p>Pair text with an image to tell a story.</p>"
        },
        {
          "type": "text",
          "id": "button_label",
          "label": "Button label"
        },
        {
          "type": "url",
          "id": "button_link",
          "label": "Button link"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Multirow",
      "blocks": [
        { "type": "row" },
        { "type": "row" },
        { "type": "row" }
      ]
    }
  ]
}
{% endschema %}
