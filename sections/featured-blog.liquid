{%- comment -%}
  Featured Blog Section - E-sellers Professional (v4.9.0)
{%- endcomment -%}

{%- style -%}
  #shopify-section-{{ section.id }} {
    padding-top: {{ section.settings.padding_top }}px;
    padding-bottom: {{ section.settings.padding_bottom }}px;
    background-color: {{ section.settings.bg_color }};
  }

  .featured-blog__header {
    display: flex;
    justify-content: space-between;
    align-items: flex-end;
    margin-bottom: 40px;
  }

  @media screen and (max-width: 749px) {
    .featured-blog__header {
      flex-direction: column;
      align-items: flex-start;
      gap: 16px;
    }
  }

  .featured-blog__heading {
    font-size: clamp(1.5rem, 3vw, 2.25rem);
    font-weight: 700;
    color: {{ section.settings.heading_color }};
    margin: 0;
  }

  .featured-blog__view-all {
    display: inline-block;
    font-size: 0.95rem;
    font-weight: 600;
    color: {{ section.settings.heading_color }};
    text-decoration: none;
    border-bottom: 2px solid {{ section.settings.heading_color }};
    padding-bottom: 4px;
    transition: opacity 0.2s ease;
  }

  .featured-blog__view-all:hover {
    opacity: 0.7;
  }

  .featured-blog__grid {
    display: grid;
    grid-template-columns: repeat({{ section.settings.columns_desktop }}, 1fr);
    gap: 32px;
  }

  @media screen and (max-width: 749px) {
    .featured-blog__grid {
      grid-template-columns: 1fr;
    }
  }

  .featured-blog__article {
    display: flex;
    flex-direction: column;
    gap: 16px;
  }

  .featured-blog__media {
    position: relative;
    border-radius: {{ section.settings.card_radius }}px;
    overflow: hidden;
    aspect-ratio: 3 / 2;
    background: #f8fafc;
  }

  .featured-blog__media img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 0.4s ease;
  }

  .featured-blog__article:hover .featured-blog__media img {
    transform: scale(1.03);
  }

  .featured-blog__info {
    display: flex;
    flex-direction: column;
    gap: 12px;
  }

  .featured-blog__meta {
    font-size: 0.85rem;
    color: {{ section.settings.text_color }};
    opacity: 0.8;
  }

  .featured-blog__title {
    font-size: 1.25rem;
    font-weight: 700;
    color: {{ section.settings.heading_color }};
    margin: 0;
    line-height: 1.3;
  }

  .featured-blog__title a {
    text-decoration: none;
    color: inherit;
  }

  .featured-blog__excerpt {
    color: {{ section.settings.text_color }};
    font-size: 0.95rem;
    line-height: 1.6;
    margin: 0;
  }
{%- endstyle -%}

<div class="page-width">
  <div class="featured-blog">
    <div class="featured-blog__header">
      <h2 class="featured-blog__heading">{{ section.settings.heading }}</h2>
      
      {%- if section.settings.blog != blank and section.settings.show_view_all -%}
        <a href="{{ section.settings.blog.url }}" class="featured-blog__view-all">
          View all articles
        </a>
      {%- endif -%}
    </div>

    <div class="featured-blog__grid">
      {%- if section.settings.blog != blank and section.settings.blog.articles_count > 0 -%}
        {%- for article in section.settings.blog.articles limit: section.settings.post_limit -%}
          <div class="featured-blog__article">
            <a href="{{ article.url }}" class="featured-blog__media">
              {%- if article.image != blank -%}
                <img
                  src="{{ article.image | image_url: width: 800 }}"
                  alt="{{ article.image.alt | escape }}"
                  loading="lazy"
                  width="{{ article.image.width }}"
                  height="{{ article.image.height }}"
                >
              {%- else -%}
                {{ 'image' | placeholder_svg_tag: 'placeholder-svg' }}
              {%- endif -%}
            </a>
            
            <div class="featured-blog__info">
              {%- if section.settings.show_date or section.settings.show_author -%}
                <div class="featured-blog__meta">
                  {%- if section.settings.show_date -%}
                    {{ article.published_at | time_tag: format: 'date' }}
                  {%- endif -%}
                  {%- if section.settings.show_date and section.settings.show_author -%}
                    &nbsp; &middot; &nbsp;
                  {%- endif -%}
                  {%- if section.settings.show_author -%}
                    {{ article.author }}
                  {%- endif -%}
                </div>
              {%- endif -%}

              <h3 class="featured-blog__title">
                <a href="{{ article.url }}">{{ article.title }}</a>
              </h3>

              {%- if section.settings.show_excerpt -%}
                <p class="featured-blog__excerpt">
                  {%- if article.excerpt.size > 0 -%}
                    {{ article.excerpt | strip_html | truncatewords: 25 }}
                  {%- else -%}
                    {{ article.content | strip_html | truncatewords: 25 }}
                  {%- endif -%}
                </p>
              {%- endif -%}
            </div>
          </div>
        {%- endfor -%}
      {%- else -%}
        {%- for i in (1..section.settings.post_limit) -%}
          <div class="featured-blog__article">
            <div class="featured-blog__media">
              {{ 'image' | placeholder_svg_tag: 'placeholder-svg' }}
            </div>
            <div class="featured-blog__info">
              <div class="featured-blog__meta">May 24, 2024 &middot; E-sellers</div>
              <h3 class="featured-blog__title">Example Blog Post Title</h3>
              <p class="featured-blog__excerpt">This is an example excerpt to show how your blog posts will look on the storefront. Add a blog and publish articles to replace this placeholder.</p>
            </div>
          </div>
        {%- endfor -%}
      {%- endif -%}
    </div>
  </div>
</div>

{% schema %}
{
  "name": "Featured blog",
  "tag": "section",
  "class": "section--featured-blog",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Latest Journal"
    },
    {
      "type": "blog",
      "id": "blog",
      "label": "Blog"
    },
    {
      "type": "range",
      "id": "post_limit",
      "min": 2,
      "max": 4,
      "step": 1,
      "label": "Number of blog posts to show",
      "default": 3
    },
    {
      "type": "range",
      "id": "columns_desktop",
      "min": 2,
      "max": 4,
      "step": 1,
      "label": "Number of columns on desktop",
      "default": 3
    },
    {
      "type": "checkbox",
      "id": "show_view_all",
      "label": "Show 'View all' button",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "show_date",
      "label": "Show date",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "show_author",
      "label": "Show author",
      "default": false
    },
    {
      "type": "checkbox",
      "id": "show_excerpt",
      "label": "Show excerpt",
      "default": true
    },
    {
      "type": "range",
      "id": "card_radius",
      "min": 0,
      "max": 24,
      "step": 2,
      "unit": "px",
      "label": "Card image radius",
      "default": 12
    },
    {
      "type": "header",
      "content": "Colors"
    },
    {
      "type": "color",
      "id": "bg_color",
      "label": "Background color",
      "default": "#ffffff"
    },
    {
      "type": "color",
      "id": "heading_color",
      "label": "Heading color",
      "default": "#121212"
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "Text color",
      "default": "#334155"
    },
    {
      "type": "header",
      "content": "Spacing"
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 0,
      "max": 120,
      "step": 4,
      "unit": "px",
      "label": "Top padding",
      "default": 60
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 0,
      "max": 120,
      "step": 4,
      "unit": "px",
      "label": "Bottom padding",
      "default": 60
    }
  ],
  "presets": [
    {
      "name": "Featured blog"
    }
  ]
}
{% endschema %}
