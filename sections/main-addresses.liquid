{%- comment -%}
  Main Addresses Section - E-sellers Professional (v4.9.0)
{%- endcomment -%}

{%- style -%}
  #shopify-section-{{ section.id }} {
    background-color: {{ section.settings.bg_color }};
    color: {{ section.settings.text_color }};
    --section-heading-color: {{ section.settings.heading_color }};
    --section-btn-bg: {{ section.settings.btn_bg_color }};
    --section-btn-text: {{ section.settings.btn_text_color }};
    padding-top: {{ section.settings.padding_top }}px;
    padding-bottom: {{ section.settings.padding_bottom }}px;
  }

  .addresses-wrapper {
    max-width: 800px;
    margin: 0 auto;
  }

  .address-card {
    background: #f8fafc;
    border: 1px solid #e2e8f0;
    border-radius: var(--card-radius, 12px);
    padding: 24px;
    margin-bottom: 20px;
  }
{%- endstyle -%}

<div class="page-width">
  <div class="addresses-wrapper">
    <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 32px;">
      <h1 class="h2" style="margin: 0;">{{ 'customer.addresses.title' | t }}</h1>
      <a href="{{ routes.account_url }}" class="link" style="font-size: 1.4rem; font-weight: 600;">
        &larr; {{ 'customer.account.return' | t }}
      </a>
    </div>

    <!-- Existing Addresses List -->
    {%- for address in customer.addresses -%}
      <div class="address-card">
        {%- if address == customer.default_address -%}
          <span class="badge badge--custom" style="background: #121212; color: #ffffff; margin-bottom: 12px;">
            {{ 'customer.addresses.default' | t }}
          </span>
        {%- endif -%}

        <div style="font-size: 1.5rem; line-height: 1.6; color: #334155;">
          {{ address | format_address }}
        </div>

        <form
          method="post"
          action="{{ routes.account_addresses_url }}/{{ address.id }}"
          onsubmit="return confirm('{{ 'customer.addresses.delete_confirm' | t }}');"
          style="margin-top: 16px;"
        >
          <input type="hidden" name="_method" value="delete">
          <button type="submit" class="button button--secondary" style="padding: 8px 16px; font-size: 1.3rem; color: #dc2626; border-color: #dc2626;">
            {{ 'customer.addresses.delete' | t }}
          </button>
        </form>
      </div>
    {%- endfor -%}
  </div>
</div>

{% schema %}
{
  "name": "Customer Addresses",
  "settings": [
    {
      "type": "header",
      "content": "Section Colors (Independent)"
    },
    {
      "type": "color",
      "id": "bg_color",
      "label": "Background color",
      "default": "#ffffff"
    },
    {
      "type": "color",
      "id": "heading_color",
      "label": "Heading color",
      "default": "#121212"
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "Text color",
      "default": "#121212"
    },
    {
      "type": "color",
      "id": "btn_bg_color",
      "label": "Button background",
      "default": "#121212"
    },
    {
      "type": "color",
      "id": "btn_text_color",
      "label": "Button text color",
      "default": "#ffffff"
    },
    {
      "type": "header",
      "content": "Section Spacing"
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 20,
      "max": 100,
      "step": 5,
      "unit": "px",
      "label": "Top padding",
      "default": 40
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 20,
      "max": 100,
      "step": 5,
      "unit": "px",
      "label": "Bottom padding",
      "default": 60
    }
  ]
}
{% endschema %}
