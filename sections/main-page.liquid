<section class="section-main-page color-{{ section.settings.color_scheme }}" id="MainPage-{{ section.id }}" data-section-id="{{ section.id }}">
  <div class="page-width page-width--narrow section-spacing">
    <h1 class="page-title text-center" style="margin-bottom: 2rem;">{{ page.title | escape }}</h1>
    <div class="page-content rte">
      {{ page.content }}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Page content",
  "settings": [
    {
      "type": "select",
      "id": "color_scheme",
      "label": "Color scheme",
      "options": [
        { "value": "scheme-1", "label": "Scheme 1" },
        { "value": "scheme-2", "label": "Scheme 2" },
        { "value": "scheme-3", "label": "Scheme 3" },
        { "value": "scheme-4", "label": "Scheme 4" }
      ],
      "default": "scheme-1"
    }
  ]
}
{% endschema %}
