{%- comment -%}
  Main Page Section - E-sellers Professional (v4.9.0)
{%- endcomment -%}

{%- style -%}
  #shopify-section-{{ section.id }} {
    background-color: {{ section.settings.bg_color }};
    color: {{ section.settings.text_color }};
    --section-heading-color: {{ section.settings.heading_color }};
    padding-top: {{ section.settings.padding_top }}px;
    padding-bottom: {{ section.settings.padding_bottom }}px;
  }

  .main-page {
    max-width: {{ section.settings.max_width }}px;
    margin: 0 auto;
  }

  .main-page__header {
    text-align: {{ section.settings.alignment }};
    margin-bottom: 32px;
  }

  .main-page__content {
    font-size: 1.6rem;
    line-height: 1.8;
  }
{%- endstyle -%}

<div class="page-width">
  <article class="main-page">
    <div class="main-page__header">
      <h1 class="h1">{{ page.title | escape }}</h1>
    </div>
    <div class="main-page__content">
      {{ page.content }}
    </div>
  </article>
</div>

{% schema %}
{
  "name": "Page Content",
  "settings": [
    {
      "type": "select",
      "id": "alignment",
      "options": [
        { "value": "left", "label": "Left" },
        { "value": "center", "label": "Center" }
      ],
      "default": "center",
      "label": "Title alignment"
    },
    {
      "type": "range",
      "id": "max_width",
      "min": 600,
      "max": 1000,
      "step": 50,
      "unit": "px",
      "label": "Content max width",
      "default": 800
    },
    {
      "type": "header",
      "content": "Section Colors (Independent)"
    },
    {
      "type": "color",
      "id": "bg_color",
      "label": "Background color",
      "default": "#ffffff"
    },
    {
      "type": "color",
      "id": "heading_color",
      "label": "Heading color",
      "default": "#121212"
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "Text color",
      "default": "#121212"
    },
    {
      "type": "header",
      "content": "Section Spacing"
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 20,
      "max": 100,
      "step": 5,
      "unit": "px",
      "label": "Top padding",
      "default": 40
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 20,
      "max": 100,
      "step": 5,
      "unit": "px",
      "label": "Bottom padding",
      "default": 60
    }
  ]
}
{% endschema %}
