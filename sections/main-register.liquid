{%- comment -%}
  Main Register Section - E-sellers Professional (v4.9.0)
{%- endcomment -%}

{%- style -%}
  #shopify-section-{{ section.id }} {
    background-color: {{ section.settings.bg_color }};
    color: {{ section.settings.text_color }};
    --section-heading-color: {{ section.settings.heading_color }};
    --section-btn-bg: {{ section.settings.btn_bg_color }};
    --section-btn-text: {{ section.settings.btn_text_color }};
    padding-top: {{ section.settings.padding_top }}px;
    padding-bottom: {{ section.settings.padding_bottom }}px;
  }

  .customer-register {
    max-width: 480px;
    margin: 0 auto;
    text-align: center;
  }
{%- endstyle -%}

<div class="page-width">
  <div class="customer-register">
    <h1 class="h2">{{ 'customer.register.title' | t }}</h1>

    {%- form 'create_customer', class: 'customer-register-form' -%}
      {%- if form.errors -%}
        <div style="padding: 12px; background-color: #fef2f2; color: #dc2626; border-radius: 8px; margin-bottom: 16px; text-align: left;">
          {{ form.errors | default_errors }}
        </div>
      {%- endif -%}

      <div class="field">
        <input
          type="text"
          name="customer[first_name]"
          id="Register-FirstName"
          class="field__input"
          {% if form.first_name %}value="{{ form.first_name }}"{% endif %}
          autocomplete="given-name"
          placeholder="{{ 'customer.register.first_name' | t }}"
          required
        >
      </div>

      <div class="field">
        <input
          type="text"
          name="customer[last_name]"
          id="Register-LastName"
          class="field__input"
          {% if form.last_name %}value="{{ form.last_name }}"{% endif %}
          autocomplete="family-name"
          placeholder="{{ 'customer.register.last_name' | t }}"
          required
        >
      </div>

      <div class="field">
        <input
          type="email"
          name="customer[email]"
          id="Register-Email"
          class="field__input"
          {% if form.email %}value="{{ form.email }}"{% endif %}
          spellcheck="false"
          autocapitalize="off"
          autocomplete="email"
          placeholder="{{ 'customer.register.email' | t }}"
          required
        >
      </div>

      <div class="field">
        <input
          type="password"
          name="customer[password]"
          id="Register-Password"
          class="field__input"
          autocomplete="new-password"
          placeholder="{{ 'customer.register.password' | t }}"
          required
        >
      </div>

      <button type="submit" class="button button--primary button--full-width" style="margin-top: 12px;">
        {{ 'customer.register.submit' | t }}
      </button>

      <div style="margin-top: 24px; font-size: 1.4rem;">
        <span>Already have an account?</span>
        <a href="{{ routes.account_login_url }}" class="link" style="font-weight: 700; margin-left: 4px;">
          {{ 'customer.login_page.sign_in' | t }}
        </a>
      </div>
    {%- endform -%}
  </div>
</div>

{% schema %}
{
  "name": "Customer Register",
  "settings": [
    {
      "type": "header",
      "content": "Section Colors (Independent)"
    },
    {
      "type": "color",
      "id": "bg_color",
      "label": "Background color",
      "default": "#ffffff"
    },
    {
      "type": "color",
      "id": "heading_color",
      "label": "Heading color",
      "default": "#121212"
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "Text color",
      "default": "#121212"
    },
    {
      "type": "color",
      "id": "btn_bg_color",
      "label": "Button background",
      "default": "#121212"
    },
    {
      "type": "color",
      "id": "btn_text_color",
      "label": "Button text color",
      "default": "#ffffff"
    },
    {
      "type": "header",
      "content": "Section Spacing"
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 20,
      "max": 100,
      "step": 5,
      "unit": "px",
      "label": "Top padding",
      "default": 60
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 20,
      "max": 100,
      "step": 5,
      "unit": "px",
      "label": "Bottom padding",
      "default": 80
    }
  ]
}
{% endschema %}
