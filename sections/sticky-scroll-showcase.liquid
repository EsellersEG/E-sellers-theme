<section
  class="section-sticky-showcase color-{{ section.settings.color_scheme }}"
  id="StickyShowcase-{{ section.id }}"
  data-section-id="{{ section.id }}"
>
  <div class="page-width section-spacing">
    <div class="sticky-showcase-layout">
      {% # Left Sticky Media Column %}
      <div class="sticky-showcase__media-col">
        <div class="sticky-showcase__media-box" id="StickyBox-{{ section.id }}">
          {%- if section.settings.image != blank -%}
            <img
              src="{{ section.settings.image | image_url: width: 1200 }}"
              alt="{{ section.settings.image.alt | default: section.settings.title | escape }}"
              width="600"
              height="600"
              loading="lazy"
              class="sticky-showcase__image"
              id="StickyImg-{{ section.id }}"
            >
          {%- else -%}
            <div class="sticky-showcase__placeholder" id="StickyImg-{{ section.id }}">
              {{ 'product-1' | placeholder_svg_tag: 'placeholder-svg' }}
            </div>
          {%- endif -%}
        </div>
      </div>

      {% # Right Scrolling Feature Cards Column %}
      <div class="sticky-showcase__content-col">
        <div class="sticky-showcase__header">
          {%- if section.settings.subheading != blank -%}
            <span class="text-subheading">{{ section.settings.subheading | escape }}</span>
          {%- endif -%}
          <h2 class="h2" style="margin-bottom: 2.5rem;">{{ section.settings.title | default: 'Meticulously Engineered' | escape }}</h2>
        </div>

        <div class="sticky-showcase__cards">
          {%- for block in section.blocks -%}
            <div
              class="sticky-feature-card color-scheme-2"
              id="StickyCard-{{ section.id }}-{{ forloop.index0 }}"
              data-index="{{ forloop.index0 }}"
              {{ block.shopify_attributes }}
            >
              <div class="sticky-feature-card__badge">0{{ forloop.index }}</div>
              <h3 class="h3" style="margin-bottom: 0.75rem;">{{ block.settings.title | escape }}</h3>
              <div class="sticky-feature-card__text rte text-muted">
                {{ block.settings.text }}
              </div>
            </div>
          {%- endfor -%}
        </div>
      </div>
    </div>
  </div>
</section>

<style>
  .sticky-showcase-layout {
    display: grid;
    grid-template-columns: 1fr;
    gap: 3rem;
  }
  @media (min-width: 990px) {
    .sticky-showcase-layout {
      grid-template-columns: 1fr 1.15fr;
      gap: 5rem;
      align-items: start;
    }
  }
  .sticky-showcase__media-col {
    position: sticky;
    top: 6rem;
    height: fit-content;
    display: flex;
    justify-content: center;
  }
  .sticky-showcase__media-box {
    position: relative;
    width: 100%;
    max-width: 480px;
    aspect-ratio: 1 / 1;
    display: flex;
    align-items: center;
    justify-content: center;
    border-radius: var(--radius-card);
    background: radial-gradient(circle, rgba(255, 255, 255, 0.1) 0%, rgba(0, 0, 0, 0.04) 70%);
  }
  .sticky-showcase__image {
    width: 85%;
    height: 85%;
    object-fit: contain;
    transition: transform 0.1s ease-out;
    filter: drop-shadow(0 20px 30px rgba(0, 0, 0, 0.15));
  }
  .sticky-showcase__placeholder {
    width: 80%;
    height: 80%;
    transition: transform 0.1s ease-out;
  }
  .sticky-showcase__placeholder svg {
    width: 100%;
    height: 100%;
    opacity: 0.4;
  }
  .sticky-showcase__cards {
    display: flex;
    flex-direction: column;
    gap: 3.5rem;
  }
  .sticky-feature-card {
    padding: 3rem 2.5rem;
    border-radius: var(--radius-card);
    border: 1px solid var(--color-border);
    box-shadow: var(--shadow-md);
    transition: transform var(--duration-normal), border-color var(--duration-normal);
  }
  .sticky-feature-card:hover {
    transform: translateY(-4px);
    border-color: var(--color-accent);
  }
  .sticky-feature-card__badge {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    padding: 0.35rem 0.85rem;
    border-radius: var(--radius-badge);
    background-color: var(--color-accent);
    color: #FFFFFF;
    font-weight: 700;
    font-size: 0.85rem;
    margin-bottom: 1.25rem;
  }
  .sticky-feature-card__text {
    font-size: 1.05rem;
    line-height: 1.65;
  }
</style>

<script>
  (function() {
    const wrap = document.getElementById('StickyShowcase-{{ section.id }}');
    if (!wrap) return;

    const stickyImg = document.getElementById('StickyImg-{{ section.id }}');

    function onScroll() {
      const rect = wrap.getBoundingClientRect();
      const windowHeight = window.innerHeight;

      if (rect.top <= windowHeight && rect.bottom >= 0) {
        const progress = (windowHeight - rect.top) / (windowHeight + rect.height);
        const rotation = (progress - 0.5) * 35; // Rotate between -17.5deg and +17.5deg
        if (stickyImg) {
          stickyImg.style.transform = `rotate(${rotation}deg) scale(${1 + Math.sin(progress * Math.PI) * 0.08})`;
        }
      }
    }

    window.addEventListener('scroll', onScroll, { passive: true });
    onScroll();
  })();
</script>

{% schema %}
{
  "name": "Sticky scroll showcase",
  "settings": [
    {
      "type": "select",
      "id": "color_scheme",
      "label": "Color scheme",
      "options": [
        { "value": "scheme-1", "label": "Scheme 1" },
        { "value": "scheme-2", "label": "Scheme 2" },
        { "value": "scheme-3", "label": "Scheme 3" },
        { "value": "scheme-4", "label": "Scheme 4" }
      ],
      "default": "scheme-1"
    },
    {
      "type": "text",
      "id": "subheading",
      "label": "Subheading",
      "default": "Advanced Precision"
    },
    {
      "type": "text",
      "id": "title",
      "label": "Heading",
      "default": "Designed for Uncompromising Efficacy"
    },
    {
      "type": "image_picker",
      "id": "image",
      "label": "Showcase product image"
    }
  ],
  "blocks": [
    {
      "type": "feature",
      "name": "Feature milestone",
      "settings": [
        {
          "type": "text",
          "id": "title",
          "label": "Feature title",
          "default": "Tri-Phase Conditioning Matrix"
        },
        {
          "type": "richtext",
          "id": "text",
          "label": "Feature explanation",
          "default": "<p>A breakthrough layered formula that targets the cortex, cuticle, and outer lipid barrier simultaneously.</p>"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Sticky scroll showcase",
      "blocks": [
        { "type": "feature", "settings": { "title": "Precision Molecular Weight" } },
        { "type": "feature", "settings": { "title": "Zero Heavy Build-Up" } },
        { "type": "feature", "settings": { "title": "Continuous 48-Hour Hydration" } }
      ]
    }
  ]
}
{% endschema %}
