<section
  class="section-testimonials color-{{ section.settings.color_scheme }}"
  id="Testimonials-{{ section.id }}"
  data-section-id="{{ section.id }}"
>
  <div class="page-width section-spacing">
    <div class="section-header text-center" style="margin-bottom: 3rem;">
      {%- if section.settings.subheading != blank -%}
        <span class="text-subheading">{{ section.settings.subheading | escape }}</span>
      {%- endif -%}
      <h2 class="h2" style="margin-bottom: 0.5rem;">{{ section.settings.title | default: 'What Our Customers Say' | escape }}</h2>
    </div>

    <div class="grid grid--{{ section.settings.columns_desktop }}-col grid--gap-md">
      {%- for block in section.blocks -%}
        <div class="grid__item" {{ block.shopify_attributes }}>
          <div class="testimonial-card color-scheme-2">
            {% # Star Rating %}
            <div class="testimonial-rating" aria-label="{{ block.settings.rating }} out of 5 stars">
              {%- for i in (1..block.settings.rating) -%}
                <svg width="18" height="18" viewBox="0 0 24 24" fill="#F59E0B" stroke="#F59E0B"><polygon points="12 2 15.09 8.26 22 9.27 17 14.14 18.18 21.02 12 17.77 5.82 21.02 7 14.14 2 9.27 8.91 8.26 12 2"></polygon></svg>
              {%- endfor -%}
            </div>

            {% # Quote %}
            <div class="testimonial-quote rte">
              {{ block.settings.quote }}
            </div>

            {% # Author Info %}
            <div class="testimonial-author-wrap">
              {%- if block.settings.avatar != blank -%}
                <img
                  src="{{ block.settings.avatar | image_url: width: 100, height: 100, crop: 'center' }}"
                  alt="{{ block.settings.author | escape }}"
                  width="48"
                  height="48"
                  loading="lazy"
                  class="testimonial-avatar"
                >
              {%- endif -%}
              <div>
                <div class="testimonial-author">
                  <span>{{ block.settings.author | escape }}</span>
                  {%- if block.settings.verified -%}
                    <span class="verified-badge" title="Verified Customer">
                      <svg width="14" height="14" viewBox="0 0 24 24" fill="#10B981" stroke="#FFFFFF" stroke-width="2"><circle cx="12" cy="12" r="10"></circle><polyline points="9 12 11 14 15 10"></polyline></svg>
                      <span>Verified</span>
                    </span>
                  {%- endif -%}
                </div>
                {%- if block.settings.author_sub != blank -%}
                  <div class="testimonial-sub text-muted">{{ block.settings.author_sub | escape }}</div>
                {%- endif -%}
              </div>
            </div>
          </div>
        </div>
      {%- endfor -%}
    </div>
  </div>
</section>

<style>
  .testimonial-card {
    padding: 2rem;
    border-radius: var(--radius-card);
    border: 1px solid var(--color-border);
    height: 100%;
    display: flex;
    flex-direction: column;
    box-shadow: var(--shadow-sm);
  }
  .testimonial-rating {
    display: flex;
    gap: 0.25rem;
    margin-bottom: 1rem;
  }
  .testimonial-quote {
    font-size: 1.05rem;
    line-height: 1.6;
    margin-bottom: 1.5rem;
    flex-grow: 1;
    font-style: italic;
  }
  .testimonial-author-wrap {
    display: flex;
    align-items: center;
    gap: 0.75rem;
  }
  .testimonial-avatar {
    width: 48px;
    height: 48px;
    border-radius: 50%;
    object-fit: cover;
  }
  .testimonial-author {
    font-weight: 700;
    font-size: 0.95rem;
    display: flex;
    align-items: center;
    gap: 0.35rem;
  }
  .verified-badge {
    display: inline-flex;
    align-items: center;
    gap: 0.2rem;
    font-size: 0.75rem;
    color: #10B981;
    font-weight: 600;
  }
  .testimonial-sub {
    font-size: 0.8rem;
  }
</style>

{% schema %}
{
  "name": "Testimonials",
  "settings": [
    {
      "type": "select",
      "id": "color_scheme",
      "label": "Color scheme",
      "options": [
        { "value": "scheme-1", "label": "Scheme 1" },
        { "value": "scheme-2", "label": "Scheme 2" },
        { "value": "scheme-3", "label": "Scheme 3" },
        { "value": "scheme-4", "label": "Scheme 4" }
      ],
      "default": "scheme-1"
    },
    {
      "type": "text",
      "id": "subheading",
      "label": "Subheading",
      "default": "Real Feedback"
    },
    {
      "type": "text",
      "id": "title",
      "label": "Heading",
      "default": "Loved by Thousands Worldwide"
    },
    {
      "type": "select",
      "id": "columns_desktop",
      "label": "Columns on desktop",
      "options": [
        { "value": "2", "label": "2 columns" },
        { "value": "3", "label": "3 columns" }
      ],
      "default": "3"
    }
  ],
  "blocks": [
    {
      "type": "testimonial",
      "name": "Testimonial",
      "settings": [
        {
          "type": "range",
          "id": "rating",
          "min": 1,
          "max": 5,
          "step": 1,
          "label": "Star rating",
          "default": 5
        },
        {
          "type": "richtext",
          "id": "quote",
          "label": "Customer quote",
          "default": "<p>\"This is honestly the best product I've ever used. My hair feels softer, healthier, and looks incredible after just one week!\"</p>"
        },
        {
          "type": "image_picker",
          "id": "avatar",
          "label": "Author avatar"
        },
        {
          "type": "text",
          "id": "author",
          "label": "Author name",
          "default": "Sarah Jenkins"
        },
        {
          "type": "text",
          "id": "author_sub",
          "label": "Author subtext",
          "default": "Verified Buyer &bull; New York"
        },
        {
          "type": "checkbox",
          "id": "verified",
          "label": "Show verified buyer badge",
          "default": true
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Testimonials",
      "blocks": [
        { "type": "testimonial", "settings": { "author": "Emily Thorne", "author_sub": "Verified Buyer" } },
        { "type": "testimonial", "settings": { "author": "Marcus Aurel", "author_sub": "Verified Buyer" } },
        { "type": "testimonial", "settings": { "author": "Jessica Alba", "author_sub": "Verified Buyer" } }
      ]
    }
  ]
}
{% endschema %}
