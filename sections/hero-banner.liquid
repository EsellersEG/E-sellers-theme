<section
  class="hero-banner color-{{ section.settings.color_scheme }} {% if section.settings.enable_full_width %}full-width{% endif %}"
  id="HeroBanner-{{ section.id }}"
  data-section-id="{{ section.id }}"
>
  <div class="hero-banner__media-wrap">
    {%- if section.settings.image != blank -%}
      <img
        src="{{ section.settings.image | image_url: width: 2400 }}"
        alt="{{ section.settings.image.alt | default: section.settings.heading | escape }}"
        width="{{ section.settings.image.width }}"
        height="{{ section.settings.image.height }}"
        loading="eager"
        class="hero-banner__image"
      >
    {%- else -%}
      <div class="hero-banner__placeholder">
        {{ 'lifestyle-1' | placeholder_svg_tag: 'placeholder-svg' }}
      </div>
    {%- endif -%}
    <div class="hero-banner__overlay" style="opacity: {{ section.settings.overlay_opacity | divided_by: 100.0 }};"></div>
  </div>

  <div class="page-width hero-banner__content-wrap hero-banner__content-wrap--{{ section.settings.text_alignment }} hero-banner__content-wrap--{{ section.settings.vertical_alignment }}">
    <div class="hero-banner__content" style="max-width: {{ section.settings.content_max_width }}px;">
      {%- if section.settings.subheading != blank -%}
        <span class="text-subheading hero-banner__subheading">{{ section.settings.subheading | escape }}</span>
      {%- endif -%}

      {%- if section.settings.heading != blank -%}
        <h1 class="hero-banner__heading">{{ section.settings.heading | escape }}</h1>
      {%- endif -%}

      {%- if section.settings.text != blank -%}
        <div class="hero-banner__text rte">{{ section.settings.text }}</div>
      {%- endif -%}

      {%- if section.settings.button_1_label != blank or section.settings.button_2_label != blank -%}
        <div class="hero-banner__buttons">
          {%- if section.settings.button_1_label != blank -%}
            <a href="{{ section.settings.button_1_link }}" class="button button--primary button--lg">
              {{ section.settings.button_1_label | escape }}
            </a>
          {%- endif -%}
          {%- if section.settings.button_2_label != blank -%}
            <a href="{{ section.settings.button_2_link }}" class="button button--secondary button--lg">
              {{ section.settings.button_2_label | escape }}
            </a>
          {%- endif -%}
        </div>
      {%- endif -%}
    </div>
  </div>
</section>

<style>
  .hero-banner {
    position: relative;
    min-height: clamp(400px, 70vh, 750px);
    display: flex;
    align-items: center;
    overflow: hidden;
  }
  .hero-banner__media-wrap {
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
  }
  .hero-banner__image {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }
  .hero-banner__placeholder {
    width: 100%;
    height: 100%;
    background-color: #374151;
  }
  .hero-banner__placeholder svg {
    width: 100%;
    height: 100%;
    object-fit: cover;
    opacity: 0.2;
  }
  .hero-banner__overlay {
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    background-color: #000000;
  }
  .hero-banner__content-wrap {
    position: relative;
    z-index: 2;
    width: 100%;
    display: flex;
    padding-top: 4rem;
    padding-bottom: 4rem;
  }
  .hero-banner__content-wrap--left { justify-content: flex-start; text-align: left; }
  .hero-banner__content-wrap--center { justify-content: center; text-align: center; }
  .hero-banner__content-wrap--right { justify-content: flex-end; text-align: right; }
  .hero-banner__content-wrap--top { align-items: flex-start; }
  .hero-banner__content-wrap--middle { align-items: center; }
  .hero-banner__content-wrap--bottom { align-items: flex-end; }

  .hero-banner__heading {
    font-size: clamp(2.25rem, 5vw, 4rem);
    font-weight: 800;
    line-height: 1.1;
    margin-bottom: 1.25rem;
    color: #FFFFFF;
  }
  .hero-banner__subheading {
    color: #818CF8;
    margin-bottom: 0.75rem;
  }
  .hero-banner__text {
    font-size: clamp(1rem, 2vw, 1.25rem);
    margin-bottom: 2rem;
    color: rgba(255, 255, 255, 0.9);
    line-height: 1.6;
  }
  .hero-banner__buttons {
    display: flex;
    flex-wrap: wrap;
    gap: 1rem;
  }
  .hero-banner__content-wrap--center .hero-banner__buttons {
    justify-content: center;
  }
</style>

{% schema %}
{
  "name": "Hero banner",
  "settings": [
    {
      "type": "select",
      "id": "color_scheme",
      "label": "Color scheme",
      "options": [
        { "value": "scheme-1", "label": "Scheme 1" },
        { "value": "scheme-2", "label": "Scheme 2" },
        { "value": "scheme-3", "label": "Scheme 3" },
        { "value": "scheme-4", "label": "Scheme 4" }
      ],
      "default": "scheme-4"
    },
    {
      "type": "image_picker",
      "id": "image",
      "label": "Background image"
    },
    {
      "type": "range",
      "id": "overlay_opacity",
      "min": 0,
      "max": 90,
      "step": 5,
      "unit": "%",
      "label": "Overlay opacity",
      "default": 35
    },
    {
      "type": "text",
      "id": "subheading",
      "label": "Subheading",
      "default": "Engineered for Performance"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Elevate Your Everyday Ritual"
    },
    {
      "type": "richtext",
      "id": "text",
      "label": "Text",
      "default": "<p>Discover scientifically proven formulations designed to transform and nourish.</p>"
    },
    {
      "type": "range",
      "id": "content_max_width",
      "min": 400,
      "max": 900,
      "step": 50,
      "unit": "px",
      "label": "Content max width",
      "default": 650
    },
    {
      "type": "select",
      "id": "text_alignment",
      "label": "Text alignment",
      "options": [
        { "value": "left", "label": "Left" },
        { "value": "center", "label": "Center" },
        { "value": "right", "label": "Right" }
      ],
      "default": "center"
    },
    {
      "type": "select",
      "id": "vertical_alignment",
      "label": "Vertical alignment",
      "options": [
        { "value": "top", "label": "Top" },
        { "value": "middle", "label": "Middle" },
        { "value": "bottom", "label": "Bottom" }
      ],
      "default": "middle"
    },
    {
      "type": "header",
      "content": "Button 1"
    },
    {
      "type": "text",
      "id": "button_1_label",
      "label": "Label",
      "default": "Shop collection"
    },
    {
      "type": "url",
      "id": "button_1_link",
      "label": "Link"
    },
    {
      "type": "header",
      "content": "Button 2"
    },
    {
      "type": "text",
      "id": "button_2_label",
      "label": "Label",
      "default": "Explore routine"
    },
    {
      "type": "url",
      "id": "button_2_link",
      "label": "Link"
    }
  ],
  "presets": [
    {
      "name": "Hero banner"
    }
  ]
}
{% endschema %}
