<section
  class="section-media-grid color-{{ section.settings.color_scheme }}"
  id="MediaGrid-{{ section.id }}"
  data-section-id="{{ section.id }}"
>
  <div class="page-width section-spacing">
    {%- if section.settings.title != blank or section.settings.subheading != blank -%}
      <div class="section-header text-center" style="margin-bottom: 3rem;">
        {%- if section.settings.subheading != blank -%}
          <span class="text-subheading">{{ section.settings.subheading | escape }}</span>
        {%- endif -%}
        <h2 class="h2" style="margin-bottom: 0.5rem;">{{ section.settings.title | escape }}</h2>
      </div>
    {%- endif -%}

    <div class="media-bento-grid">
      {%- for block in section.blocks -%}
        <div
          class="bento-item bento-item--span-{{ block.settings.column_span | default: '1' }} color-scheme-2"
          {{ block.shopify_attributes }}
        >
          {%- case block.type -%}
            {%- when 'image_card' -%}
              <div class="bento-card bento-card--image">
                {%- if block.settings.image != blank -%}
                  <img
                    src="{{ block.settings.image | image_url: width: 1200 }}"
                    alt="{{ block.settings.image.alt | default: block.settings.title | escape }}"
                    width="600"
                    height="400"
                    loading="lazy"
                    class="bento-card__img"
                  >
                {%- else -%}
                  <div class="bento-card__placeholder">
                    {{ 'lifestyle-1' | placeholder_svg_tag: 'placeholder-svg' }}
                  </div>
                {%- endif -%}
                <div class="bento-card__overlay">
                  {%- if block.settings.subheading != blank -%}
                    <span class="text-subheading" style="color: #FFFFFF;">{{ block.settings.subheading | escape }}</span>
                  {%- endif -%}
                  {%- if block.settings.title != blank -%}
                    <h3 class="h3" style="color: #FFFFFF; margin-bottom: 0.5rem;">{{ block.settings.title | escape }}</h3>
                  {%- endif -%}
                  {%- if block.settings.text != blank -%}
                    <p style="color: rgba(255, 255, 255, 0.9); margin-bottom: 1rem;">{{ block.settings.text | escape }}</p>
                  {%- endif -%}
                  {%- if block.settings.button_label != blank -%}
                    <a href="{{ block.settings.button_link }}" class="button button--secondary button--sm">
                      {{ block.settings.button_label | escape }}
                    </a>
                  {%- endif -%}
                </div>
              </div>

            {%- when 'product_card' -%}
              <div class="bento-card bento-card--product" style="padding: 1.5rem; height: 100%;">
                {%- if block.settings.product != blank -%}
                  {% render 'product-card', product_card_product: block.settings.product %}
                {%- else -%}
                  <div class="product-card">
                    <div class="product-card__placeholder">{{ 'product-1' | placeholder_svg_tag: 'placeholder-svg' }}</div>
                    <div class="product-card__info"><h3>Curated Product</h3><div class="product-card__price">$45.00</div></div>
                  </div>
                {%- endif -%}
              </div>
          {%- endcase -%}
        </div>
      {%- endfor -%}
    </div>
  </div>
</section>

<style>
  .media-bento-grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: 1.5rem;
  }
  @media (min-width: 768px) {
    .media-bento-grid {
      grid-template-columns: repeat(3, 1fr);
    }
    .bento-item--span-2 {
      grid-column: span 2;
    }
    .bento-item--span-3 {
      grid-column: span 3;
    }
  }
  .bento-item {
    border-radius: var(--radius-card);
    overflow: hidden;
    position: relative;
    min-height: 320px;
    box-shadow: var(--shadow-sm);
  }
  .bento-card {
    position: relative;
    width: 100%;
    height: 100%;
  }
  .bento-card__img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
    transition: transform var(--duration-slow) var(--ease-standard);
  }
  .bento-card:hover .bento-card__img {
    transform: scale(1.03);
  }
  .bento-card__placeholder {
    width: 100%;
    height: 100%;
    background-color: #374151;
    display: flex;
    align-items: center;
    justify-content: center;
  }
  .bento-card__placeholder svg {
    width: 100%;
    height: 100%;
    opacity: 0.2;
  }
  .bento-card__overlay {
    position: absolute;
    inset: 0;
    padding: 2rem;
    display: flex;
    flex-direction: column;
    justify-content: flex-end;
    background: linear-gradient(180deg, rgba(0, 0, 0, 0) 30%, rgba(0, 0, 0, 0.75) 100%);
    z-index: 2;
  }
</style>

{% schema %}
{
  "name": "Bento media grid",
  "settings": [
    {
      "type": "select",
      "id": "color_scheme",
      "label": "Color scheme",
      "options": [
        { "value": "scheme-1", "label": "Scheme 1" },
        { "value": "scheme-2", "label": "Scheme 2" },
        { "value": "scheme-3", "label": "Scheme 3" },
        { "value": "scheme-4", "label": "Scheme 4" }
      ],
      "default": "scheme-1"
    },
    {
      "type": "text",
      "id": "subheading",
      "label": "Subheading",
      "default": "Visual Stories"
    },
    {
      "type": "text",
      "id": "title",
      "label": "Heading",
      "default": "Crafted For Every Lifestyle"
    }
  ],
  "blocks": [
    {
      "type": "image_card",
      "name": "Image card",
      "settings": [
        {
          "type": "image_picker",
          "id": "image",
          "label": "Card image"
        },
        {
          "type": "select",
          "id": "column_span",
          "label": "Column width (desktop)",
          "options": [
            { "value": "1", "label": "1 column (1/3)" },
            { "value": "2", "label": "2 columns (2/3)" },
            { "value": "3", "label": "3 columns (Full width)" }
          ],
          "default": "2"
        },
        {
          "type": "text",
          "id": "subheading",
          "label": "Subheading",
          "default": "Daily Routine"
        },
        {
          "type": "text",
          "id": "title",
          "label": "Card title",
          "default": "Nourish From Root to Tip"
        },
        {
          "type": "text",
          "id": "text",
          "label": "Text",
          "default": "Infused with active bio-botanicals to maintain natural balance."
        },
        {
          "type": "text",
          "id": "button_label",
          "label": "Button label",
          "default": "Shop collection"
        },
        {
          "type": "url",
          "id": "button_link",
          "label": "Button link"
        }
      ]
    },
    {
      "type": "product_card",
      "name": "Product card",
      "settings": [
        {
          "type": "product",
          "id": "product",
          "label": "Product"
        },
        {
          "type": "select",
          "id": "column_span",
          "label": "Column width (desktop)",
          "options": [
            { "value": "1", "label": "1 column (1/3)" },
            { "value": "2", "label": "2 columns (2/3)" }
          ],
          "default": "1"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Bento media grid",
      "blocks": [
        { "type": "image_card", "settings": { "column_span": "2" } },
        { "type": "product_card", "settings": { "column_span": "1" } },
        { "type": "product_card", "settings": { "column_span": "1" } },
        { "type": "image_card", "settings": { "column_span": "2" } }
      ]
    }
  ]
}
{% endschema %}
