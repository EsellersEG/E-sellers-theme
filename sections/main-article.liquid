{%- comment -%}
  Main Article Section - E-sellers Professional (v4.9.0)
{%- endcomment -%}

{%- style -%}
  #shopify-section-{{ section.id }} {
    background-color: {{ section.settings.bg_color }};
    color: {{ section.settings.text_color }};
    --section-heading-color: {{ section.settings.heading_color }};
    padding-top: {{ section.settings.padding_top }}px;
    padding-bottom: {{ section.settings.padding_bottom }}px;
  }

  .article-wrapper {
    max-width: 800px;
    margin: 0 auto;
  }

  .article__header {
    text-align: center;
    margin-bottom: 32px;
  }

  .article__featured-img {
    width: 100%;
    border-radius: var(--card-radius, 16px);
    margin-bottom: 40px;
    object-fit: cover;
  }

  .article__content {
    font-size: 1.7rem;
    line-height: 1.8;
  }

  .article__content p {
    margin-bottom: 24px;
  }

  .article__content h2,
  .article__content h3 {
    margin-top: 36px;
    margin-bottom: 16px;
  }
{%- endstyle -%}

<article class="page-width">
  <div class="article-wrapper">
    <!-- Header -->
    <header class="article__header">
      <div style="font-size: 1.3rem; color: #71717a; text-transform: uppercase; letter-spacing: 0.05em; margin-bottom: 12px;">
        {{ article.published_at | date: "%B %d, %Y" }} &bull; By {{ article.author }}
      </div>
      <h1 class="h1">{{ article.title | escape }}</h1>
    </header>

    <!-- Featured Image -->
    {%- if article.image -%}
      <img
        src="{{ article.image | image_url: width: 1200 }}"
        srcset="
          {{ article.image | image_url: width: 600 }} 600w,
          {{ article.image | image_url: width: 900 }} 900w,
          {{ article.image | image_url: width: 1200 }} 1200w
        "
        sizes="(min-width: 990px) 800px, 100vw"
        alt="{{ article.image.alt | default: article.title | escape }}"
        class="article__featured-img"
        loading="eager"
        width="{{ article.image.width }}"
        height="{{ article.image.height }}"
      >
    {%- endif -%}

    <!-- Body -->
    <div class="article__content">
      {{ article.content }}
    </div>

    <!-- Back to Blog Link -->
    <div style="margin-top: 48px; padding-top: 24px; border-top: 1px solid #e2e8f0; display: flex; justify-content: space-between; align-items: center;">
      <a href="{{ blog.url }}" class="link" style="font-weight: 600; font-size: 1.5rem;">
        &larr; Back to {{ blog.title }}
      </a>
      <div style="display: flex; gap: 12px; align-items: center; color: #71717a;">
        <span>{{ 'general.share.share' | t }}:</span>
        <a href="https://www.facebook.com/sharer.php?u={{ shop.url | append: article.url }}" target="_blank" rel="noopener" aria-label="Share on Facebook">{% render 'icon', name: 'facebook' %}</a>
        <a href="https://twitter.com/share?url={{ shop.url | append: article.url }}&text={{ article.title | url_param_escape }}" target="_blank" rel="noopener" aria-label="Share on Twitter">{% render 'icon', name: 'twitter' %}</a>
      </div>
    </div>
  </div>
</article>

{% schema %}
{
  "name": "Article Content",
  "settings": [
    {
      "type": "header",
      "content": "Section Colors (Independent)"
    },
    {
      "type": "color",
      "id": "bg_color",
      "label": "Background color",
      "default": "#ffffff"
    },
    {
      "type": "color",
      "id": "heading_color",
      "label": "Heading color",
      "default": "#121212"
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "Text color",
      "default": "#121212"
    },
    {
      "type": "header",
      "content": "Section Spacing"
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 20,
      "max": 100,
      "step": 5,
      "unit": "px",
      "label": "Top padding",
      "default": 40
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 20,
      "max": 100,
      "step": 5,
      "unit": "px",
      "label": "Bottom padding",
      "default": 60
    }
  ]
}
{% endschema %}
