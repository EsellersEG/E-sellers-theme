{%- comment -%}
  Collapsible Content / FAQ Section - E-sellers Professional (v4.9.0)
{%- endcomment -%}

{%- style -%}
  #shopify-section-{{ section.id }} {
    background-color: {{ section.settings.bg_color }};
    color: {{ section.settings.text_color }};
    --section-heading-color: {{ section.settings.heading_color }};
    --faq-card-bg: {{ section.settings.card_bg_color }};
    --faq-border: {{ section.settings.border_color }};
    padding-top: {{ section.settings.padding_top }}px;
    padding-bottom: {{ section.settings.padding_bottom }}px;
  }

  .faq__header {
    text-align: center;
    max-width: 650px;
    margin: 0 auto 40px auto;
  }

  .faq__list {
    max-width: {{ section.settings.max_width }}px;
    margin: 0 auto;
    display: flex;
    flex-direction: column;
    gap: 12px;
  }

  .faq-item {
    background-color: var(--faq-card-bg);
    border: 1px solid var(--faq-border);
    border-radius: var(--card-radius, 12px);
    overflow: hidden;
    transition: box-shadow 0.2s;
  }

  .faq-item summary {
    padding: 20px 24px;
    cursor: pointer;
    font-size: 1.6rem;
    font-weight: 700;
    display: flex;
    align-items: center;
    justify-content: space-between;
    user-select: none;
    list-style: none;
  }

  .faq-item summary::-webkit-details-marker {
    display: none;
  }

  .faq-item__content {
    padding: 0 24px 20px 24px;
    font-size: 1.5rem;
    line-height: 1.7;
    opacity: 0.9;
  }

  .faq-item[open] summary svg {
    transform: rotate(180deg);
  }

  .faq-item summary svg {
    transition: transform 0.25s ease;
  }
{%- endstyle -%}

<div class="page-width">
  {%- if section.settings.heading != blank or section.settings.subheading != blank -%}
    <div class="faq__header">
      {%- if section.settings.subheading != blank -%}
        <p style="font-size: 1.3rem; font-weight: 700; text-transform: uppercase; letter-spacing: 0.1em; color: #71717a; margin-bottom: 8px;">
          {{ section.settings.subheading | escape }}
        </p>
      {%- endif -%}
      {%- if section.settings.heading != blank -%}
        <h2 class="h2" style="margin: 0;">{{ section.settings.heading | escape }}</h2>
      {%- endif -%}
    </div>
  {%- endif -%}

  <div class="faq__list">
    {%- for block in section.blocks -%}
      <details class="faq-item" {{ block.shopify_attributes }}>
        <summary>
          <span>{{ block.settings.heading | escape }}</span>
          {% render 'icon', name: 'chevron-down' %}
        </summary>
        <div class="faq-item__content">
          {{ block.settings.content }}
          {%- if block.settings.page != blank -%}
            {{ block.settings.page.content }}
          {%- endif -%}
        </div>
      </details>
    {%- endfor -%}
  </div>
</div>

{% schema %}
{
  "name": "Collapsible FAQ",
  "settings": [
    {
      "type": "text",
      "id": "subheading",
      "label": "Subheading",
      "default": "Got Questions?"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Frequently Asked Questions"
    },
    {
      "type": "range",
      "id": "max_width",
      "min": 600,
      "max": 1000,
      "step": 50,
      "unit": "px",
      "label": "Content max width",
      "default": 800
    },
    {
      "type": "header",
      "content": "Section Colors (Independent)"
    },
    {
      "type": "color",
      "id": "bg_color",
      "label": "Background color",
      "default": "#f8fafc"
    },
    {
      "type": "color",
      "id": "card_bg_color",
      "label": "Card background color",
      "default": "#ffffff"
    },
    {
      "type": "color",
      "id": "border_color",
      "label": "Border color",
      "default": "#e2e8f0"
    },
    {
      "type": "color",
      "id": "heading_color",
      "label": "Heading color",
      "default": "#121212"
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "Text color",
      "default": "#334155"
    },
    {
      "type": "header",
      "content": "Section Spacing"
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 20,
      "max": 100,
      "step": 5,
      "unit": "px",
      "label": "Top padding",
      "default": 60
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 20,
      "max": 100,
      "step": 5,
      "unit": "px",
      "label": "Bottom padding",
      "default": 60
    }
  ],
  "blocks": [
    {
      "type": "question",
      "name": "Question",
      "settings": [
        {
          "type": "text",
          "id": "heading",
          "label": "Question",
          "default": "How long does shipping take?"
        },
        {
          "type": "richtext",
          "id": "content",
          "label": "Answer",
          "default": "<p>Standard delivery takes 3-5 business days. Express shipping options are also available at checkout.</p>"
        },
        {
          "type": "page",
          "id": "page",
          "label": "Content from page (optional)"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Collapsible FAQ",
      "blocks": [
        {
          "type": "question",
          "settings": {
            "heading": "What is your return policy?",
            "content": "<p>We offer a hassle-free 30-day return policy on all unworn, original condition items.</p>"
          }
        },
        {
          "type": "question",
          "settings": {
            "heading": "Are your materials sustainably sourced?",
            "content": "<p>Yes, all our products are crafted with ethically sourced, eco-friendly materials.</p>"
          }
        },
        {
          "type": "question",
          "settings": {
            "heading": "Do you ship internationally?",
            "content": "<p>Yes, we offer fast worldwide shipping with all customs duties calculated at checkout.</p>"
          }
        }
      ]
    }
  ]
}
{% endschema %}
