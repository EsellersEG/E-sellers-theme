{%- comment -%}
  Marquee Ticker Section - E-sellers Professional (v4.9.0)
{%- endcomment -%}

{%- style -%}
  #shopify-section-{{ section.id }} {
    background-color: {{ section.settings.bg_color }};
    color: {{ section.settings.text_color }};
    border-top: 1px solid {{ section.settings.border_color }};
    border-bottom: 1px solid {{ section.settings.border_color }};
    padding-top: {{ section.settings.padding_top }}px;
    padding-bottom: {{ section.settings.padding_bottom }}px;
    overflow: hidden;
    user-select: none;
  }

  .marquee-wrapper {
    display: flex;
    overflow: hidden;
    width: 100%;
  }

  .marquee-track {
    display: flex;
    align-items: center;
    gap: {{ section.settings.item_gap }}px;
    width: max-content;
    animation: marquee-scroll-{{ section.id }} {{ section.settings.speed }}s linear infinite;
    {% if section.settings.pause_on_hover %}
      &:hover {
        animation-play-state: paused;
      }
    {% endif %}
  }

  @keyframes marquee-scroll-{{ section.id }} {
    0% { transform: translateX(0); }
    100% { transform: translateX(-50%); }
  }

  .marquee-item {
    display: inline-flex;
    align-items: center;
    gap: 12px;
    font-size: {{ section.settings.font_size }}px;
    font-weight: 700;
    text-transform: {{ section.settings.text_transform }};
    letter-spacing: 0.05em;
    white-space: nowrap;
    color: inherit;
    text-decoration: none;
  }

  .marquee-icon {
    display: flex;
    align-items: center;
    justify-content: center;
    color: {{ section.settings.icon_color }};
  }
{%- endstyle -%}

<div class="marquee-wrapper" role="region" aria-label="Announcement Marquee">
  <div class="marquee-track">
    {%- for i in (1..4) -%}
      {%- for block in section.blocks -%}
        {%- if block.settings.link != blank -%}
          <a href="{{ block.settings.link }}" class="marquee-item" {{ block.shopify_attributes }}>
            {%- if block.settings.icon != 'none' -%}
              <span class="marquee-icon">{% render 'icon', name: block.settings.icon %}</span>
            {%- endif -%}
            <span>{{ block.settings.text | escape }}</span>
          </a>
        {%- else -%}
          <div class="marquee-item" {{ block.shopify_attributes }}>
            {%- if block.settings.icon != 'none' -%}
              <span class="marquee-icon">{% render 'icon', name: block.settings.icon %}</span>
            {%- endif -%}
            <span>{{ block.settings.text | escape }}</span>
          </div>
        {%- endif -%}
      {%- endfor -%}
    {%- endfor -%}
  </div>
</div>

{% schema %}
{
  "name": "Marquee Ticker",
  "settings": [
    {
      "type": "header",
      "content": "Section Colors (Independent)"
    },
    {
      "type": "color",
      "id": "bg_color",
      "label": "Background color",
      "default": "#121212"
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "Text color",
      "default": "#ffffff"
    },
    {
      "type": "color",
      "id": "icon_color",
      "label": "Icon color",
      "default": "#f59e0b"
    },
    {
      "type": "color",
      "id": "border_color",
      "label": "Border color",
      "default": "transparent"
    },
    {
      "type": "header",
      "content": "Marquee Settings"
    },
    {
      "type": "range",
      "id": "speed",
      "min": 10,
      "max": 60,
      "step": 5,
      "unit": "s",
      "label": "Scroll duration (lower is faster)",
      "default": 25
    },
    {
      "type": "range",
      "id": "font_size",
      "min": 12,
      "max": 28,
      "step": 1,
      "unit": "px",
      "label": "Font size",
      "default": 15
    },
    {
      "type": "select",
      "id": "text_transform",
      "options": [
        { "value": "uppercase", "label": "Uppercase" },
        { "value": "none", "label": "Default (None)" }
      ],
      "default": "uppercase",
      "label": "Text transform"
    },
    {
      "type": "range",
      "id": "item_gap",
      "min": 20,
      "max": 80,
      "step": 4,
      "unit": "px",
      "label": "Gap between items",
      "default": 48
    },
    {
      "type": "checkbox",
      "id": "pause_on_hover",
      "default": true,
      "label": "Pause animation on hover"
    },
    {
      "type": "header",
      "content": "Section Spacing"
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 8,
      "max": 40,
      "step": 2,
      "unit": "px",
      "label": "Top padding",
      "default": 14
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 8,
      "max": 40,
      "step": 2,
      "unit": "px",
      "label": "Bottom padding",
      "default": 14
    }
  ],
  "blocks": [
    {
      "type": "text",
      "name": "Ticker Item",
      "settings": [
        {
          "type": "text",
          "id": "text",
          "label": "Message",
          "default": "⚡ FREE WORLDWIDE EXPRESS DELIVERY OVER $100"
        },
        {
          "type": "select",
          "id": "icon",
          "options": [
            { "value": "none", "label": "None" },
            { "value": "star", "label": "Star" },
            { "value": "truck", "label": "Truck / Shipping" },
            { "value": "shield", "label": "Shield / Security" },
            { "value": "check", "label": "Checkmark" }
          ],
          "default": "star",
          "label": "Icon"
        },
        {
          "type": "url",
          "id": "link",
          "label": "Link (optional)"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Marquee Ticker",
      "blocks": [
        { "type": "text", "settings": { "text": "⚡ FREE WORLDWIDE EXPRESS DELIVERY", "icon": "truck" } },
        { "type": "text", "settings": { "text": "★ 50,000+ HAPPY CUSTOMERS GLOBALLY", "icon": "star" } },
        { "type": "text", "settings": { "text": "🛡️ 30-DAY HASSLE FREE MONEY BACK GUARANTEE", "icon": "shield" } },
        { "type": "text", "settings": { "text": "🌿 SUSTAINABLY CRAFTED & ETHICALLY SOURCED", "icon": "check" } }
      ]
    }
  ]
}
{% endschema %}
