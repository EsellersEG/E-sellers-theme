<section
  class="section-buy-together color-{{ section.settings.color_scheme }}"
  id="BuyTogether-{{ section.id }}"
  data-section-id="{{ section.id }}"
  data-discount-percent="{{ section.settings.discount_percent | default: 0 }}"
>
  <div class="page-width section-spacing">
    <div class="section-header text-center" style="margin-bottom: 2.5rem;">
      {%- if section.settings.subheading != blank -%}
        <span class="text-subheading">{{ section.settings.subheading | escape }}</span>
      {%- endif -%}
      <h2 class="h2" style="margin-bottom: 0.5rem;">{{ section.settings.title | default: 'Frequently Bought Together' | escape }}</h2>
    </div>

    <div class="buy-together-container color-scheme-2">
      <div class="buy-together-grid">
        {% # Products List %}
        <div class="buy-together__products">
          {%- assign bundle_products_count = 0 -%}

          {% # Main Product (from settings or current product) %}
          {%- assign main_prod = section.settings.main_product | default: product -%}
          {%- if main_prod != blank -%}
            {%- assign bundle_products_count = bundle_products_count | plus: 1 -%}
            <div class="buy-together-item" data-price="{{ main_prod.price }}" data-variant-id="{{ main_prod.first_available_variant.id }}">
              <label class="buy-together-item__checkbox-label">
                <input type="checkbox" checked disabled class="buy-together-checkbox">
                <span class="buy-together-checkbox__custom"></span>
              </label>

              <div class="buy-together-item__media">
                {%- if main_prod.featured_image -%}
                  <img src="{{ main_prod.featured_image | image_url: width: 160 }}" alt="{{ main_prod.title | escape }}" width="80" height="80" loading="lazy">
                {%- endif -%}
              </div>

              <div class="buy-together-item__info">
                <a href="{{ main_prod.url }}" class="buy-together-item__title"><strong>This item:</strong> {{ main_prod.title | escape }}</a>
                <div class="buy-together-item__price">{{ main_prod.price | money }}</div>
              </div>
            </div>
          {%- endif -%}

          {% # Block Products %}
          {%- for block in section.blocks -%}
            {%- assign block_prod = block.settings.product -%}
            {%- if block_prod != blank -%}
              {%- assign bundle_products_count = bundle_products_count | plus: 1 -%}
              <div class="buy-together-item" data-price="{{ block_prod.price }}" data-variant-id="{{ block_prod.first_available_variant.id }}" {{ block.shopify_attributes }}>
                <label class="buy-together-item__checkbox-label">
                  <input type="checkbox" checked class="buy-together-checkbox" data-index="{{ forloop.index }}">
                  <span class="buy-together-checkbox__custom"></span>
                </label>

                <div class="buy-together-item__media">
                  {%- if block_prod.featured_image -%}
                    <img src="{{ block_prod.featured_image | image_url: width: 160 }}" alt="{{ block_prod.title | escape }}" width="80" height="80" loading="lazy">
                  {%- endif -%}
                </div>

                <div class="buy-together-item__info">
                  <a href="{{ block_prod.url }}" class="buy-together-item__title">{{ block_prod.title | escape }}</a>
                  <div class="buy-together-item__price">{{ block_prod.price | money }}</div>
                </div>
              </div>
            {%- endif -%}
          {%- endfor -%}
        </div>

        {% # Bundle Action & Total Calculation Column %}
        <div class="buy-together__action-box">
          <div class="bundle-total-label">Total Price:</div>
          <div class="bundle-price-row">
            <span class="bundle-price__current" id="BundleTotal-{{ section.id }}">$0.00</span>
            <span class="bundle-price__compare is-hidden" id="BundleCompare-{{ section.id }}">$0.00</span>
          </div>

          {%- if section.settings.discount_percent > 0 -%}
            <div class="badge badge--sale" style="margin-top: 0.5rem;">
              Save {{ section.settings.discount_percent }}% with Bundle
            </div>
          {%- endif -%}

          <button
            type="button"
            class="button button--primary button--lg button--full-width"
            id="AddBundleBtn-{{ section.id }}"
            style="margin-top: 1.5rem;"
          >
            Add Selected to Cart
          </button>
        </div>
      </div>
    </div>
  </div>
</section>

<style>
  .buy-together-container {
    max-width: 1000px;
    margin: 0 auto;
    padding: 2rem;
    border-radius: var(--radius-card);
    border: 1px solid var(--color-border);
  }
  .buy-together-grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: 2rem;
  }
  @media (min-width: 800px) {
    .buy-together-grid {
      grid-template-columns: 1fr 300px;
      align-items: center;
    }
  }
  .buy-together__products {
    display: flex;
    flex-direction: column;
    gap: 1.25rem;
  }
  .buy-together-item {
    display: flex;
    align-items: center;
    gap: 1rem;
  }
  .buy-together-item__checkbox-label {
    display: flex;
    align-items: center;
    cursor: pointer;
  }
  .buy-together-checkbox {
    width: 18px;
    height: 18px;
    accent-color: var(--color-accent);
    cursor: pointer;
  }
  .buy-together-item__media {
    width: 70px;
    height: 70px;
    border-radius: var(--radius-input);
    overflow: hidden;
    flex-shrink: 0;
    background-color: var(--color-bg);
  }
  .buy-together-item__media img {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }
  .buy-together-item__title {
    font-size: 0.95rem;
    color: inherit;
    text-decoration: none;
    display: block;
    margin-bottom: 0.2rem;
  }
  .buy-together-item__price {
    font-weight: 700;
    font-size: 0.95rem;
  }
  .buy-together__action-box {
    padding-left: 0;
    border-top: 1px solid var(--color-border);
    padding-top: 1.5rem;
  }
  @media (min-width: 800px) {
    .buy-together__action-box {
      border-top: none;
      border-left: 1px solid var(--color-border);
      padding-left: 2rem;
      padding-top: 0;
    }
  }
  .bundle-total-label {
    font-size: 0.9rem;
    font-weight: 600;
    opacity: 0.7;
  }
  .bundle-price-row {
    display: flex;
    align-items: baseline;
    gap: 0.5rem;
    margin-top: 0.25rem;
  }
  .bundle-price__current {
    font-size: 1.6rem;
    font-weight: 800;
  }
  .bundle-price__compare {
    text-decoration: line-through;
    opacity: 0.5;
  }
  .bundle-price__compare.is-hidden {
    display: none;
  }
</style>

<script>
  (function() {
    const wrap = document.getElementById('BuyTogether-{{ section.id }}');
    if (!wrap) return;

    const items = wrap.querySelectorAll('.buy-together-item');
    const totalEl = document.getElementById('BundleTotal-{{ section.id }}');
    const compareEl = document.getElementById('BundleCompare-{{ section.id }}');
    const addBtn = document.getElementById('AddBundleBtn-{{ section.id }}');
    const discountPercent = parseFloat(wrap.dataset.discountPercent) || 0;

    function calculateTotal() {
      let total = 0;
      let count = 0;

      items.forEach(item => {
        const cb = item.querySelector('.buy-together-checkbox');
        if (cb && cb.checked) {
          total += parseInt(item.dataset.price, 10) || 0;
          count++;
        }
      });

      if (discountPercent > 0 && count > 1) {
        const discounted = total * (1 - (discountPercent / 100));
        totalEl.textContent = `$${(discounted / 100).toFixed(2)}`;
        compareEl.textContent = `$${(total / 100).toFixed(2)}`;
        compareEl.classList.remove('is-hidden');
      } else {
        totalEl.textContent = `$${(total / 100).toFixed(2)}`;
        compareEl.classList.add('is-hidden');
      }
    }

    items.forEach(item => {
      const cb = item.querySelector('.buy-together-checkbox');
      if (cb) cb.addEventListener('change', calculateTotal);
    });

    calculateTotal();

    if (addBtn) {
      addBtn.addEventListener('click', async () => {
        const payloadItems = [];
        items.forEach(item => {
          const cb = item.querySelector('.buy-together-checkbox');
          if (cb && cb.checked) {
            payloadItems.push({
              id: parseInt(item.dataset.variantId, 10),
              quantity: 1
            });
          }
        });

        if (payloadItems.length === 0) return;

        addBtn.disabled = true;
        addBtn.textContent = 'Adding...';

        try {
          if (window.cartDrawer) {
            await window.cartDrawer.addItem({ items: payloadItems });
          } else {
            await fetch('/cart/add.js', {
              method: 'POST',
              headers: { 'Content-Type': 'application/json' },
              body: JSON.stringify({ items: payloadItems })
            });
            window.location.href = '/cart';
          }
        } catch (err) {
          console.error(err);
        } finally {
          addBtn.disabled = false;
          addBtn.textContent = 'Add Selected to Cart';
        }
      });
    }
  })();
</script>

{% schema %}
{
  "name": "Frequently bought together",
  "settings": [
    {
      "type": "select",
      "id": "color_scheme",
      "label": "Color scheme",
      "options": [
        { "value": "scheme-1", "label": "Scheme 1" },
        { "value": "scheme-2", "label": "Scheme 2" },
        { "value": "scheme-3", "label": "Scheme 3" },
        { "value": "scheme-4", "label": "Scheme 4" }
      ],
      "default": "scheme-1"
    },
    {
      "type": "text",
      "id": "subheading",
      "label": "Subheading",
      "default": "Better Together"
    },
    {
      "type": "text",
      "id": "title",
      "label": "Heading",
      "default": "Frequently Bought Together"
    },
    {
      "type": "product",
      "id": "main_product",
      "label": "Main product (optional, defaults to page product)"
    },
    {
      "type": "range",
      "id": "discount_percent",
      "min": 0,
      "max": 30,
      "step": 5,
      "unit": "%",
      "label": "Bundle discount",
      "default": 10
    }
  ],
  "blocks": [
    {
      "type": "bundle_item",
      "name": "Complementary product",
      "settings": [
        {
          "type": "product",
          "id": "product",
          "label": "Product"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Frequently bought together",
      "blocks": [
        { "type": "bundle_item" },
        { "type": "bundle_item" }
      ]
    }
  ]
}
{% endschema %}
