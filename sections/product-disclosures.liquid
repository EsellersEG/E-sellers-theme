{%- comment -%}
  Product Disclosures Section Alias
{%- endcomment -%}

{% render 'product-disclosures',
  product: product,
  heading: section.settings.heading,
  heading_size: section.settings.heading_size,
  open_by_default: section.settings.open_by_default,
  blocks: section.blocks
%}

{% schema %}
{
  "name": "Product disclosures",
  "tag": "section",
  "class": "shopify-section--product-disclosures",
  "enabled_on": {
    "templates": ["product"]
  },
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Product Disclosures"
    },
    {
      "type": "select",
      "id": "heading_size",
      "options": [
        { "value": "h2", "label": "Medium" },
        { "value": "h1", "label": "Large" },
        { "value": "h0", "label": "Extra Large" }
      ],
      "default": "h2",
      "label": "Heading size"
    },
    {
      "type": "checkbox",
      "id": "open_by_default",
      "label": "Open first tab by default",
      "default": false
    }
  ],
  "presets": [
    {
      "name": "Product disclosures"
    }
  ]
}
{% endschema %}
