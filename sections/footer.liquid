{%- comment -%}
  Footer Section - E-sellers Professional (v4.9.0)
{%- endcomment -%}

{%- style -%}
  #shopify-section-{{ section.id }} {
    --footer-bg: {{ section.settings.bg_color }};
    --footer-text: {{ section.settings.text_color }};
    --footer-heading: {{ section.settings.heading_color }};
    --footer-hover: {{ section.settings.hover_color }};
    --footer-border: {{ section.settings.border_color }};
    --footer-btn-bg: {{ section.settings.btn_bg_color }};
    --footer-btn-text: {{ section.settings.btn_text_color }};
  }

  .footer {
    background-color: var(--footer-bg);
    color: var(--footer-text);
    border-top: 1px solid var(--footer-border);
    padding-top: {{ section.settings.padding_top }}px;
    padding-bottom: {{ section.settings.padding_bottom }}px;
  }

  .footer__grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: 40px;
    margin-bottom: 48px;
  }

  @media screen and (min-width: 750px) {
    .footer__grid {
      grid-template-columns: repeat(2, 1fr);
    }
  }

  @media screen and (min-width: 990px) {
    .footer__grid {
      grid-template-columns: repeat({{ section.blocks.size | at_most: 4 | at_least: 2 }}, 1fr);
    }
  }

  .footer__block-title {
    color: var(--footer-heading);
    font-size: 1.6rem;
    font-weight: 700;
    margin-bottom: 20px;
    text-transform: uppercase;
    letter-spacing: 0.05em;
  }

  .footer__link-list {
    list-style: none;
    display: flex;
    flex-direction: column;
    gap: 12px;
  }

  .footer__link-list a {
    color: var(--footer-text);
    text-decoration: none;
    font-size: 1.4rem;
    transition: color 0.2s, transform 0.2s;
    display: inline-block;
  }

  .footer__link-list a:hover {
    color: var(--footer-hover);
    transform: translateX(3px);
  }

  /* Newsletter Block */
  .footer-newsletter__form {
    display: flex;
    gap: 8px;
    margin-top: 16px;
    max-width: 400px;
  }

  .footer-newsletter__input {
    flex: 1;
    background-color: rgba(255, 255, 255, 0.08);
    border: 1px solid var(--footer-border);
    color: var(--footer-text);
    padding: 12px 16px;
    border-radius: var(--input-radius, 8px);
    font-size: 1.4rem;
  }

  .footer-newsletter__input:focus {
    outline: none;
    border-color: var(--footer-hover);
  }

  .footer-newsletter__button {
    background-color: var(--footer-btn-bg);
    color: var(--footer-btn-text);
    border: none;
    padding: 12px 20px;
    border-radius: var(--button-radius, 8px);
    font-weight: 700;
    cursor: pointer;
    transition: opacity 0.2s;
  }

  .footer-newsletter__button:hover {
    opacity: 0.9;
  }

  /* Footer Bottom Bar */
  .footer__bottom {
    border-top: 1px solid var(--footer-border);
    padding-top: 32px;
    display: flex;
    flex-direction: column;
    gap: 24px;
    align-items: center;
    justify-content: space-between;
    font-size: 1.3rem;
  }

  @media screen and (min-width: 750px) {
    .footer__bottom {
      flex-direction: row;
    }
  }

  .footer__socials {
    display: flex;
    align-items: center;
    gap: 16px;
  }

  .footer__socials a {
    color: var(--footer-text);
    display: flex;
    transition: color 0.2s;
  }

  .footer__socials a:hover {
    color: var(--footer-hover);
  }

  .footer__payment-icons {
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
    align-items: center;
  }

  .footer__payment-icon {
    width: 38px;
    height: 24px;
  }

  .footer__localization {
    display: flex;
    gap: 16px;
    align-items: center;
  }

  .footer__select {
    background-color: rgba(255, 255, 255, 0.05);
    border: 1px solid var(--footer-border);
    color: var(--footer-text);
    padding: 6px 12px;
    border-radius: var(--input-radius, 6px);
    font-size: 1.3rem;
  }
{%- endstyle -%}

<footer class="footer">
  <div class="page-width">
    <!-- Top Grid Blocks -->
    {%- if section.blocks.size > 0 -%}
      <div class="footer__grid">
        {%- for block in section.blocks -%}
          <div class="footer__block" {{ block.shopify_attributes }}>
            {%- case block.type -%}
              {%- when 'link_list' -%}
                {%- if block.settings.heading != blank -%}
                  <h3 class="footer__block-title">{{ block.settings.heading | escape }}</h3>
                {%- endif -%}
                {%- if block.settings.menu != blank -%}
                  <ul class="footer__link-list">
                    {%- for link in block.settings.menu.links -%}
                      <li>
                        <a href="{{ link.url }}">{{ link.title | escape }}</a>
                      </li>
                    {%- endfor -%}
                  </ul>
                {%- endif -%}

              {%- when 'text' -%}
                {%- if block.settings.heading != blank -%}
                  <h3 class="footer__block-title">{{ block.settings.heading | escape }}</h3>
                {%- endif -%}
                {%- if block.settings.subtext != blank -%}
                  <div style="font-size: 1.4rem; line-height: 1.7;">
                    {{ block.settings.subtext }}
                  </div>
                {%- endif -%}

              {%- when 'newsletter' -%}
                {%- if block.settings.heading != blank -%}
                  <h3 class="footer__block-title">{{ block.settings.heading | escape }}</h3>
                {%- endif -%}
                {%- if block.settings.subtext != blank -%}
                  <p style="font-size: 1.4rem; margin-bottom: 12px;">{{ block.settings.subtext }}</p>
                {%- endif -%}
                {%- form 'customer', class: 'footer-newsletter__form' -%}
                  <input type="hidden" name="contact[tags]" value="newsletter">
                  <input
                    type="email"
                    name="contact[email]"
                    class="footer-newsletter__input"
                    value="{{ form.email }}"
                    placeholder="{{ 'sections.newsletter.email_placeholder' | t }}"
                    required
                    aria-label="{{ 'sections.newsletter.email_placeholder' | t }}"
                  >
                  <button type="submit" class="footer-newsletter__button" aria-label="{{ 'sections.newsletter.button_label' | t }}">
                    {{ block.settings.button_label | default: 'Join' }}
                  </button>
                  {%- if form.posted_successfully? -%}
                    <p style="color: #22c55e; margin-top: 8px; font-size: 1.3rem;">{{ 'sections.newsletter.success' | t }}</p>
                  {%- endif -%}
                {%- endform -%}

              {%- when 'image' -%}
                {%- if block.settings.image != blank -%}
                  <img
                    src="{{ block.settings.image | image_url: width: 300 }}"
                    alt="{{ block.settings.image.alt | default: shop.name | escape }}"
                    style="max-width: {{ block.settings.image_width }}px; height: auto;"
                    loading="lazy"
                    width="{{ block.settings.image.width }}"
                    height="{{ block.settings.image.height }}"
                  >
                {%- endif -%}
            {%- endcase -%}
          </div>
        {%- endfor -%}
      </div>
    {%- endif -%}

    <!-- Bottom Bar -->
    <div class="footer__bottom">
      <!-- Currency & Language Localization Selectors -->
      {%- if section.settings.enable_country_selector or section.settings.enable_language_selector -%}
        <div class="footer__localization">
          {%- if section.settings.enable_country_selector and localization.available_countries.size > 1 -%}
            {%- form 'localization' -%}
              <select name="country_code" class="footer__select" onchange="this.form.submit()">
                {%- for country in localization.available_countries -%}
                  <option value="{{ country.iso_code }}" {% if country.iso_code == localization.country.iso_code %}selected{% endif %}>
                    {{ country.name }} ({{ country.currency.iso_code }} {{ country.currency.symbol }})
                  </option>
                {%- endfor -%}
              </select>
            {%- endform -%}
          {%- endif -%}

          {%- if section.settings.enable_language_selector and localization.available_languages.size > 1 -%}
            {%- form 'localization' -%}
              <select name="locale_code" class="footer__select" onchange="this.form.submit()">
                {%- for language in localization.available_languages -%}
                  <option value="{{ language.iso_code }}" {% if language.iso_code == localization.language.iso_code %}selected{% endif %}>
                    {{ language.endonym_name | capitalize }}
                  </option>
                {%- endfor -%}
              </select>
            {%- endform -%}
          {%- endif -%}
        </div>
      {%- endif -%}

      <!-- Social Media Icons -->
      {%- if section.settings.show_social -%}
        <div class="footer__socials" aria-label="{{ 'sections.footer.follow_us' | t }}">
          {%- if settings.social_facebook_link != blank -%}
            <a href="{{ settings.social_facebook_link }}" aria-label="Facebook">{% render 'icon', name: 'facebook' %}</a>
          {%- endif -%}
          {%- if settings.social_instagram_link != blank -%}
            <a href="{{ settings.social_instagram_link }}" aria-label="Instagram">{% render 'icon', name: 'instagram' %}</a>
          {%- endif -%}
          {%- if settings.social_twitter_link != blank -%}
            <a href="{{ settings.social_twitter_link }}" aria-label="Twitter">{% render 'icon', name: 'twitter' %}</a>
          {%- endif -%}
          {%- if settings.social_tiktok_link != blank -%}
            <a href="{{ settings.social_tiktok_link }}" aria-label="TikTok">{% render 'icon', name: 'tiktok' %}</a>
          {%- endif -%}
          {%- if settings.social_youtube_link != blank -%}
            <a href="{{ settings.social_youtube_link }}" aria-label="YouTube">{% render 'icon', name: 'youtube' %}</a>
          {%- endif -%}
        </div>
      {%- endif -%}

      <!-- Payment Icons -->
      {%- if section.settings.show_payment_icons -%}
        <div class="footer__payment-icons" aria-label="{{ 'sections.footer.payment_methods' | t }}">
          {%- for type in shop.enabled_payment_types -%}
            {{ type | payment_type_svg_tag: class: 'footer__payment-icon' }}
          {%- endfor -%}
        </div>
      {%- endif -%}

      <!-- Copyright Statement -->
      <div class="footer__copyright">
        <small>&copy; {{ 'now' | date: '%Y' }}, {{ shop.name | link_to: routes.root_url }}. {{ 'sections.footer.copyright' | t }} Designed by <strong>E-sellers</strong>.</small>
      </div>
    </div>
  </div>
</footer>

{% schema %}
{
  "name": "Footer",
  "max_blocks": 6,
  "settings": [
    {
      "type": "header",
      "content": "Section Colors (Independent)"
    },
    {
      "type": "color",
      "id": "bg_color",
      "label": "Background color",
      "default": "#121212"
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "Text color",
      "default": "#a1a1aa"
    },
    {
      "type": "color",
      "id": "heading_color",
      "label": "Heading color",
      "default": "#ffffff"
    },
    {
      "type": "color",
      "id": "hover_color",
      "label": "Links hover color",
      "default": "#ffffff"
    },
    {
      "type": "color",
      "id": "border_color",
      "label": "Border color",
      "default": "#27272a"
    },
    {
      "type": "color",
      "id": "btn_bg_color",
      "label": "Button background",
      "default": "#ffffff"
    },
    {
      "type": "color",
      "id": "btn_text_color",
      "label": "Button text color",
      "default": "#121212"
    },
    {
      "type": "header",
      "content": "Payment Methods & Features"
    },
    {
      "type": "checkbox",
      "id": "show_payment_icons",
      "label": "Show payment method icons",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "show_social",
      "label": "Show social media icons",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "enable_country_selector",
      "label": "Enable country/currency selector",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "enable_language_selector",
      "label": "Enable language selector",
      "default": true
    },
    {
      "type": "header",
      "content": "Section Spacing"
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 20,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "Top padding",
      "default": 64
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 20,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "Bottom padding",
      "default": 40
    }
  ],
  "blocks": [
    {
      "type": "link_list",
      "name": "Navigation Menu",
      "settings": [
        {
          "type": "text",
          "id": "heading",
          "label": "Column heading",
          "default": "Quick links"
        },
        {
          "type": "link_list",
          "id": "menu",
          "default": "footer",
          "label": "Menu"
        }
      ]
    },
    {
      "type": "text",
      "name": "Text / Brand Info",
      "settings": [
        {
          "type": "text",
          "id": "heading",
          "label": "Heading",
          "default": "About E-sellers"
        },
        {
          "type": "richtext",
          "id": "subtext",
          "label": "Description",
          "default": "<p>E-sellers Professional is engineered for high conversion, speed, and unforgettable brand experiences.</p>"
        }
      ]
    },
    {
      "type": "newsletter",
      "name": "Newsletter Signup",
      "limit": 1,
      "settings": [
        {
          "type": "text",
          "id": "heading",
          "label": "Heading",
          "default": "Stay in the loop"
        },
        {
          "type": "text",
          "id": "subtext",
          "label": "Subtext",
          "default": "Subscribe to receive special offers, free giveaways, and once-in-a-lifetime deals."
        },
        {
          "type": "text",
          "id": "button_label",
          "label": "Button label",
          "default": "Subscribe"
        }
      ]
    },
    {
      "type": "image",
      "name": "Image / Badge",
      "settings": [
        {
          "type": "image_picker",
          "id": "image",
          "label": "Image"
        },
        {
          "type": "range",
          "id": "image_width",
          "min": 50,
          "max": 300,
          "step": 10,
          "unit": "px",
          "label": "Image width",
          "default": 150
        }
      ]
    }
  ],
  "default": {
    "blocks": [
      {
        "type": "text"
      },
      {
        "type": "link_list"
      },
      {
        "type": "newsletter"
      }
    ]
  }
}
{% endschema %}
