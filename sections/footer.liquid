{%- comment -%}
  Footer Section - E-sellers Professional (v4.9.0)
{%- endcomment -%}

{%- style -%}
  #shopify-section-{{ section.id }} {
    background-color: {{ section.settings.bg_color }};
    color: {{ section.settings.text_color }};
    padding-top: {{ section.settings.padding_top }}px;
    padding-bottom: {{ section.settings.padding_bottom }}px;
    border-top: 1px solid {{ section.settings.border_color }};
  }

  .footer {
    display: flex;
    flex-wrap: wrap;
    gap: 30px;
    justify-content: space-between;
  }

  .footer__block {
    flex: 1 1 200px;
  }

  .footer__heading {
    color: {{ section.settings.heading_color }};
    font-size: 1.1rem;
    font-weight: 600;
    margin-bottom: 16px;
  }

  .footer__menu {
    list-style: none;
    padding: 0;
    margin: 0;
  }

  .footer__menu-item {
    margin-bottom: 8px;
  }

  .footer__menu-link {
    color: {{ section.settings.text_color }};
    text-decoration: none;
    transition: color 0.2s ease;
  }

  .footer__menu-link:hover {
    color: {{ section.settings.hover_color }};
  }

  .footer__bottom {
    margin-top: 40px;
    padding-top: 20px;
    border-top: 1px solid {{ section.settings.border_color }};
    display: flex;
    justify-content: space-between;
    align-items: center;
    font-size: 0.85rem;
  }
{%- endstyle -%}

<footer class="page-width">
  <!-- Footer Main Grid -->
  <div class="footer">
    {%- for block in section.blocks -%}
      <div class="footer__block" {{ block.shopify_attributes }}>
        {%- case block.type -%}
          {%- when 'text' -%}
            {%- if block.settings.heading != blank -%}
              <h3 class="footer__heading">{{ block.settings.heading | escape }}</h3>
            {%- endif -%}
            {%- if block.settings.subtext != blank -%}
              <div class="footer__text">{{ block.settings.subtext }}</div>
            {%- endif -%}

          {%- when 'link_list' -%}
            {%- if block.settings.heading != blank -%}
              <h3 class="footer__heading">{{ block.settings.heading | escape }}</h3>
            {%- endif -%}
            {%- if block.settings.menu != blank -%}
              <ul class="footer__menu">
                {%- for link in block.settings.menu.links -%}
                  <li class="footer__menu-item">
                    <a href="{{ link.url }}" class="footer__menu-link">{{ link.title }}</a>
                  </li>
                {%- endfor -%}
              </ul>
            {%- endif -%}

          {%- when 'newsletter' -%}
            {%- if block.settings.heading != blank -%}
              <h3 class="footer__heading">{{ block.settings.heading | escape }}</h3>
            {%- endif -%}
            {%- if block.settings.subtext != blank -%}
              <div class="footer__text">{{ block.settings.subtext }}</div>
            {%- endif -%}
        {%- endcase -%}
      </div>
    {%- endfor -%}
  </div>

  <!-- Footer Bottom / Copyright -->
  <div class="footer__bottom">
    <p>&copy; {{ 'now' | date: '%Y' }} {{ shop.name }}. All rights reserved.</p>
  </div>
</footer>

{% schema %}
{
  "name": "Footer",
  "tag": "footer",
  "class": "section--footer",
  "blocks": [
    {
      "type": "text",
      "name": "Text",
      "settings": [
        {
          "type": "text",
          "id": "heading",
          "label": "Heading",
          "default": "About E-sellers"
        },
        {
          "type": "richtext",
          "id": "subtext",
          "label": "Subtext",
          "default": "<p>E-sellers Professional</p>"
        }
      ]
    },
    {
      "type": "link_list",
      "name": "Menu",
      "settings": [
        {
          "type": "text",
          "id": "heading",
          "label": "Heading",
          "default": "Quick links"
        },
        {
          "type": "link_list",
          "id": "menu",
          "label": "Menu",
          "default": "footer"
        }
      ]
    },
    {
      "type": "newsletter",
      "name": "Newsletter",
      "settings": [
        {
          "type": "text",
          "id": "heading",
          "label": "Heading",
          "default": "Newsletter"
        },
        {
          "type": "text",
          "id": "subtext",
          "label": "Subtext",
          "default": "Subscribe to our newsletter"
        }
      ]
    }
  ],
  "settings": [
    {
      "type": "color",
      "id": "bg_color",
      "label": "Background color",
      "default": "#121212"
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "Text color",
      "default": "#a1a1aa"
    },
    {
      "type": "color",
      "id": "heading_color",
      "label": "Heading color",
      "default": "#ffffff"
    },
    {
      "type": "color",
      "id": "hover_color",
      "label": "Link hover color",
      "default": "#ffffff"
    },
    {
      "type": "color",
      "id": "border_color",
      "label": "Border color",
      "default": "#27272a"
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "Top padding",
      "default": 64
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "Bottom padding",
      "default": 40
    }
  ]
}
{% endschema %}
