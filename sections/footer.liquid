<footer class="footer color-{{ section.settings.color_scheme }}" id="SiteFooter-{{ section.id }}" data-section-id="{{ section.id }}">
  <div class="page-width section-spacing footer__inner">
    {% # Footer Blocks Grid %}
    <div class="footer__blocks-grid">
      {%- for block in section.blocks -%}
        <div class="footer__block footer__block--{{ block.type }}" {{ block.shopify_attributes }}>
          {%- case block.type -%}
            {%- when 'link_list' -%}
              {%- if block.settings.heading != blank -%}
                <h3 class="footer__block-heading">{{ block.settings.heading | escape }}</h3>
              {%- endif -%}
              {%- if block.settings.menu != blank -%}
                <ul class="footer__menu-list">
                  {%- for link in block.settings.menu.links -%}
                    <li class="footer__menu-item">
                      <a href="{{ link.url }}" class="footer__menu-link">{{ link.title | escape }}</a>
                    </li>
                  {%- endfor -%}
                </ul>
              {%- endif -%}

            {%- when 'text' -%}
              {%- if block.settings.heading != blank -%}
                <h3 class="footer__block-heading">{{ block.settings.heading | escape }}</h3>
              {%- endif -%}
              {%- if block.settings.subtext != blank -%}
                <div class="footer__text-content rte">{{ block.settings.subtext }}</div>
              {%- endif -%}

            {%- when 'newsletter' -%}
              {%- if block.settings.heading != blank -%}
                <h3 class="footer__block-heading">{{ block.settings.heading | escape }}</h3>
              {%- endif -%}
              {%- if block.settings.subtext != blank -%}
                <div class="footer__text-content rte">{{ block.settings.subtext }}</div>
              {%- endif -%}

              {%- form 'customer', id: 'FooterNewsletterForm', class: 'footer__newsletter-form' -%}
                <input type="hidden" name="contact[tags]" value="newsletter">
                <div class="footer__newsletter-input-group">
                  <input
                    type="email"
                    name="contact[email]"
                    id="FooterNewsletterEmail"
                    class="field__input footer__newsletter-input"
                    value="{{ form.email }}"
                    aria-required="true"
                    autocorrect="off"
                    autocapitalize="off"
                    autocomplete="email"
                    placeholder="Enter your email"
                    required
                  >
                  <button type="submit" class="button button--primary footer__newsletter-btn" name="commit" id="FooterNewsletterSubscribe" aria-label="Subscribe">
                    <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><line x1="5" y1="12" x2="19" y2="12"></line><polyline points="12 5 19 12 12 19"></polyline></svg>
                  </button>
                </div>
                {%- if form.posted_successfully? -%}
                  <p class="footer__newsletter-success" tabindex="-1" autofocus>Thank you for subscribing!</p>
                {%- endif -%}
                {%- if form.errors -%}
                  <p class="footer__newsletter-error">{{ form.errors.translated_fields.email | capitalize }} {{ form.errors.messages.email }}</p>
                {%- endif -%}
              {%- endform -%}
          {%- endcase -%}
        </div>
      {%- endfor -%}
    </div>

    {% # Footer Bottom Bar %}
    <div class="footer__bottom">
      {% # Social Icons %}
      {%- if section.settings.show_social_icons -%}
        <div class="footer__social">
          {%- if settings.social_instagram_link != blank -%}
            <a href="{{ settings.social_instagram_link }}" class="footer__social-link" aria-label="Instagram" target="_blank" rel="noopener">
              <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="2" y="2" width="20" height="20" rx="5" ry="5"></rect><path d="M16 11.37A4 4 0 1 1 12.63 8 4 4 0 0 1 16 11.37z"></path><line x1="17.5" y1="6.5" x2="17.51" y2="6.5"></line></svg>
            </a>
          {%- endif -%}
          {%- if settings.social_tiktok_link != blank -%}
            <a href="{{ settings.social_tiktok_link }}" class="footer__social-link" aria-label="TikTok" target="_blank" rel="noopener">
              <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M9 12a4 4 0 1 0 4 4V4a5 5 0 0 0 5 5"></path></svg>
            </a>
          {%- endif -%}
          {%- if settings.social_facebook_link != blank -%}
            <a href="{{ settings.social_facebook_link }}" class="footer__social-link" aria-label="Facebook" target="_blank" rel="noopener">
              <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M18 2h-3a5 5 0 0 0-5 5v3H7v4h3v8h4v-8h3l1-4h-4V7a1 1 0 0 1 1-1h3z"></path></svg>
            </a>
          {%- endif -%}
          {%- if settings.social_youtube_link != blank -%}
            <a href="{{ settings.social_youtube_link }}" class="footer__social-link" aria-label="YouTube" target="_blank" rel="noopener">
              <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M22.54 6.42a2.78 2.78 0 0 0-1.94-2C18.88 4 12 4 12 4s-6.88 0-8.6.46a2.78 2.78 0 0 0-1.94 2A29 29 0 0 0 1 11.75a29 29 0 0 0 .46 5.33A2.78 2.78 0 0 0 3.4 19c1.72.46 8.6.46 8.6.46s6.88 0 8.6-.46a2.78 2.78 0 0 0 1.94-2 29 29 0 0 0 .46-5.25 29 29 0 0 0-.46-5.33z"></path><polygon points="9.75 15.02 15.5 11.75 9.75 8.48 9.75 15.02"></polygon></svg>
            </a>
          {%- endif -%}
        </div>
      {%- endif -%}

      {% # Payment Icons (Theme Store Mandatory Requirement) %}
      {%- if section.settings.show_payment_icons and shop.enabled_payment_types != empty -%}
        <div class="footer__payment-icons">
          {%- for type in shop.enabled_payment_types -%}
            <span class="footer__payment-icon">{{ type | payment_type_svg_tag }}</span>
          {%- endfor -%}
        </div>
      {%- endif -%}

      {% # Copyright & Powered by Shopify %}
      <div class="footer__copyright">
        <p>&copy; {{ 'now' | date: '%Y' }}, {{ shop.name | link_to: routes.root_url }}. {{ powered_by_link }}</p>
        {%- if shop.features.follow_on_shop? and section.settings.enable_follow_on_shop -%}
          <div class="footer__follow-on-shop">
            {{ shop | login_button: action: 'follow' }}
          </div>
        {%- endif -%}
      </div>
    </div>
  </div>
</footer>

<style>
  .footer {
    border-top: 1px solid var(--color-border);
    margin-top: auto;
  }
  .footer__blocks-grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: 2.5rem;
    margin-bottom: 3rem;
  }
  @media (min-width: 768px) {
    .footer__blocks-grid {
      grid-template-columns: repeat(2, 1fr);
    }
  }
  @media (min-width: 990px) {
    .footer__blocks-grid {
      grid-template-columns: repeat(4, 1fr);
    }
  }
  .footer__block-heading {
    font-size: 1.05rem;
    font-weight: 700;
    margin-bottom: 1.25rem;
  }
  .footer__menu-list {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    flex-direction: column;
    gap: 0.65rem;
  }
  .footer__menu-link {
    font-size: 0.95rem;
    color: inherit;
    opacity: 0.8;
    text-decoration: none;
    transition: opacity var(--duration-fast);
  }
  .footer__menu-link:hover {
    opacity: 1;
    color: var(--color-accent);
  }
  .footer__text-content {
    font-size: 0.95rem;
    opacity: 0.85;
    line-height: 1.6;
  }
  .footer__newsletter-form {
    margin-top: 1rem;
  }
  .footer__newsletter-input-group {
    display: flex;
    gap: 0.5rem;
  }
  .footer__newsletter-input {
    flex-grow: 1;
    margin-bottom: 0;
  }
  .footer__newsletter-btn {
    padding: 0.75rem 1.25rem;
    flex-shrink: 0;
  }
  .footer__newsletter-success {
    font-size: 0.85rem;
    color: #10B981;
    margin-top: 0.5rem;
  }
  .footer__newsletter-error {
    font-size: 0.85rem;
    color: #EF4444;
    margin-top: 0.5rem;
  }
  .footer__bottom {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 1.5rem;
    padding-top: 2rem;
    border-top: 1px solid var(--color-border);
    text-align: center;
  }
  @media (min-width: 768px) {
    .footer__bottom {
      flex-direction: row;
      justify-content: space-between;
      text-align: left;
    }
  }
  .footer__social {
    display: flex;
    gap: 0.75rem;
  }
  .footer__social-link {
    color: inherit;
    opacity: 0.75;
    transition: opacity var(--duration-fast), color var(--duration-fast);
  }
  .footer__social-link:hover {
    opacity: 1;
    color: var(--color-accent);
  }
  .footer__payment-icons {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
    align-items: center;
  }
  .footer__payment-icon svg {
    height: 24px;
    width: auto;
  }
  .footer__copyright {
    font-size: 0.85rem;
    opacity: 0.75;
  }
  .footer__copyright p {
    margin: 0;
  }
  .footer__follow-on-shop {
    margin-top: 0.5rem;
  }
</style>

{% schema %}
{
  "name": "Footer",
  "max_blocks": 5,
  "settings": [
    {
      "type": "select",
      "id": "color_scheme",
      "label": "Color scheme",
      "options": [
        { "value": "scheme-1", "label": "Scheme 1" },
        { "value": "scheme-2", "label": "Scheme 2" },
        { "value": "scheme-3", "label": "Scheme 3" },
        { "value": "scheme-4", "label": "Scheme 4" }
      ],
      "default": "scheme-4"
    },
    {
      "type": "checkbox",
      "id": "show_payment_icons",
      "label": "Show payment icons",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "show_social_icons",
      "label": "Show social media icons",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "enable_follow_on_shop",
      "label": "Enable Follow on Shop",
      "default": true
    }
  ],
  "blocks": [
    {
      "type": "link_list",
      "name": "Menu",
      "settings": [
        {
          "type": "text",
          "id": "heading",
          "label": "Heading",
          "default": "Quick links"
        },
        {
          "type": "link_list",
          "id": "menu",
          "label": "Menu",
          "default": "footer"
        }
      ]
    },
    {
      "type": "text",
      "name": "Text",
      "settings": [
        {
          "type": "text",
          "id": "heading",
          "label": "Heading",
          "default": "About our store"
        },
        {
          "type": "richtext",
          "id": "subtext",
          "label": "Subtext",
          "default": "<p>Share store details, promotions, or brand stories with your customers.</p>"
        }
      ]
    },
    {
      "type": "newsletter",
      "name": "Newsletter",
      "limit": 1,
      "settings": [
        {
          "type": "text",
          "id": "heading",
          "label": "Heading",
          "default": "Subscribe to our emails"
        },
        {
          "type": "richtext",
          "id": "subtext",
          "label": "Subtext",
          "default": "<p>Be the first to know about new collections and exclusive offers.</p>"
        }
      ]
    }
  ],
  "default": {
    "blocks": [
      { "type": "link_list" },
      { "type": "text" },
      { "type": "newsletter" }
    ]
  }
}
{% endschema %}
