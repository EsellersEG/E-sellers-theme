{%- comment -%}
  Video Section - E-sellers Professional (v4.9.0)
{%- endcomment -%}

{%- style -%}
  #shopify-section-{{ section.id }} {
    padding-top: {{ section.settings.padding_top }}px;
    padding-bottom: {{ section.settings.padding_bottom }}px;
    background-color: {{ section.settings.bg_color }};
  }

  .video-section__header {
    text-align: center;
    margin-bottom: 32px;
  }

  .video-section__heading {
    font-size: clamp(1.5rem, 3vw, 2.25rem);
    font-weight: 700;
    color: {{ section.settings.heading_color }};
    margin: 0;
  }

  .video-section__media {
    position: relative;
    width: 100%;
    max-width: 1200px;
    margin: 0 auto;
    border-radius: {{ section.settings.video_radius }}px;
    overflow: hidden;
    background: #000;
    aspect-ratio: 16 / 9;
  }

  .video-section__poster {
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    z-index: 1;
    transition: opacity 0.3s ease;
  }

  .video-section__play {
    position: absolute;
    top: 50%;
    left: 50%;
    transform: translate(-50%, -50%);
    width: 80px;
    height: 80px;
    border-radius: 50%;
    background: rgba(255, 255, 255, 0.9);
    border: none;
    display: flex;
    align-items: center;
    justify-content: center;
    cursor: pointer;
    z-index: 2;
    transition: transform 0.2s ease, background 0.2s ease;
  }

  .video-section__play:hover {
    transform: translate(-50%, -50%) scale(1.05);
    background: #ffffff;
  }

  .video-section__play svg {
    width: 32px;
    height: 32px;
    margin-left: 6px;
  }

  .video-section__iframe {
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    border: 0;
    z-index: 0;
  }

  .video-section.is-playing .video-section__poster,
  .video-section.is-playing .video-section__play {
    opacity: 0;
    pointer-events: none;
  }
{%- endstyle -%}

<div class="page-width">
  <div class="video-section" id="Video-{{ section.id }}">
    {%- if section.settings.heading != blank -%}
      <div class="video-section__header">
        <h2 class="video-section__heading">{{ section.settings.heading }}</h2>
      </div>
    {%- endif -%}

    <div class="video-section__media">
      {%- if section.settings.cover_image != blank -%}
        <img
          class="video-section__poster"
          src="{{ section.settings.cover_image | image_url: width: 1500 }}"
          alt="{{ section.settings.cover_image.alt | escape }}"
          loading="lazy"
          width="{{ section.settings.cover_image.width }}"
          height="{{ section.settings.cover_image.height }}"
        >
      {%- else -%}
        {{ 'lifestyle-2' | placeholder_svg_tag: 'placeholder-svg video-section__poster' }}
      {%- endif -%}

      <button class="video-section__play" aria-label="Play video">
        <svg viewBox="0 0 24 24" fill="currentColor">
          <path d="M8 5v14l11-7z"/>
        </svg>
      </button>

      {%- if section.settings.video_url.type == 'youtube' -%}
        <iframe
          class="video-section__iframe"
          src="https://www.youtube.com/embed/{{ section.settings.video_url.id }}?enablejsapi=1"
          allow="autoplay; encrypted-media"
          allowfullscreen
        ></iframe>
      {%- elsif section.settings.video_url.type == 'vimeo' -%}
        <iframe
          class="video-section__iframe"
          src="https://player.vimeo.com/video/{{ section.settings.video_url.id }}"
          allow="autoplay; encrypted-media"
          allowfullscreen
        ></iframe>
      {%- endif -%}
    </div>
  </div>
</div>

<script>
  document.addEventListener('DOMContentLoaded', function() {
    const section = document.querySelector('#Video-{{ section.id }}');
    if (!section) return;
    
    const playBtn = section.querySelector('.video-section__play');
    const iframe = section.querySelector('.video-section__iframe');
    
    if (playBtn && iframe) {
      playBtn.addEventListener('click', function() {
        section.classList.add('is-playing');
        let src = iframe.getAttribute('src');
        if (src.includes('youtube')) {
          iframe.contentWindow.postMessage('{"event":"command","func":"playVideo","args":""}', '*');
        } else if (src.includes('vimeo')) {
          iframe.contentWindow.postMessage('{"method":"play"}', '*');
        }
      });
    }
  });
</script>

{% schema %}
{
  "name": "Video",
  "tag": "section",
  "class": "section--video",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Video"
    },
    {
      "type": "image_picker",
      "id": "cover_image",
      "label": "Cover image"
    },
    {
      "type": "video_url",
      "id": "video_url",
      "accept": ["youtube", "vimeo"],
      "label": "URL",
      "default": "https://www.youtube.com/watch?v=_9VUPq3SxOc"
    },
    {
      "type": "range",
      "id": "video_radius",
      "min": 0,
      "max": 40,
      "step": 2,
      "unit": "px",
      "label": "Corner radius",
      "default": 12
    },
    {
      "type": "header",
      "content": "Colors"
    },
    {
      "type": "color",
      "id": "bg_color",
      "label": "Background color",
      "default": "#ffffff"
    },
    {
      "type": "color",
      "id": "heading_color",
      "label": "Heading color",
      "default": "#121212"
    },
    {
      "type": "header",
      "content": "Spacing"
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 0,
      "max": 120,
      "step": 4,
      "unit": "px",
      "label": "Top padding",
      "default": 60
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 0,
      "max": 120,
      "step": 4,
      "unit": "px",
      "label": "Bottom padding",
      "default": 60
    }
  ],
  "presets": [
    {
      "name": "Video"
    }
  ]
}
{% endschema %}
