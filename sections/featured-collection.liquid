{%- liquid
  assign collection = section.settings.collection
  assign products_to_show = section.settings.products_to_show
-%}

<section
  class="section-featured-collection color-{{ section.settings.color_scheme }}"
  id="FeaturedCollection-{{ section.id }}"
  data-section-id="{{ section.id }}"
>
  <div class="page-width section-spacing">
    <div class="section-header" style="display: flex; align-items: flex-end; justify-content: space-between; margin-bottom: 2.5rem; flex-wrap: wrap; gap: 1rem;">
      <div>
        {%- if section.settings.subheading != blank -%}
          <span class="text-subheading">{{ section.settings.subheading | escape }}</span>
        {%- endif -%}
        {%- if section.settings.title != blank -%}
          <h2 class="h2" style="margin-bottom: 0;">{{ section.settings.title | escape }}</h2>
        {%- endif -%}
      </div>

      {%- if section.settings.show_view_all and collection != blank -%}
        <a href="{{ collection.url }}" class="button button--outline button--sm">
          {{ 'collections.title' | t }} &rarr;
        </a>
      {%- endif -%}
    </div>

    <div class="grid grid--{{ section.settings.columns_desktop }}-col grid--gap-md">
      {%- if collection != blank and collection.products_count > 0 -%}
        {%- for product in collection.products limit: products_to_show -%}
          <div class="grid__item">
            {% render 'product-card',
              product_card_product: product,
              media_aspect_ratio: section.settings.image_ratio,
              show_secondary_image: section.settings.show_secondary_image,
              show_vendor: section.settings.show_vendor,
              show_swatches: section.settings.show_swatches,
              show_quick_buy: section.settings.show_quick_buy
            %}
          </div>
        {%- endfor -%}
      {%- else -%}
        {%- for i in (1..products_to_show) -%}
          <div class="grid__item">
            <div class="product-card">
              <div class="product-card__media-wrap product-card__media-wrap--portrait">
                <div class="product-card__placeholder">
                  {%- capture placeholder_index -%}{% cycle '1', '2', '3', '4', '5', '6' %}{%- endcapture -%}
                  {{ 'product-' | append: placeholder_index | placeholder_svg_tag: 'placeholder-svg' }}
                </div>
              </div>
              <div class="product-card__info">
                <h3 class="product-card__title">Sample Product Title {{ i }}</h3>
                <div class="product-card__price">$29.00</div>
              </div>
            </div>
          </div>
        {%- endfor -%}
      {%- endif -%}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Featured collection",
  "settings": [
    {
      "type": "select",
      "id": "color_scheme",
      "label": "Color scheme",
      "options": [
        { "value": "scheme-1", "label": "Scheme 1" },
        { "value": "scheme-2", "label": "Scheme 2" },
        { "value": "scheme-3", "label": "Scheme 3" },
        { "value": "scheme-4", "label": "Scheme 4" }
      ],
      "default": "scheme-1"
    },
    {
      "type": "text",
      "id": "subheading",
      "label": "Subheading",
      "default": "Curated Selection"
    },
    {
      "type": "text",
      "id": "title",
      "label": "Heading",
      "default": "Featured Collection"
    },
    {
      "type": "collection",
      "id": "collection",
      "label": "Collection"
    },
    {
      "type": "range",
      "id": "products_to_show",
      "min": 2,
      "max": 12,
      "step": 2,
      "label": "Maximum products to show",
      "default": 4
    },
    {
      "type": "select",
      "id": "columns_desktop",
      "label": "Columns on desktop",
      "options": [
        { "value": "3", "label": "3 columns" },
        { "value": "4", "label": "4 columns" },
        { "value": "5", "label": "5 columns" }
      ],
      "default": "4"
    },
    {
      "type": "checkbox",
      "id": "show_view_all",
      "label": "Show \"View all\" button",
      "default": true
    },
    {
      "type": "select",
      "id": "image_ratio",
      "label": "Image ratio",
      "options": [
        { "value": "portrait", "label": "Portrait (3:4)" },
        { "value": "square", "label": "Square (1:1)" },
        { "value": "adapt", "label": "Adapt to image" }
      ],
      "default": "portrait"
    },
    {
      "type": "checkbox",
      "id": "show_secondary_image",
      "label": "Show second image on hover",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "show_vendor",
      "label": "Show vendor",
      "default": false
    },
    {
      "type": "checkbox",
      "id": "show_swatches",
      "label": "Show swatches",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "show_quick_buy",
      "label": "Show quick add button",
      "default": true
    }
  ],
  "presets": [
    {
      "name": "Featured collection"
    }
  ]
}
{% endschema %}
