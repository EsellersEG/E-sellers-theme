{%- comment -%}
  Announcement Bar Section - E-sellers Professional (v4.9.0)
{%- endcomment -%}

{%- style -%}
  #shopify-section-{{ section.id }} {
    background-color: {{ section.settings.bg_color }};
    color: {{ section.settings.text_color }};
    border-bottom: 1px solid {{ section.settings.border_color }};
    font-size: {{ section.settings.font_size }}px;
  }

  #shopify-section-{{ section.id }} a {
    color: {{ section.settings.link_color }};
    text-decoration: underline;
    text-underline-offset: 2px;
  }

  .announcement-bar {
    display: flex;
    align-items: center;
    justify-content: center;
    min-height: 40px;
    padding: 8px 16px;
    text-align: center;
    position: relative;
    overflow: hidden;
  }

  .announcement-bar__content {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 16px;
    width: 100%;
    font-weight: 500;
    line-height: 1.3;
  }

  .announcement-bar__socials {
    display: none;
    align-items: center;
    gap: 12px;
    position: absolute;
    left: 20px;
  }

  @media screen and (min-width: 990px) {
    .announcement-bar__socials {
      display: flex;
    }
  }

  .announcement-bar__socials a {
    color: {{ section.settings.text_color }} !important;
    text-decoration: none !important;
    display: flex;
    transition: opacity 0.2s;
  }

  .announcement-bar__socials a:hover {
    opacity: 0.7;
  }
{%- endstyle -%}

<div class="announcement-bar page-width" role="region" aria-label="{{ 'sections.announcement.announcement' | t }}">
  {%- if section.settings.show_social -%}
    <div class="announcement-bar__socials">
      {%- if settings.social_facebook_link != blank -%}
        <a href="{{ settings.social_facebook_link }}" aria-label="Facebook">{% render 'icon', name: 'facebook' %}</a>
      {%- endif -%}
      {%- if settings.social_instagram_link != blank -%}
        <a href="{{ settings.social_instagram_link }}" aria-label="Instagram">{% render 'icon', name: 'instagram' %}</a>
      {%- endif -%}
      {%- if settings.social_twitter_link != blank -%}
        <a href="{{ settings.social_twitter_link }}" aria-label="Twitter">{% render 'icon', name: 'twitter' %}</a>
      {%- endif -%}
      {%- if settings.social_tiktok_link != blank -%}
        <a href="{{ settings.social_tiktok_link }}" aria-label="TikTok">{% render 'icon', name: 'tiktok' %}</a>
      {%- endif -%}
    </div>
  {%- endif -%}

  <div class="announcement-bar__content">
    {%- for block in section.blocks -%}
      <div class="announcement-bar__message" {{ block.shopify_attributes }}>
        {%- if block.settings.link != blank -%}
          <a href="{{ block.settings.link }}">
            {{ block.settings.text | escape }}
          </a>
        {%- else -%}
          <span>{{ block.settings.text | escape }}</span>
        {%- endif -%}
      </div>
    {%- endfor -%}
  </div>
</div>

{% schema %}
{
  "name": "Announcement Bar",
  "max_blocks": 5,
  "settings": [
    {
      "type": "header",
      "content": "Section Colors"
    },
    {
      "type": "color",
      "id": "bg_color",
      "label": "Background color",
      "default": "#121212"
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "Text color",
      "default": "#ffffff"
    },
    {
      "type": "color",
      "id": "link_color",
      "label": "Link color",
      "default": "#ffffff"
    },
    {
      "type": "color",
      "id": "border_color",
      "label": "Bottom border color",
      "default": "transparent"
    },
    {
      "type": "range",
      "id": "font_size",
      "min": 11,
      "max": 16,
      "step": 1,
      "unit": "px",
      "label": "Font size",
      "default": 13
    },
    {
      "type": "checkbox",
      "id": "show_social",
      "label": "Show social media icons on desktop",
      "default": false
    }
  ],
  "blocks": [
    {
      "type": "announcement",
      "name": "Announcement",
      "settings": [
        {
          "type": "text",
          "id": "text",
          "label": "Announcement text",
          "default": "⚡ FREE Express Shipping on all orders over $100!"
        },
        {
          "type": "url",
          "id": "link",
          "label": "Link (optional)"
        }
      ]
    }
  ],
  "default": {
    "blocks": [
      {
        "type": "announcement"
      }
    ]
  }
}
{% endschema %}
