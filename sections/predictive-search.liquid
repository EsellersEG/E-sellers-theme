{%- comment -%}
  Predictive Search Section - E-sellers Professional (v4.9.0)
{%- endcomment -%}

{%- if predictive_search.performed -%}
  <div id="predictive-search-results">
    {%- if predictive_search.resources.products.size > 0 -%}
      <div class="predictive-search__group">
        <h3 class="predictive-search__group-title">{{ 'general.search.products' | t }}</h3>
        <ul class="predictive-search__list">
          {%- for product in predictive_search.resources.products -%}
            <li>
              <a href="{{ product.url }}" class="predictive-search__item">
                {%- if product.featured_media -%}
                  <img
                    src="{{ product.featured_media | image_url: width: 120 }}"
                    alt="{{ product.title | escape }}"
                    class="predictive-search__item-img"
                    loading="lazy"
                    width="50"
                    height="60"
                  >
                {%- endif -%}
                <div class="predictive-search__item-info">
                  <div class="predictive-search__item-title">{{ product.title | escape }}</div>
                  <div class="predictive-search__item-price" style="font-size: 1.3rem; color: #71717a; margin-top: 2px;">
                    {{ product.price | money }}
                  </div>
                </div>
              </a>
            </li>
          {%- endfor -%}
        </ul>
      </div>
    {%- endif -%}

    {%- if predictive_search.resources.collections.size > 0 -%}
      <div class="predictive-search__group" style="margin-top: 20px;">
        <h3 class="predictive-search__group-title">{{ 'general.search.collections' | t }}</h3>
        <ul class="predictive-search__list">
          {%- for collection in predictive_search.resources.collections -%}
            <li>
              <a href="{{ collection.url }}" class="predictive-search__item">
                <span class="predictive-search__item-title">{{ collection.title | escape }}</span>
              </a>
            </li>
          {%- endfor -%}
        </ul>
      </div>
    {%- endif -%}

    {%- if predictive_search.resources.products.size == 0 and predictive_search.resources.collections.size == 0 -%}
      <div style="text-align: center; padding: 32px 16px; color: #71717a;">
        <p>{{ 'general.search.no_results' | t: terms: predictive_search.terms }}</p>
      </div>
    {%- endif -%}

    <div class="predictive-search__footer">
      <a href="{{ routes.search_url }}?q={{ predictive_search.terms }}&options%5Bprefix%5D=last" class="predictive-search__view-all">
        {{ 'general.search.view_all_results' | t }} &rarr;
      </a>
    </div>
  </div>
{%- else -%}
  {{ 'component-predictive-search.css' | asset_url | stylesheet_tag }}
  <script src="{{ 'component-predictive-search.js' | asset_url }}" defer="defer"></script>

  <predictive-search id="SearchModal" class="search-modal" role="dialog" aria-modal="true" aria-label="{{ 'general.search.search' | t }}" aria-hidden="true">
    <div class="search-modal__content">
      <form action="{{ routes.search_url }}" method="get" role="search" class="search-modal__header">
        <span style="color: #71717a; display: flex;">{% render 'icon', name: 'search' %}</span>
        <input
          type="search"
          name="q"
          id="SearchInput"
          class="search-modal__input"
          placeholder="{{ 'general.search.placeholder' | t }}"
          autocomplete="off"
          autocorrect="off"
          autocapitalize="off"
          spellcheck="false"
        >
        <div class="search-modal__spinner spinner" style="display: none; border-color: rgba(0,0,0,0.2); border-top-color: #121212;"></div>
        <button type="button" class="search-modal__close" aria-label="{{ 'general.accessibility.close' | t }}">
          {% render 'icon', name: 'close' %}
        </button>
      </form>

      <div id="PredictiveSearchResults" class="predictive-search__results"></div>
    </div>
  </predictive-search>
{%- endif -%}

{% schema %}
{
  "name": "Predictive Search",
  "settings": []
}
{% endschema %}
