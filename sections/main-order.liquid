{%- comment -%}
  Main Order Details Section - E-sellers Professional (v4.9.0)
{%- endcomment -%}

{%- style -%}
  #shopify-section-{{ section.id }} {
    background-color: {{ section.settings.bg_color }};
    color: {{ section.settings.text_color }};
    --section-heading-color: {{ section.settings.heading_color }};
    padding-top: {{ section.settings.padding_top }}px;
    padding-bottom: {{ section.settings.padding_bottom }}px;
  }

  .order-table {
    width: 100%;
    border-collapse: collapse;
    margin: 24px 0;
  }

  .order-table th {
    text-align: left;
    padding: 12px 0;
    border-bottom: 1px solid #e2e8f0;
    font-size: 1.3rem;
    font-weight: 700;
    color: #71717a;
    text-transform: uppercase;
  }

  .order-table td {
    padding: 16px 0;
    border-bottom: 1px solid #e2e8f0;
    font-size: 1.4rem;
  }
{%- endstyle -%}

<div class="page-width">
  <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 24px;">
    <div>
      <h1 class="h2" style="margin: 0;">{{ 'customer.orders.order_number' | t: name: order.name }}</h1>
      <p style="color: #71717a; margin-top: 4px; font-size: 1.4rem;">
        Placed on {{ order.created_at | date: "%B %d, %Y at %I:%M %p" }}
      </p>
    </div>
    <a href="{{ routes.account_url }}" class="link" style="font-weight: 600; font-size: 1.4rem;">
      &larr; {{ 'customer.account.return' | t }}
    </a>
  </div>

  <table class="order-table">
    <thead>
      <tr>
        <th>Product</th>
        <th>SKU</th>
        <th>Price</th>
        <th>Quantity</th>
        <th style="text-align: right;">Total</th>
      </tr>
    </thead>
    <tbody>
      {%- for line_item in order.line_items -%}
        <tr>
          <td>
            <span style="font-weight: 600;">{{ line_item.title }}</span>
          </td>
          <td>{{ line_item.sku }}</td>
          <td>{{ line_item.final_price | money }}</td>
          <td>{{ line_item.quantity }}</td>
          <td style="text-align: right; font-weight: 700;">{{ line_item.final_line_price | money }}</td>
        </tr>
      {%- endfor -%}
    </tbody>
    <tfoot>
      <tr>
        <td colspan="4" style="text-align: right; font-weight: 600;">Subtotal</td>
        <td style="text-align: right; font-weight: 600;">{{ order.line_items_subtotal_price | money }}</td>
      </tr>
      <tr>
        <td colspan="4" style="text-align: right; font-weight: 700; font-size: 1.6rem;">Total</td>
        <td style="text-align: right; font-weight: 800; font-size: 1.8rem;">{{ order.total_price | money_with_currency }}</td>
      </tr>
    </tfoot>
  </table>
</div>

{% schema %}
{
  "name": "Order Details",
  "settings": [
    {
      "type": "header",
      "content": "Section Colors (Independent)"
    },
    {
      "type": "color",
      "id": "bg_color",
      "label": "Background color",
      "default": "#ffffff"
    },
    {
      "type": "color",
      "id": "heading_color",
      "label": "Heading color",
      "default": "#121212"
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "Text color",
      "default": "#121212"
    },
    {
      "type": "header",
      "content": "Section Spacing"
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 20,
      "max": 100,
      "step": 5,
      "unit": "px",
      "label": "Top padding",
      "default": 40
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 20,
      "max": 100,
      "step": 5,
      "unit": "px",
      "label": "Bottom padding",
      "default": 60
    }
  ]
}
{% endschema %}
