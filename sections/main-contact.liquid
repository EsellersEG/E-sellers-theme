<section class="section-main-contact color-{{ section.settings.color_scheme }}" id="MainContact-{{ section.id }}" data-section-id="{{ section.id }}">
  <div class="page-width page-width--narrow section-spacing">
    <h1 class="page-title text-center" style="margin-bottom: 1rem;">{{ page.title | default: 'Contact Us' | escape }}</h1>

    {%- if page.content != blank -%}
      <div class="page-content rte text-center" style="margin-bottom: 2.5rem; opacity: 0.85;">
        {{ page.content }}
      </div>
    {%- endif -%}

    <div class="contact-form-container color-scheme-2" style="padding: 2.5rem; border-radius: var(--radius-card); border: 1px solid var(--color-border);">
      {%- form 'contact', id: 'ContactForm', class: 'contact-form' -%}
        {%- if form.posted_successfully? -%}
          <div class="form-success" style="color: #10B981; margin-bottom: 1.5rem; text-align: center; font-weight: 600;">
            Thank you for reaching out! We will get back to you shortly.
          </div>
        {%- endif -%}

        {%- if form.errors -%}
          <div class="form-error" style="color: #EF4444; margin-bottom: 1.5rem;">
            Please review the required fields below.
          </div>
        {%- endif -%}

        <div class="grid grid--2-col grid--gap-sm">
          <div class="field">
            <label class="field__label" for="ContactFormName">Name *</label>
            <input
              type="text"
              name="contact[name]"
              id="ContactFormName"
              class="field__input"
              value="{% if form.name %}{{ form.name }}{% elsif customer %}{{ customer.name }}{% endif %}"
              placeholder="Your name"
              required
            >
          </div>

          <div class="field">
            <label class="field__label" for="ContactFormEmail">Email *</label>
            <input
              type="email"
              name="contact[email]"
              id="ContactFormEmail"
              class="field__input"
              value="{% if form.email %}{{ form.email }}{% elsif customer %}{{ customer.email }}{% endif %}"
              placeholder="Your email address"
              required
            >
          </div>
        </div>

        <div class="field">
          <label class="field__label" for="ContactFormPhone">Phone number (optional)</label>
          <input
            type="tel"
            name="contact[phone]"
            id="ContactFormPhone"
            class="field__input"
            value="{% if form.phone %}{{ form.phone }}{% elsif customer %}{{ customer.phone }}{% endif %}"
            placeholder="Your phone number"
          >
        </div>

        <div class="field">
          <label class="field__label" for="ContactFormMessage">Message *</label>
          <textarea
            rows="6"
            name="contact[body]"
            id="ContactFormMessage"
            class="field__textarea"
            placeholder="How can we help you?"
            required
          >{{ form.body }}</textarea>
        </div>

        <button type="submit" class="button button--primary button--lg button--full-width" style="margin-top: 1rem;">
          Send message
        </button>
      {%- endform -%}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Contact form",
  "settings": [
    {
      "type": "select",
      "id": "color_scheme",
      "label": "Color scheme",
      "options": [
        { "value": "scheme-1", "label": "Scheme 1" },
        { "value": "scheme-2", "label": "Scheme 2" },
        { "value": "scheme-3", "label": "Scheme 3" },
        { "value": "scheme-4", "label": "Scheme 4" }
      ],
      "default": "scheme-1"
    }
  ]
}
{% endschema %}
