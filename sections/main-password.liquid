{%- comment -%}
  Main Password Section - E-sellers Professional (v4.9.0)
{%- endcomment -%}

{%- style -%}
  #shopify-section-{{ section.id }} {
    background-color: {{ section.settings.bg_color }};
    color: {{ section.settings.text_color }};
    min-height: 100vh;
    display: flex;
    align-items: center;
    justify-content: center;
    padding: 40px 20px;
    text-align: center;
  }

  .password-card {
    max-width: 540px;
    margin: 0 auto;
    background-color: #ffffff;
    border-radius: var(--card-radius, 16px);
    box-shadow: 0 20px 40px rgba(0,0,0,0.1);
    padding: 48px 32px;
    color: #121212;
  }
{%- endstyle -%}

<div class="password-card">
  <h1 class="h2" style="margin-bottom: 12px;">{{ shop.name }}</h1>
  <p style="font-size: 1.5rem; color: #71717a; margin-bottom: 24px;">{{ 'templates.password.title' | t }}</p>

  {%- if shop.password_message != blank -%}
    <div style="font-size: 1.5rem; line-height: 1.6; margin-bottom: 24px;">
      {{ shop.password_message }}
    </div>
  {%- endif -%}

  {%- form 'storefront_password' -%}
    {%- if form.errors -%}
      <div style="padding: 12px; background-color: #fef2f2; color: #dc2626; border-radius: 8px; margin-bottom: 16px;">
        {{ form.errors | default_errors }}
      </div>
    {%- endif -%}

    <div class="field" style="margin-bottom: 16px;">
      <input
        type="password"
        name="password"
        id="Password"
        class="field__input"
        autocomplete="current-password"
        placeholder="{{ 'templates.password.password' | t }}"
        required
      >
    </div>

    <button type="submit" name="commit" class="button button--primary button--full-width">
      {{ 'templates.password.submit' | t }}
    </button>

    <div style="margin-top: 24px; font-size: 1.3rem; color: #71717a;">
      {{ 'templates.password.admin_link_html' | t }}
    </div>
  {%- endform -%}
</div>

{% schema %}
{
  "name": "Password Page",
  "settings": [
    {
      "type": "color",
      "id": "bg_color",
      "label": "Background color",
      "default": "#121212"
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "Text color",
      "default": "#ffffff"
    }
  ]
}
{% endschema %}
