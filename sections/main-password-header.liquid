{%- comment -%}
  Main Password Header Section - E-sellers Professional (v4.9.0)
{%- endcomment -%}

{%- style -%}
  #shopify-section-{{ section.id }} {
    padding-top: {{ section.settings.padding_top | default: 24 }}px;
    padding-bottom: {{ section.settings.padding_bottom | default: 24 }}px;
    background-color: {{ section.settings.background | default: '#ffffff' }};
    border-bottom: 1px solid {{ section.settings.border_color | default: '#e2e8f0' }};
    position: relative;
    z-index: 100;
  }

  .es-password-header {
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: 20px;
  }

  .es-password-logo {
    display: flex;
    align-items: center;
    text-decoration: none;
    color: #0f172a;
    font-size: 1.4rem;
    font-weight: 700;
  }

  .es-password-logo__img {
    max-width: {{ section.settings.logo_width | default: 140 }}px;
    height: auto;
    display: block;
  }

  /* Unlock Trigger */
  .es-password-unlock-btn {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    padding: 8px 16px;
    border-radius: 8px;
    border: 1px solid #cbd5e1;
    background: transparent;
    color: #0f172a;
    font-size: 0.9rem;
    font-weight: 600;
    cursor: pointer;
    transition: all 0.2s ease;
  }

  .es-password-unlock-btn:hover {
    background-color: #f8fafc;
    border-color: #0f172a;
  }

  /* Password Modal */
  .es-password-modal {
    display: none;
    position: fixed;
    inset: 0;
    background: rgba(15, 23, 42, 0.6);
    backdrop-filter: blur(6px);
    z-index: 999;
    align-items: center;
    justify-content: center;
    padding: 20px;
    box-sizing: border-box;
  }

  .es-password-modal.is-open {
    display: flex;
  }

  .es-password-modal__box {
    max-width: 440px;
    width: 100%;
    background: #ffffff;
    border-radius: 16px;
    padding: 36px 28px;
    box-shadow: 0 20px 50px rgba(0, 0, 0, 0.25);
    position: relative;
    text-align: center;
    box-sizing: border-box;
  }

  .es-password-modal__close {
    position: absolute;
    top: 16px;
    right: 16px;
    background: none;
    border: none;
    font-size: 1.5rem;
    color: #64748b;
    cursor: pointer;
    padding: 4px;
    line-height: 1;
  }

  .es-password-modal__close:hover {
    color: #0f172a;
  }

  .es-password-modal__title {
    font-size: 1.4rem;
    font-weight: 700;
    margin: 0 0 8px 0;
    color: #0f172a;
  }

  .es-password-form {
    display: flex;
    flex-direction: column;
    gap: 12px;
    margin-top: 20px;
  }

  .es-password-form__input {
    width: 100%;
    padding: 12px 16px;
    border: 1px solid #cbd5e1;
    border-radius: 8px;
    font-size: 0.95rem;
    color: #0f172a;
    outline: none;
    box-sizing: border-box;
  }

  .es-password-form__input:focus {
    border-color: #0f172a;
  }

  .es-password-form__btn {
    width: 100%;
    padding: 12px 20px;
    background-color: #0f172a;
    color: #ffffff;
    border: none;
    border-radius: 8px;
    font-weight: 700;
    font-size: 0.95rem;
    cursor: pointer;
    transition: background-color 0.2s ease;
  }

  .es-password-form__btn:hover {
    background-color: #1e293b;
  }

  .es-password-error {
    background: #fef2f2;
    border: 1px solid #fecaca;
    color: #991b1b;
    padding: 10px 14px;
    border-radius: 6px;
    font-size: 0.85rem;
    margin-top: 8px;
  }
{%- endstyle -%}

<div class="page-width">
  <div class="es-password-header">
    
    <!-- Logo -->
    <a href="{{ routes.root_url }}" class="es-password-logo">
      {%- if section.settings.logo != blank -%}
        <img
          src="{{ section.settings.logo | image_url: width: 600 }}"
          alt="{{ shop.name | escape }}"
          class="es-password-logo__img"
          loading="eager"
        >
      {%- elsif settings.logo != blank -%}
        <img
          src="{{ settings.logo | image_url: width: 600 }}"
          alt="{{ shop.name | escape }}"
          class="es-password-logo__img"
          loading="eager"
        >
      {%- else -%}
        {{ shop.name }}
      {%- endif -%}
    </a>

    <!-- Unlock Storefront Trigger -->
    <button type="button" class="es-password-unlock-btn" onclick="document.getElementById('StorefrontPasswordModal').classList.add('is-open')">
      <svg viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="currentColor" stroke-width="2.5"><rect x="3" y="11" width="18" height="11" rx="2" ry="2"></rect><path d="M7 11V7a5 5 0 0 1 10 0v4"></path></svg>
      <span>{{ 'general.password_page.login_password_button' | t | default: 'Enter using password' }}</span>
    </button>

  </div>
</div>

<!-- Unlock Modal -->
<div id="StorefrontPasswordModal" class="es-password-modal {% if form.errors %}is-open{% endif %}" role="dialog" aria-modal="true" onclick="if(event.target === this) this.classList.remove('is-open')">
  <div class="es-password-modal__box">
    <button type="button" class="es-password-modal__close" aria-label="Close" onclick="document.getElementById('StorefrontPasswordModal').classList.remove('is-open')">
      &times;
    </button>

    <h2 class="es-password-modal__title">{{ 'general.password_page.login_form_heading' | t | default: 'Enter Store Password' }}</h2>
    <p style="font-size: 0.9rem; color: #64748b; margin: 0;">Enter your store access code below to preview the storefront.</p>

    {%- form 'storefront_password', class: 'es-password-form' -%}
      <input
        type="password"
        name="password"
        id="StorefrontPassword"
        class="es-password-form__input"
        placeholder="{{ 'general.password_page.login_form_password_placeholder' | t | default: 'Password' }}"
        autocomplete="current-password"
        required
      >

      <button type="submit" class="es-password-form__btn">
        {{ 'general.password_page.login_form_submit' | t | default: 'Enter Store' }}
      </button>

      {%- if form.errors -%}
        <div class="es-password-error" role="alert">
          {{ 'general.password_page.login_form_error' | t | default: 'Incorrect password! Please try again.' }}
        </div>
      {%- endif -%}
    {%- endform -%}

    <p style="font-size: 0.8rem; color: #94a3b8; margin: 16px 0 0 0;">
      Are you the store owner? <a href="/admin" style="color: #0f172a; text-decoration: underline;">Log in here</a>
    </p>
  </div>
</div>

{% schema %}
{
  "name": "Password header",
  "tag": "section",
  "class": "shopify-section--main-password-header",
  "enabled_on": {
    "templates": ["password"]
  },
  "settings": [
    {
      "type": "image_picker",
      "id": "logo",
      "label": "Logo image"
    },
    {
      "type": "range",
      "id": "logo_width",
      "min": 50,
      "max": 300,
      "step": 5,
      "unit": "px",
      "label": "Logo width",
      "default": 140
    },
    {
      "type": "header",
      "content": "Colors & Padding"
    },
    {
      "type": "color",
      "id": "background",
      "label": "Background color",
      "default": "#ffffff"
    },
    {
      "type": "color",
      "id": "border_color",
      "label": "Bottom border color",
      "default": "#e2e8f0"
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 0,
      "max": 60,
      "step": 2,
      "unit": "px",
      "label": "Top padding",
      "default": 24
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 0,
      "max": 60,
      "step": 2,
      "unit": "px",
      "label": "Bottom padding",
      "default": 24
    }
  ]
}
{% endschema %}
