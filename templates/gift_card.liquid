{% layout none %}

<!doctype html>
<html lang="{{ request.locale.iso_code }}">
  <head>
    <meta charset="utf-8">
    <meta http-equiv="X-UA-Compatible" content="IE=edge">
    <meta name="viewport" content="width=device-width,initial-scale=1">
    <title>{{ 'gift_card.title' | t }} - {{ shop.name }}</title>

    {% # Inlined CSS Variables %}
    {% render 'css-variables' %}
    {{ 'critical.css' | asset_url | stylesheet_tag: preload: true }}
    {{ 'base.css' | asset_url | stylesheet_tag }}

    <script src="{{ 'vendor/qrcode.js' | shopify_asset_url }}" defer="defer"></script>

    {{ content_for_header }}
  </head>

  <body class="color-scheme-1" style="display: flex; align-items: center; justify-content: center; min-height: 100vh; padding: 2rem 1rem;">
    <main class="gift-card-container color-scheme-2" style="max-width: 500px; width: 100%; text-align: center; padding: 2.5rem 2rem; border-radius: var(--radius-card); border: 1px solid var(--color-border); box-shadow: var(--shadow-xl);">
      <h1 class="gift-card__shop" style="font-size: 1.5rem; margin-bottom: 0.5rem;">{{ shop.name }}</h1>
      <p class="text-subheading">{{ 'gift_card.card' | t }}</p>

      <div class="gift-card__amount" style="font-size: 2.5rem; font-weight: 800; margin: 1.25rem 0; color: var(--color-accent);">
        {{ gift_card.balance | money }}
      </div>

      {%- if gift_card.enabled == false or gift_card.expired -%}
        <div class="badge badge--soldout" style="margin-bottom: 1rem;">
          {{ 'gift_card.expired' | t }}
        </div>
      {%- endif -%}

      {%- if gift_card.expires_on -%}
        <p class="text-muted" style="font-size: 0.85rem; margin-bottom: 1rem;">
          {{ 'gift_card.expires_on' | t: expires_on: gift_card.expires_on | date: '%B %d, %Y' }}
        </p>
      {%- endif -%}

      <div class="gift-card__code-box" style="padding: 1rem; background-color: var(--color-bg); border-radius: var(--radius-input); border: 2px dashed var(--color-border); margin-bottom: 1.5rem;">
        <input
          type="text"
          class="gift-card__code"
          value="{{ gift_card.code | format_code }}"
          aria-label="Gift card code"
          readonly
          id="GiftCardCode"
          style="border: none; background: transparent; font-size: 1.25rem; font-weight: 700; letter-spacing: 0.1em; text-align: center; width: 100%; color: inherit;"
        >
      </div>

      <button type="button" class="button button--secondary button--sm" id="CopyCodeBtn" style="margin-bottom: 2rem;">
        {{ 'gift_card.copy_code' | t }}
      </button>

      {% # QR Code (Minimum 120x120px as required by Theme Store) %}
      <div class="gift-card__qr" id="QrCode" style="display: flex; justify-content: center; margin-bottom: 2rem;" data-identifier="{{ gift_card.qr_identifier }}"></div>

      <p class="text-muted" style="font-size: 0.9rem; margin-bottom: 1.5rem;">
        {{ 'gift_card.use_at_checkout' | t }}
      </p>

      <a href="{{ shop.url }}" class="button button--primary button--full-width" target="_blank" rel="noopener">
        {{ '404.back_to_shopping' | t }}
      </a>

      {%- if gift_card.pass_url -%}
        <div style="margin-top: 1.5rem;">
          <a href="{{ gift_card.pass_url }}" class="gift-card__apple-wallet">
            <img src="{{ 'gift-card/add-to-apple-wallet.svg' | shopify_asset_url }}" width="150" height="45" alt="{{ 'gift_card.add_to_apple_wallet' | t }}" loading="lazy">
          </a>
        </div>
      {%- endif -%}
    </main>

    <script>
      document.addEventListener('DOMContentLoaded', function() {
        const qrEl = document.getElementById('QrCode');
        if (qrEl && window.QRCode) {
          new QRCode(qrEl, {
            text: qrEl.dataset.identifier,
            width: 140,
            height: 140
          });
        }

        const copyBtn = document.getElementById('CopyCodeBtn');
        const codeInput = document.getElementById('GiftCardCode');
        if (copyBtn && codeInput) {
          copyBtn.addEventListener('click', function() {
            navigator.clipboard.writeText(codeInput.value.replace(/\s/g, '')).then(function() {
              copyBtn.textContent = 'Copied!';
              setTimeout(function() { copyBtn.textContent = 'Copy code'; }, 2500);
            });
          });
        }
      });
    </script>
  </body>
</html>
