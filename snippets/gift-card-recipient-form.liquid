{% comment %}
  Renders gift card recipient form
  Accepts:
  - product: {Object} product Liquid object
  - form: {Object} product form Liquid object
  - section: {Object} section Liquid object
{% endcomment %}

<div class="recipient-form" data-section-id="{{ section.id }}">
  <input
    type="hidden"
    name="properties[__shopify_send_gift_card_to_recipient]"
    value="if_present"
    id="RecipientControl-{{ section.id }}"
  >

  <label class="recipient-checkbox" for="RecipientCheckbox-{{ section.id }}">
    <input
      type="checkbox"
      id="RecipientCheckbox-{{ section.id }}"
      name="properties[__shopify_offset]"
      disabled
    >
    <span>{{ 'products.product.recipient.form.checkbox' | t }}</span>
  </label>

  <div class="recipient-fields is-hidden" id="RecipientFields-{{ section.id }}">
    <div class="field">
      <label class="field__label" for="RecipientEmail-{{ section.id }}">
        {{ 'products.product.recipient.form.email_label' | t }} *
      </label>
      <input
        class="field__input"
        id="RecipientEmail-{{ section.id }}"
        type="email"
        placeholder="recipient@example.com"
        name="properties[Recipient email]"
        value="{{ form.email }}"
      >
    </div>

    <div class="field">
      <label class="field__label" for="RecipientName-{{ section.id }}">
        {{ 'products.product.recipient.form.name_label' | t }}
      </label>
      <input
        class="field__input"
        id="RecipientName-{{ section.id }}"
        type="text"
        placeholder="Recipient name"
        name="properties[Recipient name]"
        value="{{ form.name }}"
      >
    </div>

    <div class="field">
      <label class="field__label" for="RecipientMessage-{{ section.id }}">
        {{ 'products.product.recipient.form.message_label' | t }}
      </label>
      <textarea
        rows="4"
        id="RecipientMessage-{{ section.id }}"
        class="field__textarea"
        name="properties[Recipient message]"
        placeholder="Add a personalized message..."
      >{{ form.message }}</textarea>
    </div>

    <div class="field">
      <label class="field__label" for="RecipientSendOn-{{ section.id }}">
        {{ 'products.product.recipient.form.send_on_label' | t }}
      </label>
      <input
        class="field__input"
        id="RecipientSendOn-{{ section.id }}"
        type="date"
        name="properties[Send on]"
        pattern="\d{4}-\d{2}-\d{2}"
      >
    </div>
  </div>
</div>

<style>
  .recipient-form {
    margin-top: 1rem;
    margin-bottom: 1.25rem;
    padding: 1rem;
    background-color: rgba(0, 0, 0, 0.02);
    border-radius: var(--radius-input);
    border: 1px solid var(--color-border);
  }
  .recipient-checkbox {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    cursor: pointer;
    font-weight: 500;
  }
  .recipient-fields {
    margin-top: 1rem;
  }
  .recipient-fields.is-hidden {
    display: none;
  }
</style>

<script>
  document.addEventListener('DOMContentLoaded', () => {
    const cb = document.getElementById('RecipientCheckbox-{{ section.id }}');
    const fields = document.getElementById('RecipientFields-{{ section.id }}');
    const ctrl = document.getElementById('RecipientControl-{{ section.id }}');

    if (cb && fields) {
      cb.removeAttribute('disabled');
      cb.addEventListener('change', () => {
        if (cb.checked) {
          fields.classList.remove('is-hidden');
          ctrl.disabled = false;
        } else {
          fields.classList.add('is-hidden');
          ctrl.disabled = true;
        }
      });
    }
  });
</script>
