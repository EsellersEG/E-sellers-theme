{% comment %}
  Renders product card
  Accepts:
  - product_card_product: {Object} Product Liquid object
  - media_aspect_ratio: {String} 'portrait', 'square', or 'adapt'
  - show_secondary_image: {Boolean}
  - show_vendor: {Boolean}
  - show_swatches: {Boolean}
  - show_quick_buy: {Boolean}
{% endcomment %}

<div class="product-card" data-product-id="{{ product_card_product.id }}">
  <div class="product-card__media-wrap product-card__media-wrap--{{ media_aspect_ratio | default: settings.product_card_image_ratio }}">
    <a href="{{ product_card_product.url }}" class="product-card__link">
      {%- if product_card_product.featured_media -%}
        <img
          src="{{ product_card_product.featured_media | image_url: width: 600 }}"
          alt="{{ product_card_product.featured_media.alt | default: product_card_product.title | escape }}"
          width="300"
          height="400"
          loading="lazy"
          class="product-card__image product-card__image--primary"
        >
        {%- if show_secondary_image and product_card_product.media[1] != blank -%}
          <img
            src="{{ product_card_product.media[1] | image_url: width: 600 }}"
            alt="{{ product_card_product.media[1].alt | default: product_card_product.title | escape }}"
            width="300"
            height="400"
            loading="lazy"
            class="product-card__image product-card__image--secondary"
          >
        {%- endif -%}
      {%- else -%}
        <div class="product-card__placeholder">
          {{ 'product-1' | placeholder_svg_tag: 'placeholder-svg' }}
        </div>
      {%- endif -%}
    </a>

    <div class="product-card__badges">
      {%- if product_card_product.available == false -%}
        <span class="badge badge--soldout">{{ 'products.product.sold_out' | t }}</span>
      {%- elsif product_card_product.compare_at_price > product_card_product.price -%}
        <span class="badge badge--sale">{{ 'products.product.price.sale_price' | t }}</span>
      {%- endif -%}
    </div>
  </div>

  <div class="product-card__info">
    {%- if show_vendor and product_card_product.vendor != blank -%}
      <div class="product-card__vendor">{{ product_card_product.vendor }}</div>
    {%- endif -%}

    <h3 class="product-card__title">
      <a href="{{ product_card_product.url }}">{{ product_card_product.title | escape }}</a>
    </h3>

    <div class="product-card__price">
      {%- if product_card_product.price_varies -%}
        <span>{{ 'products.product.price.from_price_html' | t: price: product_card_product.price_min | money }}</span>
      {%- else -%}
        <span>{{ product_card_product.price | money }}</span>
      {%- endif -%}

      {%- if product_card_product.compare_at_price > product_card_product.price -%}
        <span class="product-card__price--compare">{{ product_card_product.compare_at_price | money }}</span>
      {%- endif -%}
    </div>

    {%- if show_swatches -%}
      {%- for option in product_card_product.options_with_values -%}
        {%- if option.name contains 'Color' or option.name contains 'Colour' -%}
          <div class="product-card__swatches">
            {%- for value in option.values limit: 4 -%}
              <span class="product-card__swatch-circle" style="background-color: {{ value | downcase | remove: ' ' }};" title="{{ value }}"></span>
            {%- endfor -%}
            {%- if option.values.size > 4 -%}
              <span class="product-card__swatches-more">+{{ option.values.size | minus: 4 }}</span>
            {%- endif -%}
          </div>
        {%- endif -%}
      {%- endfor -%}
    {%- endif -%}

    {%- if show_quick_buy and product_card_product.available -%}
      <div class="product-card__quick-add" style="margin-top: 0.75rem;">
        {%- if product_card_product.has_only_default_variant -%}
          <button
            type="button"
            class="button button--secondary button--sm button--full-width"
            onclick="window.cartDrawer && window.cartDrawer.addItem({ id: {{ product_card_product.first_available_variant.id }}, quantity: 1 })"
          >
            {{ 'products.product.add_to_cart' | t }}
          </button>
        {%- else -%}
          <a href="{{ product_card_product.url }}" class="button button--secondary button--sm button--full-width">
            Choose options
          </a>
        {%- endif -%}
      </div>
    {%- endif -%}
  </div>
</div>

<style>
  .product-card__swatches {
    display: flex;
    align-items: center;
    gap: 0.35rem;
    margin-top: 0.5rem;
  }
  .product-card__swatch-circle {
    width: 14px;
    height: 14px;
    border-radius: 50%;
    border: 1px solid var(--color-border);
    display: inline-block;
  }
  .product-card__swatches-more {
    font-size: 0.75rem;
    opacity: 0.6;
    margin-left: 0.2rem;
  }
</style>
