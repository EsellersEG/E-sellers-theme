<div class="search-drawer" id="SearchDrawer" aria-hidden="true" role="dialog" aria-modal="true" aria-label="Search">
  <div class="search-drawer__backdrop" id="SearchBackdrop"></div>
  <div class="search-drawer__container color-scheme-1">
    <div class="page-width search-drawer__inner">
      <div class="search-drawer__header">
        <form action="{{ routes.search_url }}" method="get" role="search" class="search-drawer__form">
          <div class="search-drawer__input-group">
            <svg class="search-drawer__icon" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="11" cy="11" r="8"></circle><line x1="21" y1="21" x2="16.65" y2="16.65"></line></svg>
            <input
              type="search"
              name="q"
              id="SearchInput"
              class="search-drawer__input"
              placeholder="{{ 'search.placeholder' | t }}"
              autocomplete="off"
              autocorrect="off"
              autocapitalize="off"
              spellcheck="false"
            >
            <input type="hidden" name="type" value="product,article,collection,page">
            <button type="button" class="search-drawer__clear is-hidden" id="SearchClear" aria-label="Clear search">
              <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><line x1="18" y1="6" x2="6" y2="18"></line><line x1="6" y1="6" x2="18" y2="18"></line></svg>
            </button>
          </div>
        </form>
        <button type="button" class="search-drawer__close" id="SearchClose" aria-label="{{ 'general.accessibility.close' | t }}">
          <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><line x1="18" y1="6" x2="6" y2="18"></line><line x1="6" y1="6" x2="18" y2="18"></line></svg>
        </button>
      </div>

      <div class="search-drawer__results" id="SearchResults" tabindex="-1">
        <div class="search-drawer__empty-state">
          <p class="text-subheading">Popular Searches</p>
          <div class="search-drawer__tags">
            <button type="button" class="search-tag" data-query="Best Sellers">Best Sellers</button>
            <button type="button" class="search-tag" data-query="New Arrivals">New Arrivals</button>
            <button type="button" class="search-tag" data-query="Hair Care">Hair Care</button>
            <button type="button" class="search-tag" data-query="Bundles">Bundles</button>
          </div>
        </div>
      </div>
    </div>
  </div>
</div>

<style>
  .search-drawer {
    position: fixed;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    z-index: 1000;
    display: none;
  }
  .search-drawer.is-open {
    display: block;
  }
  .search-drawer__backdrop {
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    background-color: rgba(0, 0, 0, 0.5);
    backdrop-filter: blur(4px);
    animation: fadeIn var(--duration-fast) ease-out;
  }
  .search-drawer__container {
    position: relative;
    width: 100%;
    max-height: 80vh;
    overflow-y: auto;
    background-color: var(--color-bg);
    color: var(--color-text);
    box-shadow: var(--shadow-xl);
    animation: slideDown var(--duration-normal) var(--ease-standard);
    border-bottom: 1px solid var(--color-border);
  }
  .search-drawer__inner {
    padding-top: 1.5rem;
    padding-bottom: 2rem;
  }
  .search-drawer__header {
    display: flex;
    align-items: center;
    gap: 1rem;
    border-bottom: 1px solid var(--color-border);
    padding-bottom: 1rem;
  }
  .search-drawer__form {
    flex-grow: 1;
  }
  .search-drawer__input-group {
    display: flex;
    align-items: center;
    gap: 0.75rem;
  }
  .search-drawer__icon {
    color: var(--color-text);
    opacity: 0.5;
    flex-shrink: 0;
  }
  .search-drawer__input {
    width: 100%;
    font-size: 1.25rem;
    font-family: inherit;
    background: transparent;
    border: none;
    outline: none;
    color: var(--color-text);
  }
  .search-drawer__clear,
  .search-drawer__close {
    background: transparent;
    border: none;
    color: var(--color-text);
    cursor: pointer;
    padding: 0.5rem;
    display: flex;
    align-items: center;
    justify-content: center;
    border-radius: 50%;
    transition: background-color var(--duration-fast);
  }
  .search-drawer__clear:hover,
  .search-drawer__close:hover {
    background-color: rgba(0, 0, 0, 0.05);
  }
  .search-drawer__clear.is-hidden {
    display: none;
  }
  .search-drawer__results {
    margin-top: 1.5rem;
  }
  .search-drawer__tags {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
    margin-top: 0.75rem;
  }
  .search-tag {
    background-color: var(--color-border);
    border: 1px solid transparent;
    border-radius: var(--radius-badge);
    padding: 0.4rem 0.85rem;
    font-size: 0.85rem;
    font-weight: 500;
    color: var(--color-text);
    cursor: pointer;
    transition: all var(--duration-fast);
  }
  .search-tag:hover {
    background-color: var(--color-text);
    color: var(--color-bg);
  }
  .search-results-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(200px, 1fr));
    gap: 1.25rem;
    margin-top: 1rem;
  }
  .search-result-item {
    display: flex;
    gap: 0.75rem;
    text-decoration: none;
    color: inherit;
    padding: 0.5rem;
    border-radius: var(--radius-card);
    transition: background-color var(--duration-fast);
  }
  .search-result-item:hover {
    background-color: rgba(0, 0, 0, 0.03);
  }
  .search-result-item__image {
    width: 60px;
    height: 60px;
    object-fit: cover;
    border-radius: var(--radius-input);
    flex-shrink: 0;
  }
  .search-result-item__title {
    font-size: 0.9rem;
    font-weight: 600;
    margin-bottom: 0.25rem;
  }
  .search-result-item__price {
    font-size: 0.85rem;
    font-weight: 500;
  }
  @keyframes slideDown {
    from { transform: translateY(-20px); opacity: 0; }
    to { transform: translateY(0); opacity: 1; }
  }
</style>
