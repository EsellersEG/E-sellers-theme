{% comment %}
  Renders product media (image, video, external_video, model)
  Accepts:
  - media: {Object} Product media Liquid object
  - loop: {Boolean} Enable video looping
  - modal_id: {String} ID for modal zoom
{% endcomment %}

<div class="product-media" data-media-id="{{ media.id }}">
  {%- case media.media_type -%}
    {%- when 'image' -%}
      <img
        src="{{ media | image_url: width: 1200 }}"
        alt="{{ media.alt | default: product.title | escape }}"
        width="{{ media.width }}"
        height="{{ media.height }}"
        loading="lazy"
        class="product-media__image"
      >
    {%- when 'external_video' -%}
      <div class="product-media__video-wrapper">
        {{ media | external_video_tag: class: 'product-media__external-video', loading: 'lazy' }}
      </div>
    {%- when 'video' -%}
      <div class="product-media__video-wrapper">
        {{ media | video_tag: controls: true, loop: loop, image_size: '1024x', class: 'product-media__native-video' }}
      </div>
    {%- when 'model' -%}
      <div class="product-media__model-wrapper">
        {{ media | model_viewer_tag: image_size: '1024x', reveal: 'interaction', toggleable: true, class: 'product-media__3d-model' }}
      </div>
  {%- endcase -%}
</div>

<style>
  .product-media {
    position: relative;
    width: 100%;
    overflow: hidden;
    border-radius: var(--radius-card);
    background-color: rgba(0, 0, 0, 0.02);
  }
  .product-media__image {
    width: 100%;
    height: auto;
    object-fit: cover;
    display: block;
  }
  .product-media__video-wrapper,
  .product-media__model-wrapper {
    position: relative;
    width: 100%;
    padding-top: 100%; /* 1:1 Aspect ratio default */
  }
  .product-media__video-wrapper iframe,
  .product-media__video-wrapper video,
  .product-media__model-wrapper model-viewer {
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    border: none;
  }
</style>
