  {
    "name": "Typography",
    "settings": [
      {
        "type": "header",
        "content": "Headings"
      },
      {
        "type": "font_picker",
        "id": "heading_font",
        "default": "work_sans_n6",
        "label": "Font"
      },
      {
        "type": "range",
        "id": "heading_scale",
        "min": 80,
        "max": 150,
        "step": 5,
        "unit": "%",
        "label": "Scale",
        "default": 100
      },
      {
        "type": "header",
        "content": "Body text"
      },
      {
        "type": "font_picker",
        "id": "body_font",
        "default": "work_sans_n4",
        "label": "Font"
      },
      {
        "type": "range",
        "id": "body_scale",
        "min": 80,
        "max": 130,
        "step": 5,
        "unit": "%",
        "label": "Scale",
        "default": 100
      }
    ]
  },
  {
    "name": "Layout",
    "settings": [
      {
        "type": "range",
        "id": "page_width",
        "min": 1000,
        "max": 1600,
        "step": 20,
        "unit": "px",
        "label": "Maximum page width",
        "default": 1320
      },
      {
        "type": "range",
        "id": "page_gutter",
        "min": 12,
        "max": 48,
        "step": 4,
        "unit": "px",
        "label": "Horizontal page margin",
        "default": 24
      },
      {
        "type": "range",
        "id": "section_spacing_desktop",
        "min": 24,
        "max": 120,
        "step": 8,
        "unit": "px",
        "label": "Section vertical spacing (desktop)",
        "default": 64
      },
      {
        "type": "range",
        "id": "section_spacing_mobile",
        "min": 16,
        "max": 80,
        "step": 8,
        "unit": "px",
        "label": "Section vertical spacing (mobile)",
        "default": 40
      }
    ]
  },
  {
    "name": "Buttons & inputs",
    "settings": [
      {
        "type": "range",
        "id": "button_radius",
        "min": 0,
        "max": 40,
        "step": 2,
        "unit": "px",
        "label": "Button corner radius",
        "default": 8
      },
      {
        "type": "checkbox",
        "id": "button_uppercase",
        "default": false,
        "label": "Uppercase button labels"
      },
      {
        "type": "range",
        "id": "input_radius",
        "min": 0,
        "max": 20,
        "step": 2,
        "unit": "px",
        "label": "Input field corner radius",
        "default": 8
      },
      {
        "type": "range",
        "id": "card_radius",
        "min": 0,
        "max": 32,
        "step": 2,
        "unit": "px",
        "label": "Card corner radius",
        "default": 12
      }
    ]
  },
  {
    "name": "Cart",
    "settings": [
      {
        "type": "select",
        "id": "cart_type",
        "label": "Cart type",
        "options": [
          {
            "value": "drawer",
            "label": "Drawer"
          },
          {
            "value": "page",
            "label": "Page"
          }
        ],
        "default": "drawer"
      },
      {
        "type": "checkbox",
        "id": "show_cart_note",
        "default": true,
        "label": "Enable cart note"
      },
      {
        "type": "checkbox",
        "id": "show_free_shipping_bar",
        "default": true,
        "label": "Enable free shipping goal"
      },
      {
        "type": "number",
        "id": "free_shipping_threshold",
        "default": 100,
        "label": "Free shipping minimum amount"
      }
    ]
  },
  {
    "name": "Product cards",
    "settings": [
      {
        "type": "select",
        "id": "product_card_image_ratio",
        "label": "Image aspect ratio",
        "options": [
          {
            "value": "square",
            "label": "Square (1:1)"
          },
          {
            "value": "portrait",
            "label": "Portrait (3:4)"
          },
          {
            "value": "adapt",
            "label": "Adapt to image"
          }
        ],
        "default": "portrait"
      },
      {
        "type": "checkbox",
        "id": "show_secondary_image_on_hover",
        "default": true,
        "label": "Show second image on hover"
      },
      {
        "type": "checkbox",
        "id": "show_vendor",
        "default": false,
        "label": "Show vendor"
      },
      {
        "type": "checkbox",
        "id": "show_swatches",
        "default": true,
        "label": "Show color swatches"
      },
      {
        "type": "checkbox",
        "id": "show_quick_buy",
        "default": true,
        "label": "Show quick add button"
      }
    ]
  },
